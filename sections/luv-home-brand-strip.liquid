{%- liquid
  assign ready_brand_count = 0
  assign brand_strip_heading = section.settings.heading | strip
  assign brand_strip_support = section.settings.support_text | strip
  assign brand_strip_cta_label = section.settings.cta_label | strip

  if brand_strip_heading == blank
    assign brand_strip_heading = 'luv_home.brand_strip.heading' | t
  endif

  if brand_strip_support == blank
    assign brand_strip_support = 'luv_home.brand_strip.support' | t
  endif

  if brand_strip_cta_label == blank
    assign brand_strip_cta_label = 'luv_home.brand_strip.cta' | t
  endif

  for block in section.blocks
    assign brand_name = block.settings.brand_name | strip
    assign brand_alt = block.settings.alt_text | strip

    if block.settings.logo != blank
      if brand_name != blank or brand_alt != blank
        assign ready_brand_count = ready_brand_count | plus: 1
      endif
    endif
  endfor
-%}

{%- if ready_brand_count > 0 or request.design_mode -%}
  <section
    id="luv-home-brand-strip"
    class="luv-design-scope luv-home-brand-strip"
    aria-labelledby="LuvHomeBrandStripHeading-{{ section.id }}"
    style="
      --luv-home-brand-strip-padding-desktop: {{ section.settings.padding_desktop }}px;
      --luv-home-brand-strip-padding-mobile: {{ section.settings.padding_mobile }}px;
    "
  >
    <div class="luv-container">
      {%- if section.settings.show_heading -%}
        <header class="luv-home-brand-strip__header">
          <h2 id="LuvHomeBrandStripHeading-{{ section.id }}" class="luv-home-brand-strip__heading">
            {{- brand_strip_heading | escape -}}
          </h2>
          {%- if brand_strip_support != blank -%}
            <p class="luv-home-brand-strip__support">{{ brand_strip_support | escape }}</p>
          {%- endif -%}
        </header>
      {%- else -%}
        <h2 id="LuvHomeBrandStripHeading-{{ section.id }}" class="visually-hidden">
          {{- 'luv_home.brand_strip.accessible_label' | t | escape -}}
        </h2>
      {%- endif -%}

      <ul class="luv-home-brand-strip__list luv-home-brand-strip__list--count-{{ ready_brand_count }}" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign brand_logo = block.settings.logo
            assign brand_name = block.settings.brand_name | strip
            assign brand_alt = block.settings.alt_text | strip
            assign brand_accessible_name = brand_name | default: brand_alt
            assign brand_logo_alt = brand_alt | default: brand_name
            assign brand_logo_scale = block.settings.logo_scale | default: 100
            assign brand_is_ready = false

            if brand_logo != blank and brand_accessible_name != blank
              assign brand_is_ready = true
            endif
          -%}

          {%- if brand_is_ready -%}
            <li
              class="luv-home-brand-strip__item"
              style="--luv-home-brand-logo-scale: {{ brand_logo_scale }}%;"
              {{ block.shopify_attributes }}
            >
              {%- capture brand_logo_markup -%}
                <span class="luv-home-brand-strip__logo-stage">
                  {{
                    brand_logo
                    | image_url: width: 400
                    | image_tag:
                      class: 'luv-home-brand-strip__logo',
                      widths: '120, 180, 240, 320, 400',
                      sizes: '(min-width: 1440px) 140px, (min-width: 990px) 18vw, (min-width: 750px) 22vw, 38vw',
                      loading: 'lazy',
                      alt: brand_logo_alt
                  }}
                </span>
              {%- endcapture -%}

              {%- if block.settings.link != blank -%}
                <a
                  class="luv-home-brand-strip__item-content luv-home-brand-strip__link"
                  href="{{ block.settings.link }}"
                  aria-label="{{ brand_accessible_name | escape }}"
                >
                  {{- brand_logo_markup -}}
                </a>
              {%- else -%}
                <div class="luv-home-brand-strip__item-content">
                  {{- brand_logo_markup -}}
                </div>
              {%- endif -%}
            </li>
          {%- elsif request.design_mode -%}
            <li
              class="luv-home-brand-strip__item luv-home-brand-strip__item--editor"
              style="--luv-home-brand-logo-scale: {{ brand_logo_scale }}%;"
              {{ block.shopify_attributes }}
            >
              <div class="luv-home-brand-strip__editor-media">
                {%- if brand_logo != blank -%}
                  <span class="luv-home-brand-strip__logo-stage">
                    {{
                      brand_logo
                      | image_url: width: 320
                      | image_tag:
                        class: 'luv-home-brand-strip__logo',
                        widths: '120, 180, 240, 320',
                        sizes: '160px',
                        loading: 'lazy',
                        alt: ''
                    }}
                  </span>
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <ul class="luv-home-brand-strip__editor-messages">
                {%- if brand_logo == blank -%}
                  <li>{{ 'luv_home.brand_strip.editor.missing_logo' | t }}</li>
                {%- endif -%}
                {%- if brand_accessible_name == blank -%}
                  <li>{{ 'luv_home.brand_strip.editor.missing_brand_name' | t }}</li>
                {%- endif -%}
              </ul>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.cta_url != blank -%}
        <div class="luv-home-brand-strip__cta-wrap">
          <a class="luv-home-brand-strip__cta" href="{{ section.settings.cta_url }}">
            {{- brand_strip_cta_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Luv home brand strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "textarea",
      "id": "support_text",
      "label": "Supporting text override"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show visible heading",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop vertical padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile vertical padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "range",
          "id": "logo_scale",
          "min": 70,
          "max": 170,
          "step": 5,
          "unit": "%",
          "label": "t:settings_schema.typography.settings.heading_scale.label",
          "default": 100
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand destination URL"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt-text override"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Luv home brand strip"
    }
  ]
}
{% endschema %}
