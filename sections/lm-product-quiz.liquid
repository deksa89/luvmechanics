{%- liquid
  assign product_finder_eyebrow = section.settings.title
  if product_finder_eyebrow == blank
    assign product_finder_eyebrow = 'luv_home.product_finder.eyebrow' | t
  endif
  assign product_finder_heading = section.settings.heading
  if product_finder_heading == blank
    assign product_finder_heading = 'luv_home.product_finder.heading' | t
  endif
  assign product_finder_intro = section.settings.intro_text
  if product_finder_intro == blank
    assign product_finder_intro = 'luv_home.product_finder.intro' | t
  endif
  assign start_button_label = section.settings.start_button_label
  if start_button_label == blank
    assign start_button_label = 'luv_home.product_finder.start' | t
  endif
  assign submit_button_label = section.settings.submit_button_label
  if submit_button_label == blank
    assign submit_button_label = 'luv_home.product_finder.view_recommendations' | t
  endif
  assign result_label = section.settings.result_label
  if result_label == blank
    assign result_label = 'luv_home.product_finder.your_recommendations' | t
  endif
  assign restart_button_label = section.settings.restart_button_label
  if restart_button_label == blank
    assign restart_button_label = 'luv_home.product_finder.retake' | t
  endif
  assign no_matching_result_title = section.settings.no_matching_result_title
  if no_matching_result_title == blank
    assign no_matching_result_title = 'luv_home.product_finder.messages.no_match_title' | t
  endif
  assign no_matching_result_description = section.settings.no_matching_result_description
  if no_matching_result_description == blank
    assign no_matching_result_description = 'luv_home.product_finder.messages.no_match_description' | t
  endif
  assign empty_products_line_1 = section.settings.empty_products_line_1
  if empty_products_line_1 == blank
    assign empty_products_line_1 = 'luv_home.product_finder.messages.empty_products_1' | t
  endif
  assign empty_products_line_2 = section.settings.empty_products_line_2
  if empty_products_line_2 == blank
    assign empty_products_line_2 = 'luv_home.product_finder.messages.empty_products_2' | t
  endif
  assign fallback_result_title = section.settings.fallback_result_title
  if fallback_result_title == blank
    assign fallback_result_title = 'luv_home.product_finder.messages.fallback_title' | t
  endif

  assign q1_title = section.settings.q1_title
  if q1_title == blank
    assign q1_title = 'luv_home.product_finder.questions.shopping_for.heading' | t
  endif
  assign q1_myself_label = section.settings.q1_myself_label
  if q1_myself_label == blank
    assign q1_myself_label = 'luv_home.product_finder.questions.shopping_for.myself' | t
  endif
  assign q1_partner_label = section.settings.q1_partner_label
  if q1_partner_label == blank
    assign q1_partner_label = 'luv_home.product_finder.questions.shopping_for.partner' | t
  endif
  assign q1_couple_label = section.settings.q1_couple_label
  if q1_couple_label == blank
    assign q1_couple_label = 'luv_home.product_finder.questions.shopping_for.couple' | t
  endif
  assign q1_gift_label = section.settings.q1_gift_label
  if q1_gift_label == blank
    assign q1_gift_label = 'luv_home.product_finder.questions.shopping_for.gift' | t
  endif

  assign q2_title = section.settings.q2_title
  if q2_title == blank
    assign q2_title = 'luv_home.product_finder.questions.experience.heading' | t
  endif
  assign q2_beginner_label = section.settings.q2_beginner_label
  if q2_beginner_label == blank
    assign q2_beginner_label = 'luv_home.product_finder.questions.experience.beginner' | t
  endif
  assign q2_some_label = section.settings.q2_some_label
  if q2_some_label == blank
    assign q2_some_label = 'luv_home.product_finder.questions.experience.some' | t
  endif
  assign q2_advanced_label = section.settings.q2_advanced_label
  if q2_advanced_label == blank
    assign q2_advanced_label = 'luv_home.product_finder.questions.experience.advanced' | t
  endif

  assign q3_title = section.settings.q3_title
  if q3_title == blank
    assign q3_title = 'luv_home.product_finder.questions.priority.heading' | t
  endif
  assign q3_ease_label = section.settings.q3_ease_label
  if q3_ease_label == blank
    assign q3_ease_label = 'luv_home.product_finder.questions.priority.ease' | t
  endif
  assign q3_stronger_label = section.settings.q3_stronger_label
  if q3_stronger_label == blank
    assign q3_stronger_label = 'luv_home.product_finder.questions.priority.stronger' | t
  endif
  assign q3_premium_label = section.settings.q3_premium_label
  if q3_premium_label == blank
    assign q3_premium_label = 'luv_home.product_finder.questions.priority.premium' | t
  endif
  assign q3_exploring_label = section.settings.q3_exploring_label
  if q3_exploring_label == blank
    assign q3_exploring_label = 'luv_home.product_finder.questions.priority.exploring' | t
  endif

  assign q4_title = section.settings.q4_title
  if q4_title == blank
    assign q4_title = 'luv_home.product_finder.questions.category.heading' | t
  endif
  assign q4_vibrators_label = section.settings.q4_vibrators_label
  if q4_vibrators_label == blank
    assign q4_vibrators_label = 'luv_home.product_finder.questions.category.vibrators' | t
  endif
  assign q4_masturbators_label = section.settings.q4_masturbators_label
  if q4_masturbators_label == blank
    assign q4_masturbators_label = 'luv_home.product_finder.questions.category.masturbators' | t
  endif
  assign q4_rabbit_vibrators_label = section.settings.q4_rabbit_vibrators_label
  if q4_rabbit_vibrators_label == blank
    assign q4_rabbit_vibrators_label = 'luv_home.product_finder.questions.category.rabbit_vibrators' | t
  endif
  assign q4_penis_pumps_label = section.settings.q4_penis_pumps_label
  if q4_penis_pumps_label == blank
    assign q4_penis_pumps_label = 'luv_home.product_finder.questions.category.penis_pumps' | t
  endif
  assign q4_remote_control_label = section.settings.q4_remote_control_label
  if q4_remote_control_label == blank
    assign q4_remote_control_label = 'luv_home.product_finder.questions.category.remote_control' | t
  endif
  assign q4_clitoris_stimulators_label = section.settings.q4_clitoris_stimulators_label
  if q4_clitoris_stimulators_label == blank
    assign q4_clitoris_stimulators_label = 'luv_home.product_finder.questions.category.clitoris_stimulators' | t
  endif
  assign q4_extras_label = section.settings.q4_extras_label
  if q4_extras_label == blank
    assign q4_extras_label = 'luv_home.product_finder.questions.category.extras' | t
  endif

  assign q5_title = section.settings.q5_title
  if q5_title == blank
    assign q5_title = 'luv_home.product_finder.questions.price.heading' | t
  endif
  assign q5_price_1_label = section.settings.q5_price_1_label
  if q5_price_1_label == blank
    assign q5_price_1_label = 'luv_home.product_finder.questions.price.up_to_70' | t
  endif
  assign q5_price_2_label = section.settings.q5_price_2_label
  if q5_price_2_label == blank
    assign q5_price_2_label = 'luv_home.product_finder.questions.price.from_70_to_150' | t
  endif
  assign q5_price_3_label = section.settings.q5_price_3_label
  if q5_price_3_label == blank
    assign q5_price_3_label = 'luv_home.product_finder.questions.price.over_150' | t
  endif
  assign product_finder_image = section.settings.desktop_image
  assign product_finder_mobile_image = section.settings.mobile_image
  assign product_finder_image_alt = section.settings.image_alt
  if product_finder_image_alt == blank and product_finder_image != blank
    assign product_finder_image_alt = product_finder_image.alt
  endif
  if product_finder_image_alt == blank
    assign product_finder_image_alt = 'luv_home.accessibility.product_finder_image_alt' | t
  endif
-%}

<section
  id="luv-home-product-finder"
  class="luv-design-scope luv-home-section luv-home-product-finder"
  aria-labelledby="LuvHomeProductFinderHeading-{{ section.id }}"
>
  <div
    id="lm-product-quiz-{{ section.id }}"
    class="lm-product-quiz-section color-{{ section.settings.color_scheme }}"
    style="--luv-home-product-finder-padding-top: {{ section.settings.padding_top }}px; --luv-home-product-finder-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width luv-container">
      <div class="lm-product-quiz{% if product_finder_image == blank %} lm-product-quiz--no-media{% endif %}">
        {%- if product_finder_image != blank -%}
          <div class="lm-product-quiz__media">
            <picture>
              {%- if product_finder_mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ product_finder_mobile_image | image_url: width: 750 }}">
              {%- endif -%}
              {{
                product_finder_image
                | image_url: width: 1600
                | image_tag:
                  widths: '550, 750, 990, 1200, 1440, 1600',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: 'lazy',
                  class: 'lm-product-quiz__media-image',
                  alt: product_finder_image_alt
              }}
            </picture>
          </div>
        {%- endif -%}

        <div class="lm-product-quiz__content">
          <header class="lm-product-quiz__header">
            <p class="lm-product-quiz__eyebrow">{{ product_finder_eyebrow | escape }}</p>
            <h2 id="LuvHomeProductFinderHeading-{{ section.id }}" class="lm-product-quiz__heading">
              {{- product_finder_heading | escape -}}
            </h2>
          </header>

          <div class="lm-product-quiz__intro" data-quiz-intro>
            <p class="lm-product-quiz__intro-text">{{ product_finder_intro | escape }}</p>
            <button type="button" class="button button--luv-primary lm-product-quiz__start-button" data-quiz-start>
              {{ start_button_label | escape }}
            </button>

            <div class="lm-product-quiz__preview" aria-hidden="true">
              <p class="lm-product-quiz__preview-question">
                {%- if section.settings.q1_title == blank -%}
                  {{- 'luv_home.product_finder.questions.shopping_for.heading' | t -}}
                {%- else -%}
                  {{- section.settings.q1_title | escape -}}
                {%- endif -%}
              </p>
              <div class="lm-product-quiz__preview-options">
                <span class="lm-product-quiz__preview-option">{% if section.settings.q1_myself_label == blank %}{{ 'luv_home.product_finder.questions.shopping_for.myself' | t }}{% else %}{{ section.settings.q1_myself_label | escape }}{% endif %}</span>
                <span class="lm-product-quiz__preview-option">{% if section.settings.q1_partner_label == blank %}{{ 'luv_home.product_finder.questions.shopping_for.partner' | t }}{% else %}{{ section.settings.q1_partner_label | escape }}{% endif %}</span>
                <span class="lm-product-quiz__preview-option">{% if section.settings.q1_couple_label == blank %}{{ 'luv_home.product_finder.questions.shopping_for.couple' | t }}{% else %}{{ section.settings.q1_couple_label | escape }}{% endif %}</span>
                <span class="lm-product-quiz__preview-option">{% if section.settings.q1_gift_label == blank %}{{ 'luv_home.product_finder.questions.shopping_for.gift' | t }}{% else %}{{ section.settings.q1_gift_label | escape }}{% endif %}</span>
              </div>
            </div>
          </div>

      <div class="lm-product-quiz__body hidden" data-quiz-body>
        <form class="lm-product-quiz__form" data-quiz-form>
          <div
            class="lm-product-quiz__progress"
            data-quiz-progress
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            <span class="lm-product-quiz__progress-copy">
              {{- 'luv_home.product_finder.question' | t }}
              <span data-current-step>1</span>
              {{ 'luv_home.product_finder.of' | t }}
              <span data-total-steps>5</span>
            </span>
            <span class="lm-product-quiz__progress-track" aria-hidden="true">
              <span class="lm-product-quiz__progress-bar" data-progress-bar></span>
            </span>
          </div>

          <div class="lm-product-quiz__question" data-quiz-step="1">
            <h3 tabindex="-1">{{ q1_title | escape }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="shopping_for" value="myself" data-points="{{ section.settings.q1_myself_points }}" required>
                <span>{{ q1_myself_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="shopping_for" value="partner" data-points="{{ section.settings.q1_partner_points }}">
                <span>{{ q1_partner_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="shopping_for" value="couple" data-points="{{ section.settings.q1_couple_points }}">
                <span>{{ q1_couple_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="shopping_for" value="gift" data-points="{{ section.settings.q1_gift_points }}">
                <span>{{ q1_gift_label | escape }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__question hidden" data-quiz-step="2">
            <h3 tabindex="-1">{{ q2_title | escape }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="experience" value="beginner" data-points="{{ section.settings.q2_beginner_points }}" required>
                <span>{{ q2_beginner_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="experience" value="some_experience" data-points="{{ section.settings.q2_some_points }}">
                <span>{{ q2_some_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="experience" value="advanced" data-points="{{ section.settings.q2_advanced_points }}">
                <span>{{ q2_advanced_label | escape }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__question hidden" data-quiz-step="3">
            <h3 tabindex="-1">{{ q3_title | escape }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="priority" value="ease_of_use" data-points="{{ section.settings.q3_ease_points }}" required>
                <span>{{ q3_ease_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="priority" value="stronger_sensations" data-points="{{ section.settings.q3_stronger_points }}">
                <span>{{ q3_stronger_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="priority" value="premium_quality" data-points="{{ section.settings.q3_premium_points }}">
                <span>{{ q3_premium_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="priority" value="exploring_new" data-points="{{ section.settings.q3_exploring_points }}">
                <span>{{ q3_exploring_label | escape }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__question hidden" data-quiz-step="4">
            <h3 tabindex="-1">{{ q4_title | escape }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="vibrators" required>
                <span>{{ q4_vibrators_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="masturbators">
                <span>{{ q4_masturbators_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="rabbit_vibrators">
                <span>{{ q4_rabbit_vibrators_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="penis_pumps">
                <span>{{ q4_penis_pumps_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="remote_control_toys">
                <span>{{ q4_remote_control_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="clitoris_stimulators">
                <span>{{ q4_clitoris_stimulators_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="extras">
                <span>{{ q4_extras_label | escape }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__question hidden" data-quiz-step="5">
            <h3 tabindex="-1">{{ q5_title | escape }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="price_range" value="up_to_70" required>
                <span>{{ q5_price_1_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="price_range" value="70_to_150">
                <span>{{ q5_price_2_label | escape }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="price_range" value="150_plus">
                <span>{{ q5_price_3_label | escape }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__actions hidden" data-quiz-actions>
            <button type="submit" class="button button--primary">
              {{ submit_button_label | escape }}
            </button>
          </div>
        </form>

        <div class="lm-product-quiz__result hidden" data-quiz-result>
          <p class="lm-product-quiz__result-label">{{ result_label | escape }}</p>
          <h3 data-result-title tabindex="-1"></h3>
          <p data-result-description></p>
          <p class="lm-product-quiz__score" data-result-score></p>

          <div class="lm-product-quiz__products" data-result-products></div>

          <div class="lm-product-quiz__result-actions">
            <button type="button" class="lm-product-quiz__restart-button" data-quiz-restart>
              {{ restart_button_label | escape }}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>

  <script type="application/json" data-quiz-results>
    [
      {% for block in section.blocks %}
        {
          "id": {{ block.id | json }},
          "min": {{ block.settings.min_score | json }},
          "max": {{ block.settings.max_score | json }},
          "category": {{ block.settings.category | json }},
          "title": {{ block.settings.result_title | json }},
          "description": {{ block.settings.result_description | json }},
          "products": [
            {% assign first_product_added = false %}

            {% for i in (1..10) %}
              {% assign product_setting = 'product_' | append: i %}
              {% assign selected_product = block.settings[product_setting] %}

              {% if selected_product != blank %}
                {% if first_product_added %},{% endif %}
                {% assign first_product_added = true %}
                {
                  "title": {{ selected_product.title | json }},
                  "url": {{ selected_product.url | json }},
                  "price": {{ selected_product.price | money | json }},
                  "priceCents": {{ selected_product.price | json }},
                  "image": {% if selected_product.featured_image %}{{ selected_product.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %}
                }
              {% endif %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>


  <script>
    (() => {
      const root = document.getElementById('lm-product-quiz-{{ section.id }}');

      if (!root) return;

      const intro = root.querySelector('[data-quiz-intro]');
      const body = root.querySelector('[data-quiz-body]');
      const form = root.querySelector('[data-quiz-form]');
      const resultBox = root.querySelector('[data-quiz-result]');
      const resultTitle = root.querySelector('[data-result-title]');
      const resultDescription = root.querySelector('[data-result-description]');
      const resultScore = root.querySelector('[data-result-score]');
      const resultProducts = root.querySelector('[data-result-products]');
      const startButton = root.querySelector('[data-quiz-start]');
      const restartButton = root.querySelector('[data-quiz-restart]');
      const resultsDataEl = root.querySelector('[data-quiz-results]');
      const steps = Array.from(root.querySelectorAll('[data-quiz-step]'));
      const actions = root.querySelector('[data-quiz-actions]');
      const currentStepText = root.querySelector('[data-current-step]');
      const totalStepsText = root.querySelector('[data-total-steps]');
      const progressBar = root.querySelector('[data-progress-bar]');

      let resultGroups = [];
      let currentStep = 1;

      const quizTexts = {
        noMatchingTitle: {{ no_matching_result_title | json }},
        noMatchingDescription: {{ no_matching_result_description | json }},
        emptyProductsLine1: {{ empty_products_line_1 | json }},
        emptyProductsLine2: {{ empty_products_line_2 | json }},
        fallbackResultTitle: {{ fallback_result_title | json }}
      };

      if (totalStepsText) {
        totalStepsText.textContent = steps.length;
      }

      try {
        resultGroups = JSON.parse(resultsDataEl.textContent);
      } catch (error) {
        console.error('Quiz results JSON parsing failed', error);
      }

      function getHeaderOffset() {
        const stickyHeader =
          document.querySelector('.shopify-section-header-sticky') ||
          document.querySelector('sticky-header') ||
          document.querySelector('.header-wrapper') ||
          document.querySelector('header');

        if (!stickyHeader) {
          return 90;
        }

        return stickyHeader.offsetHeight + 24;
      }

      function scrollToQuestion(questionElement) {
        if (!questionElement) return;

        const headerOffset = getHeaderOffset();
        const questionTop = questionElement.getBoundingClientRect().top + window.pageYOffset;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        window.scrollTo({
          top: questionTop - headerOffset,
          behavior: reduceMotion ? 'auto' : 'smooth'
        });
      }

      function focusState(target) {
        if (!target) return;

        window.requestAnimationFrame(() => target.focus({ preventScroll: true }));
      }

      function showStep(stepNumber, shouldFocus = false) {
        currentStep = stepNumber;
        let activeStep = null;

        steps.forEach((step) => {
          const isActive = Number(step.dataset.quizStep) === stepNumber;
          step.classList.toggle('hidden', !isActive);

          if (isActive) {
            activeStep = step;
          }
        });

        if (currentStepText) {
          currentStepText.textContent = stepNumber;
        }

        if (progressBar) {
          progressBar.style.width = `${(stepNumber / steps.length) * 100}%`;
        }

        if (actions) {
          const isLastStep = stepNumber === steps.length;
          actions.classList.toggle('hidden', !isLastStep);
        }

        if (shouldFocus && activeStep) {
          scrollToQuestion(activeStep);
          focusState(activeStep.querySelector('h3'));
        }
      }

      function goToNextStep() {
        if (currentStep < steps.length) {
          showStep(currentStep + 1, true);
        }
      }

      function calculateScore() {
        const selectedInputs = form.querySelectorAll('input[data-points]:checked');
        let total = 0;

        selectedInputs.forEach((input) => {
          total += Number(input.dataset.points || 0);
        });

        return total;
      }

      function getSelectedValue(name) {
        const selected = form.querySelector(`input[name="${name}"]:checked`);
        return selected ? selected.value : '';
      }

      function findMatchingGroup(score, category) {
        return resultGroups.find((group) => {
          return (
            score >= Number(group.min) &&
            score <= Number(group.max) &&
            group.category === category
          );
        });
      }

      function filterProductsByPrice(products, priceRange) {
        return products.filter((product) => {
          const price = Number(product.priceCents || 0);

          if (priceRange === 'up_to_70') {
            return price <= 7000;
          }

          if (priceRange === '70_to_150') {
            return price > 7000 && price <= 15000;
          }

          if (priceRange === '150_plus') {
            return price > 15000;
          }

          return true;
        });
      }

      function renderProducts(products) {
        resultProducts.innerHTML = '';

        if (!products || !products.length) {
          const emptyMessage = document.createElement('div');
          emptyMessage.className = 'lm-product-quiz__empty-message';

          const firstLine = document.createElement('p');
          firstLine.textContent = quizTexts.emptyProductsLine1;

          const secondLine = document.createElement('p');
          secondLine.textContent = quizTexts.emptyProductsLine2;

          emptyMessage.appendChild(firstLine);
          emptyMessage.appendChild(secondLine);
          resultProducts.appendChild(emptyMessage);

          return;
        }

        products.forEach((product) => {
          const card = document.createElement('article');
          card.className = 'lm-product-quiz__product';

          const link = document.createElement('a');
          link.className = 'lm-product-quiz__product-link';
          link.href = product.url;

          const imageWrapper = document.createElement('div');
          imageWrapper.className = 'lm-product-quiz__product-image';

          if (product.image) {
            const image = document.createElement('img');
            image.src = product.image;
            image.alt = product.title;
            image.loading = 'lazy';
            imageWrapper.appendChild(image);
          }

          const title = document.createElement('h4');
          title.className = 'lm-product-quiz__product-title';
          title.textContent = product.title;

          const price = document.createElement('p');
          price.className = 'lm-product-quiz__product-price';
          price.textContent = product.price;

          link.appendChild(imageWrapper);
          link.appendChild(title);
          link.appendChild(price);

          card.appendChild(link);
          resultProducts.appendChild(card);
        });
      }

      function showResults(event) {
        event.preventDefault();

        if (!form.reportValidity()) return;

        const score = calculateScore();
        const selectedCategory = getSelectedValue('category_interest');
        const selectedPriceRange = getSelectedValue('price_range');

        const matchedGroup = findMatchingGroup(score, selectedCategory);

        if (!matchedGroup) {
          resultTitle.textContent = quizTexts.noMatchingTitle;
          resultDescription.textContent = quizTexts.noMatchingDescription;

          if (resultScore) {
            resultScore.textContent = '';
          }

          resultProducts.innerHTML = '';
          form.classList.add('hidden');
          resultBox.classList.remove('hidden');
          scrollToQuestion(resultBox);
          focusState(resultTitle);

          return;
        }

        const filteredProducts = filterProductsByPrice(matchedGroup.products, selectedPriceRange);

        resultTitle.textContent = matchedGroup.title || quizTexts.fallbackResultTitle;
        resultDescription.textContent = matchedGroup.description || '';

        if (resultScore) {
          resultScore.textContent = '';
        }

        renderProducts(filteredProducts);

        form.classList.add('hidden');
        resultBox.classList.remove('hidden');
        scrollToQuestion(resultBox);
        focusState(resultTitle);
      }

      function restartQuiz() {
        root.classList.remove('is-active');
        form.reset();
        resultProducts.innerHTML = '';
        resultBox.classList.add('hidden');
        form.classList.remove('hidden');

        showStep(1, false);

        if (intro) {
          intro.classList.remove('hidden');
        }

        body.classList.add('hidden');

        if (intro) {
          scrollToQuestion(intro);

          if (startButton) {
            focusState(startButton);
          }
        }
      }

      function handleAnswerChange(event) {
        const input = event.target;

        if (!input.matches('input[type="radio"]')) return;

        setTimeout(() => {
          if (currentStep < steps.length) {
            goToNextStep();
          }
        }, 250);
      }

      if (startButton) {
        startButton.addEventListener('click', () => {
          root.classList.add('is-active');
          if (intro) {
            intro.classList.add('hidden');
          }

          body.classList.remove('hidden');
          form.classList.remove('hidden');
          resultBox.classList.add('hidden');
          showStep(1, true);
        });
      } else {
        root.classList.add('is-active');
        body.classList.remove('hidden');
        showStep(1, true);
      }

      if (form) {
        form.addEventListener('change', handleAnswerChange);
        form.addEventListener('submit', showResults);
      }

      if (restartButton) {
        restartButton.addEventListener('click', restartQuiz);
      }
    })();
  </script>
  </div>
</section>

