<section id="lm-product-quiz-{{ section.id }}" class="lm-product-quiz-section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="lm-product-quiz">
      {% if section.settings.title != blank %}
        <p class="lm-product-quiz__eyebrow">{{ section.settings.title }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="lm-product-quiz__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.intro_text != blank %}
        <div class="lm-product-quiz__intro" data-quiz-intro>
          <p>{{ section.settings.intro_text }}</p>
          <button type="button" class="button" data-quiz-start>
            {{ section.settings.start_button_label }}
          </button>
        </div>
      {% endif %}

      <div class="lm-product-quiz__body hidden" data-quiz-body>
        <form class="lm-product-quiz__form" data-quiz-form>
          <div class="lm-product-quiz__progress" data-quiz-progress>
            <span data-current-step>1</span> / <span data-total-steps>5</span>
          </div>

          <div class="lm-product-quiz__question" data-quiz-step="1">
            <h3>{{ section.settings.q1_title }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="shopping_for" value="myself" data-points="{{ section.settings.q1_myself_points }}" required>
                <span>{{ section.settings.q1_myself_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="shopping_for" value="partner" data-points="{{ section.settings.q1_partner_points }}">
                <span>{{ section.settings.q1_partner_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="shopping_for" value="couple" data-points="{{ section.settings.q1_couple_points }}">
                <span>{{ section.settings.q1_couple_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="shopping_for" value="gift" data-points="{{ section.settings.q1_gift_points }}">
                <span>{{ section.settings.q1_gift_label }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__question hidden" data-quiz-step="2">
            <h3>{{ section.settings.q2_title }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="experience" value="beginner" data-points="{{ section.settings.q2_beginner_points }}" required>
                <span>{{ section.settings.q2_beginner_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="experience" value="some_experience" data-points="{{ section.settings.q2_some_points }}">
                <span>{{ section.settings.q2_some_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="experience" value="advanced" data-points="{{ section.settings.q2_advanced_points }}">
                <span>{{ section.settings.q2_advanced_label }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__question hidden" data-quiz-step="3">
            <h3>{{ section.settings.q3_title }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="priority" value="ease_of_use" data-points="{{ section.settings.q3_ease_points }}" required>
                <span>{{ section.settings.q3_ease_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="priority" value="stronger_sensations" data-points="{{ section.settings.q3_stronger_points }}">
                <span>{{ section.settings.q3_stronger_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="priority" value="premium_quality" data-points="{{ section.settings.q3_premium_points }}">
                <span>{{ section.settings.q3_premium_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="priority" value="exploring_new" data-points="{{ section.settings.q3_exploring_points }}">
                <span>{{ section.settings.q3_exploring_label }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__question hidden" data-quiz-step="4">
            <h3>{{ section.settings.q4_title }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="vibrators" required>
                <span>{{ section.settings.q4_vibrators_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="masturbators">
                <span>{{ section.settings.q4_masturbators_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="rabbit_vibrators">
                <span>{{ section.settings.q4_rabbit_vibrators_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="penis_pumps">
                <span>{{ section.settings.q4_penis_pumps_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="remote_control_toys">
                <span>{{ section.settings.q4_remote_control_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="clitoris_stimulators">
                <span>{{ section.settings.q4_clitoris_stimulators_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="category_interest" value="extras">
                <span>{{ section.settings.q4_extras_label }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__question hidden" data-quiz-step="5">
            <h3>{{ section.settings.q5_title }}</h3>

            <div class="lm-product-quiz__options">
              <label class="lm-product-quiz__option">
                <input type="radio" name="price_range" value="up_to_70" required>
                <span>{{ section.settings.q5_price_1_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="price_range" value="70_to_150">
                <span>{{ section.settings.q5_price_2_label }}</span>
              </label>

              <label class="lm-product-quiz__option">
                <input type="radio" name="price_range" value="150_plus">
                <span>{{ section.settings.q5_price_3_label }}</span>
              </label>
            </div>
          </div>

          <div class="lm-product-quiz__actions hidden" data-quiz-actions>
            <button type="submit" class="button button--primary">
              {{ section.settings.submit_button_label }}
            </button>
          </div>
        </form>

        <div class="lm-product-quiz__result hidden" data-quiz-result>
          <p class="lm-product-quiz__result-label">{{ section.settings.result_label }}</p>
          <h3 data-result-title></h3>
          <p data-result-description></p>
          <p class="lm-product-quiz__score" data-result-score></p>

          <div class="lm-product-quiz__products" data-result-products></div>

          <div class="lm-product-quiz__result-actions">
            <button type="button" class="lm-product-quiz__restart-button" data-quiz-restart>
              {{ section.settings.restart_button_label }}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-quiz-results>
    [
      {% for block in section.blocks %}
        {
          "id": {{ block.id | json }},
          "min": {{ block.settings.min_score | json }},
          "max": {{ block.settings.max_score | json }},
          "category": {{ block.settings.category | json }},
          "title": {{ block.settings.result_title | json }},
          "description": {{ block.settings.result_description | json }},
          "products": [
            {% assign first_product_added = false %}

            {% for i in (1..10) %}
              {% assign product_setting = 'product_' | append: i %}
              {% assign selected_product = block.settings[product_setting] %}

              {% if selected_product != blank %}
                {% if first_product_added %},{% endif %}
                {% assign first_product_added = true %}
                {
                  "title": {{ selected_product.title | json }},
                  "url": {{ selected_product.url | json }},
                  "price": {{ selected_product.price | money | json }},
                  "priceCents": {{ selected_product.price | json }},
                  "image": {% if selected_product.featured_image %}{{ selected_product.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %}
                }
              {% endif %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>

  <style>
    #lm-product-quiz-{{ section.id }} {
      background: #ffffff;
      border-top: 1px solid rgba(43, 37, 33, 0.12);
      color: #2f2b30;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #lm-product-quiz-{{ section.id }} .page-width {
      /* padding-left: clamp(16px, 2.4vw, 40px);
      padding-right: clamp(16px, 2.4vw, 40px); */
    }

    #lm-product-quiz-{{ section.id }} .hidden {
      display: none !important;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz {
      background: linear-gradient(135deg, #fffaf0 0%, #eef9f7 46%, #f8f1fb 100%);
      border: 1px solid rgba(43, 37, 33, 0.06);
      box-shadow: none;
      display: grid;
      margin: 0 auto;
      /* max-width: 1520px; */
      min-height: 190px;
      overflow: hidden;
      padding: clamp(28px, 4vw, 58px) clamp(22px, 5vw, 74px);
      text-align: center;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__eyebrow {
      color: #d2174f;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      line-height: 1.2;
      margin: 0 0 10px;
      opacity: 1;
      text-transform: uppercase;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__heading {
      color: #2f2b30;
      font-size: clamp(24px, 2.6vw, 42px);
      font-weight: 500;
      letter-spacing: -0.01em;
      line-height: 1.12;
      margin: 0 0 14px;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__intro,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__question,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__result {
      background: transparent;
      border-radius: 0;
      padding: 0;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__intro {
      margin: 0 auto;
      max-width: 760px;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__intro p,
    #lm-product-quiz-{{ section.id }} [data-result-description] {
      color: #5f5652;
      font-size: 14px;
      letter-spacing: 0.02em;
      line-height: 1.55;
      margin: 0 auto 18px;
      max-width: 720px;
    }

    #lm-product-quiz-{{ section.id }} [data-quiz-start],
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__actions .button,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__restart-button {
      align-items: center;
      appearance: none;
      -webkit-appearance: none;
      background: #ffffff !important;
      border: 1px solid #2b2521;
      border-radius: 0;
      box-shadow: none !important;
      color: #2b2521 !important;
      cursor: pointer;
      display: inline-flex;
      font: inherit;
      font-size: 13px;
      font-weight: 600;
      justify-content: center;
      letter-spacing: 0.06em;
      line-height: 1;
      min-height: 44px;
      min-width: 165px;
      outline: none !important;
      padding: 13px 28px;
      text-decoration: none;
      text-transform: uppercase;
      transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
    }

    #lm-product-quiz-{{ section.id }} [data-quiz-start]:hover,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__actions .button:hover,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__restart-button:hover {
      background: #2b2521 !important;
      border-color: #2b2521 !important;
      color: #ffffff !important;
      transform: translateY(-1px);
    }

    #lm-product-quiz-{{ section.id }} [data-quiz-start]:focus-visible,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__actions .button:focus-visible,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__restart-button:focus-visible {
      outline: 2px solid #d2174f !important;
      outline-offset: 3px;
    }

    #lm-product-quiz-{{ section.id }} [data-quiz-start]::before,
    #lm-product-quiz-{{ section.id }} [data-quiz-start]::after,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__actions .button::before,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__actions .button::after,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__restart-button::before,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__restart-button::after {
      box-shadow: none !important;
      content: none !important;
      display: none !important;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__body,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__form {
      display: grid;
      gap: 22px;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__progress {
      align-items: center;
      background: rgba(255, 255, 255, 0.74);
      border: 1px solid rgba(43, 37, 33, 0.08);
      color: #5f5652;
      display: inline-flex;
      font-size: 12px;
      font-weight: 700;
      justify-self: center;
      letter-spacing: 0.08em;
      line-height: 1;
      margin: 0;
      opacity: 1;
      padding: 9px 14px;
      text-transform: uppercase;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__question {
      animation: lmQuizFadeIn-{{ section.id }} 0.25s ease;
      margin: 0 auto;
      max-width: 900px;
      width: 100%;
    }

    @keyframes lmQuizFadeIn-{{ section.id }} {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__question h3,
    #lm-product-quiz-{{ section.id }} [data-result-title] {
      color: #2f2b30;
      font-size: clamp(20px, 2vw, 30px);
      font-weight: 500;
      letter-spacing: -0.01em;
      line-height: 1.2;
      margin: 0 0 20px;
      text-align: center;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__options {
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__option {
      align-items: center;
      background: rgba(255, 255, 255, 0.74);
      border: 1px solid rgba(43, 37, 33, 0.08);
      color: #3a3431;
      cursor: pointer;
      display: flex;
      gap: 12px;
      min-height: 56px;
      padding: 15px 16px;
      text-align: left;
      transition: background 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__option:hover {
      background: #ffffff;
      border-color: rgba(248, 39, 92, 0.2);
      box-shadow: 0 14px 28px rgba(43, 37, 33, 0.06);
      transform: translateY(-1px);
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__option:has(input:checked) {
      background: #fff3f8;
      border-color: rgba(248, 39, 92, 0.45);
      box-shadow: inset 0 0 0 1px rgba(248, 39, 92, 0.18);
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__option input {
      accent-color: #f8275c;
      flex-shrink: 0;
      height: 16px;
      margin: 0;
      width: 16px;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__actions,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__result-actions {
      margin-top: 8px;
      padding-left: 0;
      text-align: center;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__result {
      margin: 0 auto;
      max-width: 1180px;
      width: 100%;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__result-label {
      color: #d2174f;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      line-height: 1.2;
      margin: 0 0 10px;
      opacity: 1;
      text-transform: uppercase;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__score {
      color: #5f5652;
      font-size: 13px;
      margin: 4px 0 24px;
      opacity: 0.82;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__products {
      display: grid;
      gap: 16px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      text-align: left;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__empty-message,
    #lm-product-quiz-{{ section.id }} .lm-product-quiz__product {
      background: rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(43, 37, 33, 0.08);
      border-radius: 0;
      box-shadow: none;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__empty-message {
      grid-column: 1 / -1;
      padding: 18px;
      text-align: center;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__empty-message p {
      margin: 0 0 8px;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__empty-message p:last-child {
      margin-bottom: 0;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__product {
      padding: 16px;
      transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__product:hover {
      border-color: rgba(248, 39, 92, 0.16);
      box-shadow: 0 18px 36px rgba(43, 37, 33, 0.08);
      transform: translateY(-2px);
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__product-link {
      color: inherit;
      display: block;
      text-decoration: none;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__product-image {
      align-items: center;
      background: #ffffff;
      display: flex;
      height: 250px;
      justify-content: center;
      margin-bottom: 12px;
      overflow: hidden;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__product-image img {
      display: block;
      height: 100%;
      object-fit: contain;
      width: 100%;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__product-title {
      color: #2f2b30;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.02em;
      line-height: 1.35;
      margin: 0 0 8px;
      text-transform: uppercase;
    }

    #lm-product-quiz-{{ section.id }} .lm-product-quiz__product-price {
      color: #d2174f;
      font-size: 15px;
      font-weight: 700;
      margin: 0;
    }

    @media screen and (max-width: 989px) {
      #lm-product-quiz-{{ section.id }} .lm-product-quiz__products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #lm-product-quiz-{{ section.id }} {
        padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
      }

      #lm-product-quiz-{{ section.id }} .page-width {
        padding-left: 14px;
        padding-right: 14px;
      }

      #lm-product-quiz-{{ section.id }} .lm-product-quiz {
        min-height: 165px;
        padding: 26px 18px;
      }

      #lm-product-quiz-{{ section.id }} .lm-product-quiz__options,
      #lm-product-quiz-{{ section.id }} .lm-product-quiz__products {
        grid-template-columns: 1fr;
      }

      #lm-product-quiz-{{ section.id }} .lm-product-quiz__intro p,
      #lm-product-quiz-{{ section.id }} [data-result-description] {
        font-size: 13px;
      }

      #lm-product-quiz-{{ section.id }} .lm-product-quiz__option {
        min-height: 52px;
      }

      #lm-product-quiz-{{ section.id }} .lm-product-quiz__product-image {
        height: 220px;
      }
    }
  </style>

  <script>
    (() => {
      const root = document.getElementById('lm-product-quiz-{{ section.id }}');

      if (!root) return;

      const intro = root.querySelector('[data-quiz-intro]');
      const body = root.querySelector('[data-quiz-body]');
      const form = root.querySelector('[data-quiz-form]');
      const resultBox = root.querySelector('[data-quiz-result]');
      const resultTitle = root.querySelector('[data-result-title]');
      const resultDescription = root.querySelector('[data-result-description]');
      const resultScore = root.querySelector('[data-result-score]');
      const resultProducts = root.querySelector('[data-result-products]');
      const startButton = root.querySelector('[data-quiz-start]');
      const restartButton = root.querySelector('[data-quiz-restart]');
      const resultsDataEl = root.querySelector('[data-quiz-results]');
      const steps = Array.from(root.querySelectorAll('[data-quiz-step]'));
      const actions = root.querySelector('[data-quiz-actions]');
      const currentStepText = root.querySelector('[data-current-step]');
      const totalStepsText = root.querySelector('[data-total-steps]');

      let resultGroups = [];
      let currentStep = 1;

      const quizTexts = {
        noMatchingTitle: {{ section.settings.no_matching_result_title | json }},
        noMatchingDescription: {{ section.settings.no_matching_result_description | json }},
        emptyProductsLine1: {{ section.settings.empty_products_line_1 | json }},
        emptyProductsLine2: {{ section.settings.empty_products_line_2 | json }},
        fallbackResultTitle: {{ section.settings.fallback_result_title | json }}
      };if (totalStepsText) {
        totalStepsText.textContent = steps.length;
      }

      try {
        resultGroups = JSON.parse(resultsDataEl.textContent);
      } catch (error) {
        console.error('Quiz results JSON parsing failed', error);
      }

      function getHeaderOffset() {
        const stickyHeader =
          document.querySelector('.shopify-section-header-sticky') ||
          document.querySelector('sticky-header') ||
          document.querySelector('.header-wrapper') ||
          document.querySelector('header');

        if (!stickyHeader) {
          return 90;
        }

        return stickyHeader.offsetHeight + 24;
      }

      function scrollToQuestion(questionElement) {
        if (!questionElement) return;

        const headerOffset = getHeaderOffset();
        const questionTop = questionElement.getBoundingClientRect().top + window.pageYOffset;

        window.scrollTo({
          top: questionTop - headerOffset,
          behavior: 'smooth'
        });
      }

      function showStep(stepNumber) {
        currentStep = stepNumber;

        steps.forEach((step) => {
          const isActive = Number(step.dataset.quizStep) === stepNumber;
          step.classList.toggle('hidden', !isActive);
        });

        if (currentStepText) {
          currentStepText.textContent = stepNumber;
        }

        if (actions) {
          const isLastStep = stepNumber === steps.length;
          actions.classList.toggle('hidden', !isLastStep);
        }
      }

      function goToNextStep() {
        if (currentStep < steps.length) {
          showStep(currentStep + 1);
        }
      }

      function calculateScore() {
        const selectedInputs = form.querySelectorAll('input[data-points]:checked');
        let total = 0;

        selectedInputs.forEach((input) => {
          total += Number(input.dataset.points || 0);
        });

        return total;
      }

      function getSelectedValue(name) {
        const selected = form.querySelector(`input[name="${name}"]:checked`);
        return selected ? selected.value : '';
      }

      function findMatchingGroup(score, category) {
        return resultGroups.find((group) => {
          return (
            score >= Number(group.min) &&
            score <= Number(group.max) &&
            group.category === category
          );
        });
      }

      function filterProductsByPrice(products, priceRange) {
        return products.filter((product) => {
          const price = Number(product.priceCents || 0);

          if (priceRange === 'up_to_70') {
            return price <= 7000;
          }

          if (priceRange === '70_to_150') {
            return price > 7000 && price <= 15000;
          }

          if (priceRange === '150_plus') {
            return price > 15000;
          }

          return true;
        });
      }

      function renderProducts(products) {
        resultProducts.innerHTML = '';

        if (!products || !products.length) {
          const emptyMessage = document.createElement('div');
          emptyMessage.className = 'lm-product-quiz__empty-message';

          const firstLine = document.createElement('p');
          firstLine.textContent = quizTexts.emptyProductsLine1;

          const secondLine = document.createElement('p');
          secondLine.textContent = quizTexts.emptyProductsLine2;

          emptyMessage.appendChild(firstLine);
          emptyMessage.appendChild(secondLine);
          resultProducts.appendChild(emptyMessage);

          return;
        }

        products.forEach((product) => {
          const card = document.createElement('article');
          card.className = 'lm-product-quiz__product';

          const link = document.createElement('a');
          link.className = 'lm-product-quiz__product-link';
          link.href = product.url;

          const imageWrapper = document.createElement('div');
          imageWrapper.className = 'lm-product-quiz__product-image';

          if (product.image) {
            const image = document.createElement('img');
            image.src = product.image;
            image.alt = product.title;
            image.loading = 'lazy';
            imageWrapper.appendChild(image);
          }

          const title = document.createElement('h4');
          title.className = 'lm-product-quiz__product-title';
          title.textContent = product.title;

          const price = document.createElement('p');
          price.className = 'lm-product-quiz__product-price';
          price.textContent = product.price;

          link.appendChild(imageWrapper);
          link.appendChild(title);
          link.appendChild(price);

          card.appendChild(link);
          resultProducts.appendChild(card);
        });
      }

      function showResults(event) {
        event.preventDefault();

        if (!form.reportValidity()) return;

        const score = calculateScore();
        const selectedCategory = getSelectedValue('category_interest');
        const selectedPriceRange = getSelectedValue('price_range');

        const matchedGroup = findMatchingGroup(score, selectedCategory);

        if (!matchedGroup) {
          resultTitle.textContent = quizTexts.noMatchingTitle;
          resultDescription.textContent = quizTexts.noMatchingDescription;

          if (resultScore) {
            resultScore.textContent = '';
          }

          resultProducts.innerHTML = '';
          form.classList.add('hidden');
          resultBox.classList.remove('hidden');
          scrollToQuestion(resultBox);

          return;
        }

        const filteredProducts = filterProductsByPrice(matchedGroup.products, selectedPriceRange);

        resultTitle.textContent = matchedGroup.title || quizTexts.fallbackResultTitle;
        resultDescription.textContent = matchedGroup.description || '';

        if (resultScore) {
          resultScore.textContent = '';
        }

        renderProducts(filteredProducts);

        form.classList.add('hidden');
        resultBox.classList.remove('hidden');
        scrollToQuestion(resultBox);
      }

      function restartQuiz() {
        form.reset();
        resultProducts.innerHTML = '';
        resultBox.classList.add('hidden');
        form.classList.remove('hidden');

        showStep(1);

        if (intro) {
          intro.classList.remove('hidden');
        }

        body.classList.add('hidden');

        if (intro) {
          scrollToQuestion(intro);
        }
      }

      function handleAnswerChange(event) {
        const input = event.target;

        if (!input.matches('input[type="radio"]')) return;

        setTimeout(() => {
          if (currentStep < steps.length) {
            goToNextStep();
          }
        }, 250);
      }

      if (startButton) {
        startButton.addEventListener('click', () => {
          if (intro) {
            intro.classList.add('hidden');
          }

          body.classList.remove('hidden');
          form.classList.remove('hidden');
          resultBox.classList.add('hidden');
          showStep(1);
        });
      } else {
        body.classList.remove('hidden');
        showStep(1);
      }

      if (form) {
        form.addEventListener('change', handleAnswerChange);
        form.addEventListener('submit', showResults);
      }

      if (restartButton) {
        restartButton.addEventListener('click', restartQuiz);
      }
    })();
  </script>
</section>

