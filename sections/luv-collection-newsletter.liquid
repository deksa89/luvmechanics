{%- liquid
  assign newsletter_heading = section.settings.heading | default: 'Stay in touch'
  assign newsletter_text = section.settings.text | default: 'Tips, news and special offers from LuvMechanics.'
  assign email_placeholder = section.settings.email_placeholder | default: 'Your email address'
  assign button_label = section.settings.button_label | default: 'SUBSCRIBE'
  assign form_id = 'LuvCollectionNewsletterForm-' | append: section.id
  assign input_id = 'LuvCollectionNewsletterEmail-' | append: section.id
  assign error_id = 'LuvCollectionNewsletterError-' | append: section.id
  assign success_id = 'LuvCollectionNewsletterSuccess-' | append: section.id
-%}

<section
  class="luv-collection-newsletter"
  aria-labelledby="LuvCollectionNewsletterTitle-{{ section.id }}"
>
  <div class="luv-collection-newsletter__inner">
    <div class="luv-collection-newsletter__content">
      <h2 class="luv-collection-newsletter__heading" id="LuvCollectionNewsletterTitle-{{ section.id }}">
        {{ newsletter_heading | escape }}
      </h2>
      {%- if newsletter_text != blank -%}
        <p class="luv-collection-newsletter__text">{{ newsletter_text | escape }}</p>
      {%- endif -%}
    </div>

    {%- form 'customer', id: form_id, class: 'luv-collection-newsletter__form', data-luv-track: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <div class="luv-collection-newsletter__field">
        <label class="visually-hidden" for="{{ input_id }}">
          {{ email_placeholder | escape }}
        </label>
        <input
          class="luv-collection-newsletter__input"
          id="{{ input_id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="{{ error_id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="{{ success_id }}"
          {% endif %}
          placeholder="{{ email_placeholder | escape }}"
          required
        >
      </div>

      <button class="luv-collection-newsletter__button" type="submit" name="commit">
        {{- button_label | escape -}}
      </button>

      {%- if form.errors -%}
        <small
          class="luv-collection-newsletter__message luv-collection-newsletter__message--error"
          id="{{ error_id }}"
          role="alert"
        >
          {{- form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email -}}
        </small>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <h3
          class="luv-collection-newsletter__message luv-collection-newsletter__message--success"
          id="{{ success_id }}"
          tabindex="-1"
          autofocus
        >
          {{- 'newsletter.success' | t -}}
        </h3>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Luv collection newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in touch"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tips, news and special offers from LuvMechanics."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SUBSCRIBE"
    }
  ],
  "presets": [
    {
      "name": "Luv collection newsletter"
    }
  ]
}
{% endschema %}
