{% comment %}
  Custom section: Split bundle offer
  Displays media/text on one side and a configurable product bundle on the other.
{% endcomment %}

{%- liquid
  assign product_1 = section.settings.product_1
  assign product_2 = section.settings.product_2
  assign product_1_quantity = section.settings.product_1_quantity
  assign product_2_quantity = section.settings.product_2_quantity

  if product_1 == blank
    assign product_1_quantity = 0
  endif

  if product_2 == blank
    assign product_2_quantity = 0
  endif

  assign total_quantity = product_1_quantity | plus: product_2_quantity
  if total_quantity > 5
    assign product_2_quantity = 5 | minus: product_1_quantity
    if product_2_quantity < 0
      assign product_2_quantity = 0
    endif
    assign total_quantity = product_1_quantity | plus: product_2_quantity
  endif

  assign product_1_variant = product_1.selected_or_first_available_variant
  assign product_2_variant = product_2.selected_or_first_available_variant

  if product_1_variant.id == product_2_variant.id and product_2_quantity > 0
    assign product_1_quantity = product_1_quantity | plus: product_2_quantity
    if product_1_quantity > 5
      assign product_1_quantity = 5
    endif
    assign product_2_quantity = 0
    assign total_quantity = product_1_quantity
  endif

  assign product_1_total = 0
  assign product_2_total = 0

  if product_1_variant != blank
    assign product_1_total = product_1_variant.price | times: product_1_quantity
  endif

  if product_2_variant != blank
    assign product_2_total = product_2_variant.price | times: product_2_quantity
  endif

  assign regular_total = product_1_total | plus: product_2_total
  assign bundle_price = section.settings.bundle_price | times: 100
  assign savings = regular_total | minus: bundle_price
  assign discount_percent = 0

  if regular_total > 0 and savings > 0
    assign discount_percent = savings | times: 100 | divided_by: regular_total
  endif

  assign has_bundle = false
  if product_1 != blank and product_1_quantity > 0
    assign has_bundle = true
  endif

  assign bundle_available = false
  if product_1_variant.available and product_1_quantity > 0
    assign bundle_available = true
  endif
  if product_2_quantity > 0 and product_2_variant.available == false
    assign bundle_available = false
  endif
-%}

<section
  class="split-bundle-offer split-bundle-offer-{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
  style="
    --section-bg: {{ section.settings.section_background }};
    --media-bg: {{ section.settings.media_background }};
    --content-bg: {{ section.settings.content_background }};
    --text-color: {{ section.settings.text_color }};
    --muted-color: {{ section.settings.muted_color }};
    --accent-color: {{ section.settings.accent_color }};
    --button-bg: {{ section.settings.button_background }};
    --button-text: {{ section.settings.button_text_color }};
    --button-border: {{ section.settings.button_border_color }};
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --padding-top-desktop: {{ section.settings.padding_top }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="split-bundle-offer__inner page-width">
    <div class="split-bundle-offer__grid split-bundle-offer__grid--{{ section.settings.media_position }} split-bundle-offer__grid--mobile-{{ section.settings.mobile_layout }}">
      <div class="split-bundle-offer__media-panel">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '375, 550, 750, 1100, 1400, 1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'split-bundle-offer__image',
              alt: section.settings.image.alt
          }}
        {% else %}
          <div class="split-bundle-offer__placeholder">
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if section.settings.media_heading != blank or section.settings.media_text != blank %}
          <div class="split-bundle-offer__media-copy">
            {% if section.settings.media_heading != blank %}
              <h2 class="split-bundle-offer__media-heading">{{ section.settings.media_heading }}</h2>
            {% endif %}

            {% if section.settings.media_text != blank %}
              <div class="split-bundle-offer__media-text rte">{{ section.settings.media_text }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="split-bundle-offer__bundle-panel">
        {% if section.settings.eyebrow != blank %}
          <p class="split-bundle-offer__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="split-bundle-offer__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="split-bundle-offer__text rte">{{ section.settings.text }}</div>
        {% endif %}

        <div class="split-bundle-offer__products" aria-label="Bundle products">
          {% if product_1 != blank %}
            <div class="split-bundle-offer__product">
              <span class="split-bundle-offer__quantity">{{ product_1_quantity }}x</span>
              <div class="split-bundle-offer__product-image-wrap">
                {% if product_1.featured_image != blank %}
                  {{
                    product_1.featured_image
                    | image_url: width: 220
                    | image_tag:
                      loading: 'lazy',
                      widths: '110, 160, 220',
                      sizes: '88px',
                      class: 'split-bundle-offer__product-image',
                      alt: product_1.featured_image.alt
                  }}
                {% else %}
                  {{ 'product-apparel-2' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <div class="split-bundle-offer__product-info">
                <h3 class="split-bundle-offer__product-title">{{ product_1.title }}</h3>
                <p class="split-bundle-offer__product-price">
                  {{ product_1_variant.price | money }} x {{ product_1_quantity }}
                </p>
              </div>
            </div>
          {% endif %}

          {% if product_2 != blank and product_2_quantity > 0 %}
            <div class="split-bundle-offer__product">
              <span class="split-bundle-offer__quantity">{{ product_2_quantity }}x</span>
              <div class="split-bundle-offer__product-image-wrap">
                {% if product_2.featured_image != blank %}
                  {{
                    product_2.featured_image
                    | image_url: width: 220
                    | image_tag:
                      loading: 'lazy',
                      widths: '110, 160, 220',
                      sizes: '88px',
                      class: 'split-bundle-offer__product-image',
                      alt: product_2.featured_image.alt
                  }}
                {% else %}
                  {{ 'product-apparel-3' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <div class="split-bundle-offer__product-info">
                <h3 class="split-bundle-offer__product-title">{{ product_2.title }}</h3>
                <p class="split-bundle-offer__product-price">
                  {{ product_2_variant.price | money }} x {{ product_2_quantity }}
                </p>
              </div>
            </div>
          {% endif %}

          {% unless has_bundle %}
            <div class="split-bundle-offer__empty">
              {{ 'product-apparel-1' | placeholder_svg_tag }}
              <p>Select at least one bundle product.</p>
            </div>
          {% endunless %}
        </div>

        {% if has_bundle %}
          <div class="split-bundle-offer__summary">
            <div class="split-bundle-offer__summary-row">
              <span>{{ section.settings.regular_price_label }}</span>
              <s>{{ regular_total | money }}</s>
            </div>
            <div class="split-bundle-offer__summary-row split-bundle-offer__summary-row--strong">
              <span>{{ section.settings.bundle_price_label }}</span>
              <strong>{{ bundle_price | money }}</strong>
            </div>

            {% if savings > 0 %}
              <div class="split-bundle-offer__saving">
                <span>{{ discount_percent }}% OFF</span>
                <strong>{{ section.settings.savings_label }} {{ savings | money }}</strong>
              </div>
            {% endif %}
          </div>

          {% if section.settings.discount_note != blank %}
            <p class="split-bundle-offer__note">{{ section.settings.discount_note }}</p>
          {% endif %}
        {% endif %}

        {% if has_bundle %}
          <form method="post" action="{{ routes.cart_add_url }}" class="split-bundle-offer__form">
            {% if section.settings.discount_code != blank %}
              <input
                type="hidden"
                name="return_to"
                value="/discount/{{ section.settings.discount_code | url_encode }}?redirect=/cart"
              >
            {% endif %}

            <input type="hidden" name="items[0][id]" value="{{ product_1_variant.id }}">
            <input type="hidden" name="items[0][quantity]" value="{{ product_1_quantity }}">
            <input type="hidden" name="items[0][properties][_bundle]" value="{{ section.settings.heading | escape }}">
            <input type="hidden" name="items[0][properties][_bundle_price]" value="{{ bundle_price | money }}">

            {% if product_2 != blank and product_2_quantity > 0 %}
              <input type="hidden" name="items[1][id]" value="{{ product_2_variant.id }}">
              <input type="hidden" name="items[1][quantity]" value="{{ product_2_quantity }}">
              <input type="hidden" name="items[1][properties][_bundle]" value="{{ section.settings.heading | escape }}">
              <input type="hidden" name="items[1][properties][_bundle_price]" value="{{ bundle_price | money }}">
            {% endif %}

            <button
              type="submit"
              class="split-bundle-offer__button"
              {% unless bundle_available %}
                disabled
              {% endunless %}
            >
              {% if bundle_available %}
                {{ section.settings.button_label }}
              {% else %}
                {{ section.settings.sold_out_label }}
              {% endif %}
            </button>
          </form>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .split-bundle-offer-{{ section.id }} {
    background: var(--section-bg);
    padding-top: var(--padding-top-mobile);
    padding-bottom: var(--padding-bottom-mobile);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid {
    display: grid;
    gap: 0;
    overflow: hidden;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--mobile-horizontal {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--mobile-stacked {
    grid-template-columns: 1fr;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__media-panel,
  .split-bundle-offer-{{ section.id }} .split-bundle-offer__bundle-panel {
    min-width: 0;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__media-panel {
    position: relative;
    min-height: {{ section.settings.media_min_height_mobile }}px;
    background: var(--media-bg);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__image,
  .split-bundle-offer-{{ section.id }} .split-bundle-offer__placeholder,
  .split-bundle-offer-{{ section.id }} .split-bundle-offer__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__media-copy {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 24px;
    color: var(--text-color);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.48), rgba(0, 0, 0, 0));
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__media-heading,
  .split-bundle-offer-{{ section.id }} .split-bundle-offer__heading {
    margin: 0;
    color: var(--text-color);
    line-height: 1.1;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__media-heading {
    max-width: 520px;
    font-size: clamp(26px, 4vw, 46px);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__media-text {
    max-width: 560px;
    margin-top: 12px;
    color: var(--text-color);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__bundle-panel {
    background: var(--content-bg);
    color: var(--text-color);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__eyebrow {
    margin: 0 0 10px;
    color: var(--accent-color);
    font-size: 1.2rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__heading {
    font-size: clamp(28px, 4vw, 52px);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__text {
    margin-top: 14px;
    color: var(--muted-color);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__products {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__product {
    display: grid;
    grid-template-columns: auto 72px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 12px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: rgba(255, 255, 255, 0.42);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__quantity {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 32px;
    padding: 4px 8px;
    background: var(--accent-color);
    color: #ffffff;
    font-weight: 700;
    line-height: 1;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__product-image-wrap {
    width: 72px;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--media-bg);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__product-image,
  .split-bundle-offer-{{ section.id }} .split-bundle-offer__product-image-wrap svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__product-title {
    margin: 0 0 4px;
    color: var(--text-color);
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__product-price {
    margin: 0;
    color: var(--muted-color);
    font-size: 1.3rem;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__empty {
    padding: 24px;
    text-align: center;
    color: var(--muted-color);
    border: 1px dashed rgba(0, 0, 0, 0.18);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__empty svg {
    max-width: 120px;
    height: auto;
    margin: 0 auto 12px;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__summary {
    display: grid;
    gap: 8px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__summary-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted-color);
    font-size: 1.4rem;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__summary-row--strong {
    color: var(--text-color);
    font-size: 1.8rem;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__summary-row strong {
    color: var(--accent-color);
    font-size: 2.6rem;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__saving {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background: color-mix(in srgb, var(--accent-color), transparent 88%);
    color: var(--accent-color);
    font-size: 1.4rem;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__saving span {
    font-weight: 700;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__note {
    margin: 12px 0 0;
    color: var(--muted-color);
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__form {
    margin-top: 18px;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__button {
    width: 100%;
    min-height: 48px;
    padding: 12px 22px;
    background: var(--button-bg);
    color: var(--button-text);
    border: 1px solid var(--button-border);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__button:hover:not(:disabled) {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .split-bundle-offer-{{ section.id }} .split-bundle-offer__button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media screen and (max-width: 749px) {
    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--mobile-horizontal .split-bundle-offer__media-panel {
      min-height: {{ section.settings.media_min_height_mobile | divided_by: 1.4 | round }}px;
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--mobile-horizontal .split-bundle-offer__bundle-panel {
      padding: 14px;
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--mobile-horizontal .split-bundle-offer__media-copy {
      padding: 14px;
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--mobile-horizontal .split-bundle-offer__media-text,
    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--mobile-horizontal .split-bundle-offer__text {
      display: none;
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--mobile-horizontal .split-bundle-offer__product {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--mobile-horizontal .split-bundle-offer__product-image-wrap {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .split-bundle-offer-{{ section.id }} {
      padding-top: var(--padding-top-desktop);
      padding-bottom: var(--padding-bottom-desktop);
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--right .split-bundle-offer__media-panel {
      order: 2;
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__grid--right .split-bundle-offer__bundle-panel {
      order: 1;
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__media-panel {
      min-height: {{ section.settings.media_min_height }}px;
    }

    .split-bundle-offer-{{ section.id }} .split-bundle-offer__bundle-panel {
      min-height: {{ section.settings.media_min_height }}px;
      padding: 48px;
    }
  }
</style>

{% schema %}
{
  "name": "Split bundle offer",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image/text side on desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "range",
      "id": "media_min_height",
      "label": "Desktop height",
      "min": 360,
      "max": 820,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "media_min_height_mobile",
      "label": "Mobile image height",
      "min": 220,
      "max": 620,
      "step": 20,
      "unit": "px",
      "default": 360
    },
    {
      "type": "header",
      "content": "Image/text side"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "media_heading",
      "label": "Image side heading",
      "default": "Build your perfect bundle"
    },
    {
      "type": "richtext",
      "id": "media_text",
      "label": "Image side text",
      "default": "<p>Choose a ready-made offer and save when buying more together.</p>"
    },
    {
      "type": "header",
      "content": "Bundle content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bundle offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "5 products for one better price"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add up to 5 items in one bundle and show the discount clearly.</p>"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "range",
      "id": "product_1_quantity",
      "label": "Product 1 quantity",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "range",
      "id": "product_2_quantity",
      "label": "Product 2 quantity",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 0,
      "info": "If the total goes over 5, the section caps product 2 quantity automatically."
    },
    {
      "type": "number",
      "id": "bundle_price",
      "label": "Bundle price",
      "default": 49
    },
    {
      "type": "text",
      "id": "regular_price_label",
      "label": "Regular price label",
      "default": "Regular price"
    },
    {
      "type": "text",
      "id": "bundle_price_label",
      "label": "Bundle price label",
      "default": "Bundle price"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Savings label",
      "default": "You save"
    },
    {
      "type": "text",
      "id": "discount_note",
      "label": "Discount note",
      "default": "Create the matching Shopify discount so cart and checkout use the shown bundle price."
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "info": "Optional. Create this code in Shopify Discounts first. The section will apply it after adding the bundle to cart."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add bundle to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Bundle unavailable"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#ffffff"
    },
