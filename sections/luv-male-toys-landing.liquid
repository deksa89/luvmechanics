{{ 'luv-male-toys-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'luv-male-toys-landing.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign experience_blocks = section.blocks | where: 'type', 'experience'
  assign guide_blocks = section.blocks | where: 'type', 'guidance'
  assign feature_blocks = section.blocks | where: 'type', 'spotlight_feature'
  assign care_blocks = section.blocks | where: 'type', 'care'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign first_product = blank
  for product_block in product_blocks
    if product_block.settings.product != blank
      assign first_product = product_block.settings.product
      break
    endif
  endfor
  assign hero_image = section.settings.hero_image | default: first_product.featured_image
  assign hero_alt = hero_image.alt | default: first_product.title | default: page.title
  assign spotlight_product = section.settings.spotlight_product
  assign spotlight_image = section.settings.spotlight_image | default: spotlight_product.featured_image
  assign spotlight_alt = spotlight_image.alt | default: spotlight_product.title | default: page.title
  assign products_anchor = '#lm-male-toys-products-' | append: section.id
  assign comparison_anchor = '#lm-male-toys-comparison-' | append: section.id
  unless section.settings.show_comparison
    assign comparison_anchor = products_anchor
  endunless
  assign primary_url = section.settings.primary_url | default: products_anchor
  assign secondary_url = section.settings.secondary_url | default: comparison_anchor
  assign spotlight_url = section.settings.spotlight_url | default: spotlight_product.url | default: products_anchor
  assign final_primary_url = section.settings.final_primary_url | default: products_anchor
  assign final_secondary_url = section.settings.final_secondary_url | default: comparison_anchor
  assign currency = cart.currency.iso_code | default: localization.country.currency.iso_code | default: shop.currency
-%}
<lm-male-toys-landing class="lm-male-toys" data-section-id="{{ section.id }}" data-locale="{{ request.locale.iso_code | escape }}" data-currency="{{ currency | escape }}" {% if request.design_mode %}data-design-mode{% endif %}>
<div class="lm-male-toys-container">
<div class="lm-male-toys-hero">
<div class="lm-male-toys-hero-copy">
<p class="lm-male-toys-eyebrow">{%- assign fallback = 'lm_male_toys.hero_eyebrow' | t -%}{{ section.settings.hero_eyebrow | default: fallback | escape }}</p><h1 class="lm-male-toys-title">{%- assign fallback = 'lm_male_toys.hero_heading' | t -%}{{ section.settings.hero_heading | default: fallback | escape }}</h1><p class="lm-male-toys-lead">{%- assign fallback = 'lm_male_toys.hero_body' | t -%}{{ section.settings.hero_body | default: fallback | escape }}</p><div class="lm-male-toys-actions"><a class="lm-male-toys-button" href="{{ primary_url | escape }}">{%- assign fallback = 'lm_male_toys.primary_label' | t -%}{{ section.settings.primary_label | default: fallback | escape }}</a><a class="lm-male-toys-button lm-male-toys-button--outline" href="{{ secondary_url | escape }}" data-lm-event="compare_click" data-lm-section="hero">{%- assign fallback = 'lm_male_toys.secondary_label' | t -%}{{ section.settings.secondary_label | default: fallback | escape }}</a></div><ul class="lm-male-toys-trust-row" role="list"><li>{% render 'luv-male-toys-icon', icon: 'box' %}{{ 'lm_male_toys.packaging' | t | escape }}</li><li>{% render 'luv-male-toys-icon', icon: 'lock' %}{{ 'lm_male_toys.payment' | t | escape }}</li><li>{% render 'luv-male-toys-icon', icon: 'delivery' %}{{ 'lm_male_toys.delivery' | t | escape }}</li></ul></div><div class="lm-male-toys-hero-media">
{% if hero_image != blank %}
{{ hero_image | image_url: width: 1600 | image_tag: widths: '320, 480, 640, 960, 1200, 1600', sizes: '(min-width: 1440px) 720px, (min-width: 900px) 54vw, 92vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
{% else %}<div class="lm-male-toys-image-empty">{% render 'luv-male-toys-icon', icon: 'device' %}{{ 'lm_male_toys.hero_empty' | t | escape }}{% if request.design_mode %}<p>{{ 'lm_male_toys.editor_image' | t | escape }}</p>{% endif %}</div>{% endif %}
</div></div>
{% if section.settings.show_experience %}
<section class="lm-male-toys-band">
<p class="lm-male-toys-eyebrow">{{ 'lm_male_toys.experience_eyebrow' | t | escape }}</p><h2 class="lm-male-toys-heading">{%- assign fallback = 'lm_male_toys.experience_heading' | t -%}{{ section.settings.experience_heading | default: fallback | escape }}</h2><p class="lm-male-toys-intro">{{ 'lm_male_toys.experience_body' | t | escape }}</p><div class="lm-male-toys-four-grid">{% for block in experience_blocks %}
{% liquid
 assign title_key = 'lm_male_toys.' | append: block.settings.topic | append: '_title'
 assign body_key = 'lm_male_toys.' | append: block.settings.topic | append: '_body'
 assign title_default = title_key | t
 assign body_default = body_key | t
%}
<article class="lm-male-toys-info-card" {{ block.shopify_attributes }}>
{% render 'luv-male-toys-icon', icon: block.settings.icon %}
<h3>{{ block.settings.title | default: title_default | escape }}</h3><p>{{ block.settings.body | default: body_default | escape }}</p>
{% if block.settings.url != blank %}<a class="lm-male-toys-text-link" href="{{ block.settings.url | escape }}" data-lm-event="experience_click" data-lm-section="experience" data-experience="{{ block.settings.topic | escape }}">{{ 'lm_male_toys.explore' | t | escape }}<span aria-hidden="true"> →</span><span class="lm-male-toys-visually-hidden"> — {{ block.settings.title | default: title_default | escape }}</span></a>{% endif %}
</article>{% endfor %}</div></section>{% endif %}
<section class="lm-male-toys-band" id="lm-male-toys-products-{{ section.id }}">
<p class="lm-male-toys-eyebrow">{{ 'lm_male_toys.products_eyebrow' | t | escape }}</p><h2 class="lm-male-toys-heading">{%- assign fallback = 'lm_male_toys.products_heading' | t -%}{{ section.settings.products_heading | default: fallback | escape }}</h2><p class="lm-male-toys-intro">{%- assign fallback = 'lm_male_toys.products_body' | t -%}{{ section.settings.products_body | default: fallback | escape }}</p><div class="lm-male-toys-products" role="region" aria-label="{{ 'lm_male_toys.products_heading' | t | escape }}" tabindex="0">{% for block in product_blocks %}{% render 'luv-male-toys-product', block: block, mode: 'card', position: forloop.index %}{% endfor %}</div>
{% if first_product != blank %}<p class="lm-male-toys-swipe-hint">{{ 'lm_male_toys.swipe_hint' | t | escape }} <span aria-hidden="true">→</span></p>{% endif %}</section>
{% if section.settings.show_spotlight %}
<section class="lm-male-toys-band lm-male-toys-spotlight lm-male-toys-panel">
<div class="lm-male-toys-spotlight-media">{% if spotlight_image != blank %}{{ spotlight_image | image_url: width: 1000 | image_tag: widths: '320, 480, 640, 800, 1000', sizes: '(min-width: 1440px) 560px, (min-width: 900px) 44vw, 88vw', loading: 'lazy', alt: spotlight_alt }}{% else %}<div class="lm-male-toys-image-empty">{% render 'luv-male-toys-icon', icon: 'device' %}{{ 'lm_male_toys.image_unavailable' | t | escape }}</div>{% endif %}</div><div>
<p class="lm-male-toys-eyebrow">{{ 'lm_male_toys.spotlight_eyebrow' | t | escape }}</p><h2 class="lm-male-toys-heading">{%- assign fallback = 'lm_male_toys.spotlight_heading' | t -%}{{ section.settings.spotlight_heading | default: fallback | escape }}</h2><p class="lm-male-toys-intro">{%- assign fallback = 'lm_male_toys.spotlight_body' | t -%}{{ section.settings.spotlight_body | default: fallback | escape }}</p><div class="lm-male-toys-feature-list">{% for block in feature_blocks %}{% liquid
 assign title_key = 'lm_male_toys.' | append: block.settings.topic | append: '_title'
 assign body_key = 'lm_male_toys.' | append: block.settings.topic | append: '_body'
 assign title_default = title_key | t
 assign body_default = body_key | t
%}<div class="lm-male-toys-feature" {{ block.shopify_attributes }}>{% render 'luv-male-toys-icon', icon: block.settings.icon %}<div><h3>{{ block.settings.title | default: title_default | escape }}</h3><p>{{ block.settings.body | default: body_default | escape }}</p></div></div>{% endfor %}</div>
<a class="lm-male-toys-button" href="{{ spotlight_url | escape }}" data-lm-event="spotlight_click" data-lm-section="spotlight">{%- assign fallback = 'lm_male_toys.spotlight_cta' | t -%}{{ section.settings.spotlight_cta | default: fallback | escape }}</a></div></section>{% endif %}
{% if section.settings.show_comparison %}<section class="lm-male-toys-band" id="lm-male-toys-comparison-{{ section.id }}">
<p class="lm-male-toys-eyebrow">{{ 'lm_male_toys.comparison_eyebrow' | t | escape }}</p><h2 class="lm-male-toys-heading">{%- assign fallback = 'lm_male_toys.comparison_heading' | t -%}{{ section.settings.comparison_heading | default: fallback | escape }}</h2><p class="lm-male-toys-intro">{{ 'lm_male_toys.comparison_body' | t | escape }}</p><table class="lm-male-toys-table"><caption class="lm-male-toys-visually-hidden">{{ 'lm_male_toys.comparison_heading' | t | escape }}</caption><thead><tr><th scope="col">{{ 'lm_male_toys.model' | t | escape }}</th><th scope="col">{{ 'lm_male_toys.movement' | t | escape }}</th><th scope="col">{{ 'lm_male_toys.heating' | t | escape }}</th><th scope="col">{{ 'lm_male_toys.interactive' | t | escape }}</th><th scope="col">{{ 'lm_male_toys.experience' | t | escape }}</th><th scope="col">{{ 'lm_male_toys.price' | t | escape }}</th><th scope="col">{{ 'lm_male_toys.action' | t | escape }}</th></tr></thead><tbody>{% for block in product_blocks %}{% render 'luv-male-toys-product', block: block, mode: 'comparison', position: forloop.index %}{% endfor %}</tbody></table></section>{% endif %}
{% if section.settings.show_guide %}<section class="lm-male-toys-band lm-male-toys-panel">
<p class="lm-male-toys-eyebrow">{{ 'lm_male_toys.guide_eyebrow' | t | escape }}</p><h2 class="lm-male-toys-heading">{%- assign fallback = 'lm_male_toys.guide_heading' | t -%}{{ section.settings.guide_heading | default: fallback | escape }}</h2><div class="lm-male-toys-four-grid">
{% for block in guide_blocks %}{% liquid
 assign title_key = 'lm_male_toys.' | append: block.settings.topic | append: '_title'
 assign body_key = 'lm_male_toys.' | append: block.settings.topic | append: '_body'
 assign title_default = title_key | t
 assign body_default = body_key | t
%}<article class="lm-male-toys-info-card lm-male-toys-step" {{ block.shopify_attributes }}><span class="lm-male-toys-number" aria-hidden="true">0{{ forloop.index }}</span><div><h3>{{ block.settings.title | default: title_default | escape }}</h3><p>{{ block.settings.body | default: body_default | escape }}</p></div></article>{% endfor %}</div><div class="lm-male-toys-centered-action">
<a class="lm-male-toys-button lm-male-toys-button--outline" href="{{ comparison_anchor | escape }}" data-lm-event="compare_click" data-lm-section="guide">{{ 'lm_male_toys.guide_cta' | t | escape }}</a></div></section>{% endif %}
{% if section.settings.show_care %}<section class="lm-male-toys-band">
<p class="lm-male-toys-eyebrow">{{ 'lm_male_toys.care_eyebrow' | t | escape_once }}</p><h2 class="lm-male-toys-heading">{%- assign fallback = 'lm_male_toys.care_heading' | t -%}{{ section.settings.care_heading | default: fallback | escape }}</h2><div class="lm-male-toys-two-grid">
{% for block in care_blocks %}{% liquid
 assign title_key = 'lm_male_toys.' | append: block.settings.topic | append: '_title'
 assign body_key = 'lm_male_toys.' | append: block.settings.topic | append: '_body'
 assign cta_key = 'lm_male_toys.' | append: block.settings.topic | append: '_cta'
 assign title_default = title_key | t
 assign body_default = body_key | t
 assign cta_default = cta_key | t
%}<article class="lm-male-toys-info-card" {{ block.shopify_attributes }}>{% render 'luv-male-toys-icon', icon: block.settings.icon %}<h3>{{ block.settings.title | default: title_default | escape }}</h3><p>{{ block.settings.body | default: body_default | escape }}</p>{% if block.settings.url != blank %}<a class="lm-male-toys-button lm-male-toys-button--outline" href="{{ block.settings.url | escape }}">{{ block.settings.cta | default: cta_default | escape }}</a>{% endif %}</article>{% endfor %}</div></section>{% endif %}
{%- assign related_bathmate_url = section.settings.related_bathmate_cta_url | default: pages['bathmate'].url -%}
{% if section.settings.show_related_bathmate and related_bathmate_url != blank %}
<section class="lm-male-toys-band lm-male-toys-panel lm-male-toys-related" aria-labelledby="lm-male-toys-related-{{ section.id }}">
  <div>
    <p class="lm-male-toys-eyebrow">{%- assign fallback = 'lm_male_toys.related_bathmate_eyebrow' | t -%}{{ section.settings.related_bathmate_eyebrow | default: fallback | escape_once }}</p>
    <h2 class="lm-male-toys-heading" id="lm-male-toys-related-{{ section.id }}">{%- assign fallback = 'lm_male_toys.related_bathmate_heading' | t -%}{{ section.settings.related_bathmate_heading | default: fallback | escape_once }}</h2>
    <p>{%- assign fallback = 'lm_male_toys.related_bathmate_body' | t -%}{{ section.settings.related_bathmate_body | default: fallback | escape_once }}</p>
  </div>
  <a class="lm-male-toys-button lm-male-toys-button--outline" href="{{ related_bathmate_url | escape }}" data-lm-event="related_bathmate_click" data-lm-section="related_bathmate">{%- assign fallback = 'lm_male_toys.related_bathmate_cta_label' | t -%}{{ section.settings.related_bathmate_cta_label | default: fallback | escape_once }}</a>
</section>{% endif %}
{% if section.settings.show_trust %}<section class="lm-male-toys-band lm-male-toys-panel">
<p class="lm-male-toys-eyebrow">{{ 'lm_male_toys.trust_eyebrow' | t | escape }}</p><h2 class="lm-male-toys-heading">{%- assign fallback = 'lm_male_toys.trust_heading' | t -%}{{ section.settings.trust_heading | default: fallback | escape }}</h2><div class="lm-male-toys-four-grid"><article class="lm-male-toys-info-card">{% render 'luv-male-toys-icon', icon: 'price' %}<h3>{{ 'lm_male_toys.trust_price_title' | t | escape }}</h3><p>{{ 'lm_male_toys.trust_price_body' | t | escape }}</p></article><article class="lm-male-toys-info-card">{% render 'luv-male-toys-icon', icon: 'box' %}<h3>{{ 'lm_male_toys.packaging' | t | escape }}</h3><p>{{ 'lm_male_toys.trust_packaging_body' | t | escape }}</p></article><article class="lm-male-toys-info-card">{% render 'luv-male-toys-icon', icon: 'lock' %}<h3>{{ 'lm_male_toys.payment' | t | escape }}</h3><p>{{ 'lm_male_toys.trust_payment_body' | t | escape }}</p></article><article class="lm-male-toys-info-card">{% render 'luv-male-toys-icon', icon: 'delivery' %}<h3>{{ 'lm_male_toys.delivery' | t | escape }}</h3><p>{{ 'lm_male_toys.trust_delivery_body' | t | escape }}</p></article></div></section>{% endif %}
{% if section.settings.show_faq and faq_blocks.size > 0 %}<section class="lm-male-toys-band lm-male-toys-faq">
<p class="lm-male-toys-eyebrow">{{ 'lm_male_toys.faq_eyebrow' | t | escape_once }}</p><h2 class="lm-male-toys-heading">{%- assign fallback = 'lm_male_toys.faq_heading' | t -%}{{ section.settings.faq_heading | default: fallback | escape }}</h2>{% for block in faq_blocks %}{% liquid
 assign question_key = 'lm_male_toys.faq_' | append: block.settings.topic | append: '_question'
 assign answer_key = 'lm_male_toys.faq_' | append: block.settings.topic | append: '_answer'
 assign default_question = question_key | t
%}<details class="lm-male-toys-details" {{ block.shopify_attributes }}><summary>{{ block.settings.question | default: default_question | escape }}<span class="lm-male-toys-plus" aria-hidden="true">+</span></summary><div class="lm-male-toys-answer">{% if block.settings.answer != blank %}{{ block.settings.answer }}{% else %}<p>{{ answer_key | t | escape }}</p>{% endif %}</div></details>{% endfor %}</section>{% endif %}
{% if section.settings.show_final %}<section class="lm-male-toys-band lm-male-toys-final lm-male-toys-panel">
<p class="lm-male-toys-eyebrow">{%- assign fallback = 'lm_male_toys.final_eyebrow' | t -%}{{ section.settings.final_eyebrow | default: fallback | escape }}</p><h2 class="lm-male-toys-heading">{%- assign fallback = 'lm_male_toys.final_heading' | t -%}{{ section.settings.final_heading | default: fallback | escape }}</h2><p class="lm-male-toys-intro">{%- assign fallback = 'lm_male_toys.final_body' | t -%}{{ section.settings.final_body | default: fallback | escape }}</p><div class="lm-male-toys-actions"><a class="lm-male-toys-button" href="{{ final_primary_url | escape }}" data-lm-event="final_cta_click" data-lm-section="final">{%- assign fallback = 'lm_male_toys.final_primary_label' | t -%}{{ section.settings.final_primary_label | default: fallback | escape }}</a><a class="lm-male-toys-button lm-male-toys-button--outline" href="{{ final_secondary_url | escape }}" data-lm-event="compare_click" data-lm-section="final">{%- assign fallback = 'lm_male_toys.secondary_label' | t -%}{{ section.settings.final_secondary_label | default: fallback | escape }}</a></div><ul class="lm-male-toys-trust-row" role="list"><li>{% render 'luv-male-toys-icon', icon: 'box' %}{{ 'lm_male_toys.packaging' | t | escape }}</li><li>{% render 'luv-male-toys-icon', icon: 'lock' %}{{ 'lm_male_toys.payment' | t | escape }}</li><li>{% render 'luv-male-toys-icon', icon: 'delivery' %}{{ 'lm_male_toys.delivery' | t | escape }}</li></ul></section>{% endif %}
</div></lm-male-toys-landing>
{% schema %}
{
  "name": "Male toys landing",
  "tag": "section",
  "class": "lm-male-toys-section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Blank copy uses EN/HR defaults. Select actual products and approved imagery. Enter only verified feature claims."
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero eyebrow",
      "info": "Leave blank for translated defaults. Translate custom text with Translate & Adapt."
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "info": "Leave blank for translated defaults. Translate custom text with Translate & Adapt."
