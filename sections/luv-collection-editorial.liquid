{%- assign featured_article = collection.metafields.custom.luv_featured_article.value -%}
{% render 'luv-collection-articles', section: section, featured_article: featured_article %}
{% schema %}
{
  "name": "Luv editorial guide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NOT SURE WHAT TO CHOOSE?"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "READ THE GUIDE"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.featured-blog.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "collection_introduction",
      "label": "t:luv_collection_articles.introduction"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": false,
      "label": "t:sections.featured-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "default": true,
      "label": "t:luv_collection_articles.show_excerpt"
    }
  ],
  "presets": [
    {
      "name": "Luv editorial guide"
    }
  ]
}
{% endschema %}
