{{ 'luv-collection-landing.css' | asset_url | stylesheet_tag }}
{% render 'luv-catalog', section: section, collection: collection %}

{% schema %}
{
  "name": "Luv collection products",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Products"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "Filters are configured in Shopify Search & Discovery."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "richtext",
      "id": "catalog_details",
      "label": "Additional collection information"
    }
  ],
  "presets": [
    {
      "name": "Luv collection products"
    }
  ],
  "blocks": [
    {
      "type": "collection_link",
      "name": "Collection shortcut",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
