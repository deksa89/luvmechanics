{%- liquid
  assign has_content = false
  if section.settings.content_heading != blank or section.settings.content_text != blank
    assign has_content = true
  endif
  for block in section.blocks
    if block.settings.text != blank or block.settings.title != blank
      assign has_content = true
    endif
  endfor
-%}
{%- if has_content -%}
{{ 'luv-category-info.css' | asset_url | stylesheet_tag }}
<section class="luv-category-info luv-design-scope" style="--info-top: {{ section.settings.padding_top }}px; --info-bottom: {{ section.settings.padding_bottom }}px; --info-top-mobile: {{ section.settings.padding_top_mobile }}px; --info-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;">
  <div class="luv-container">
    {% if section.settings.heading != blank or section.settings.heading_accent != blank %}
      <h2 class="luv-category-info__heading">{{ section.settings.heading }} {{ section.settings.heading_accent }}</h2>
    {% endif %}
    <details class="luv-category-info__details">
      <summary class="luv-category-info__trigger">
        <span>{{ section.settings.collapsed_label }}</span>
        <svg class="luv-category-info__chevron" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
      </summary>
      <div id="ExpandableContent-{{ section.id }}" class="luv-category-info__content rte">
          {% if section.settings.content_heading != blank %}
            <h3>{{ section.settings.content_heading }}</h3>
          {% endif %}

          {% if section.settings.content_text != blank %}
            {{ section.settings.content_text }}
          {% endif %}

          {% if section.blocks.size > 0 %}
            <div class="expandable-category-info__blocks">
              {% for block in section.blocks %}
                <div class="expandable-category-info__block" {{ block.shopify_attributes }}>
                  {% case block.type %}
                    {% when 'heading' %}
                      {% if block.settings.text != blank %}
                        <h3>{{ block.settings.text }}</h3>
                      {% endif %}

                    {% when 'text' %}
                      {% if block.settings.text != blank %}
                        <div class="rte">
                          {{ block.settings.text }}
                        </div>
                      {% endif %}

                    {% when 'list_item' %}
                      {% if block.settings.title != blank or block.settings.text != blank %}
                        <div class="expandable-category-info__list-item">
                          <p>
                            {% if block.settings.title != blank %}
                              <strong>{{ block.settings.title }}</strong>
                            {% endif %}
                            {% if block.settings.text != blank %}
                              {{ block.settings.text }}
                            {% endif %}
                          </p>
                        </div>
                      {% endif %}
                  {% endcase %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
      </div>
    </details>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Expandable category info",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading first part",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "Vibrators"
    },
    {
      "type": "text",
      "id": "collapsed_label",
      "label": "Collapsed label",
      "default": "Learn more about Vibrators"
    },
    {
      "type": "text",
      "id": "content_heading",
      "label": "Content heading",
      "default": "Your Vibe. Your Rules."
    },
    {
      "type": "richtext",
      "id": "content_text",
      "label": "Content text",
      "default": "<p>Finding the one just got a lot more fun. Use this section to explain your category and help customers understand the different options available.</p>"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Content width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Box background",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2f2927"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#cc3d5a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3a3432"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#3a3432"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d7d2ce"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading text",
          "default": "For Every Mood, Body, and Bedroom Vibe"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add more descriptive category content here.</p>"
        }
      ]
    },
    {
      "type": "list_item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Item title",
          "default": "Bullet Vibrators:"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Item text",
          "default": " Small but mighty, these pocket-sized powerhouses are perfect for targeted pleasure."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Expandable category info",
      "blocks": [
        {
          "type": "list_item"
        },
        {
          "type": "list_item"
        },
        {
          "type": "list_item"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}