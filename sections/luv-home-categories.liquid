{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'luv_home.categories.heading' | t
  endif

  assign support_text = section.settings.support_text
  if support_text == blank
    assign support_text = 'luv_home.categories.support' | t
  endif
%}

<section
  class="luv-design-scope luv-home-section luv-home-categories luv-section luv-section--compact luv-section--ivory"
  id="luv-home-categories"
  aria-labelledby="LuvHomeCategoriesHeading-{{ section.id }}"
>
  <div class="luv-container luv-home-section__inner">
    <div class="luv-container--reading luv-home-section__heading luv-home-section__heading--center">
      <h2 class="luv-section-heading" id="LuvHomeCategoriesHeading-{{ section.id }}">
        {{ heading | escape }}
      </h2>
      <p class="luv-small-text luv-text-muted luv-home-categories__support">{{ support_text | escape }}</p>
    </div>

    <ul class="luv-home-categories__grid" role="list">
      {% for block in section.blocks limit: 4 %}
        {% liquid
          assign title_key = 'luv_home.categories.cards.' | append: block.settings.content_key
          assign card_title = block.settings.title
          if card_title == blank
            assign card_title = title_key | t
          endif

          assign card_image = block.settings.image
          if card_image == blank and block.settings.image_source_product != blank
            assign card_image = block.settings.image_source_product.featured_image
          endif
          if card_image == blank and block.settings.allow_collection_image and block.settings.collection != blank
            assign card_image = block.settings.collection.featured_image
          endif

          assign card_link = block.settings.custom_link
          if card_link == blank and block.settings.collection != blank
            assign card_link = block.settings.collection.url
          endif

          assign card_alt = block.settings.image_alt
          if card_alt == blank and card_image.alt != blank
            assign card_alt = card_image.alt
          endif
          if card_alt == blank
            assign card_alt = card_title
          endif

          assign card_image_position = card_image.presentation.focal_point | default: 'center center'
          assign card_aria_label = 'luv_home.accessibility.browse_category' | t: title: card_title
          assign placeholder_name = 'collection-' | append: forloop.index
        %}

        <li class="luv-home-categories__item" {{ block.shopify_attributes }}>
          {% if card_link != blank %}
            <a class="luv-home-categories__card" href="{{ card_link }}" aria-label="{{ card_aria_label | escape }}">
          {% else %}
            <div class="luv-home-categories__card luv-home-categories__card--static">
          {% endif %}
              <div class="luv-home-categories__media" style="--luv-home-category-image-position: {{ card_image_position }};">
                {% if card_image != blank %}
                  {{
                    card_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'luv-home-categories__image',
                      widths: '240, 360, 480, 640, 800, 1000, 1200',
                      sizes: '(min-width: 1600px) 375px, (min-width: 990px) calc((100vw - 100px) / 4), (min-width: 750px) calc((100vw - 60px) / 2), calc((100vw - 52px) / 2)',
                      loading: 'lazy',
                      alt: card_alt
                  }}
                {% else %}
                  <div class="luv-home-categories__placeholder" role="img" aria-label="{{ card_alt | escape }}">
                    {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
              </div>
              <span class="luv-home-categories__label luv-card-heading">
                <span>{{ card_title | escape }}</span>
                {% if card_link != blank %}
                  <span class="luv-home-categories__arrow" aria-hidden="true">&#8594;</span>
                {% endif %}
              </span>
          {% if card_link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Luv home categories",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the translated default."
    },
    {
      "type": "textarea",
      "id": "support_text",
      "label": "Supporting text override",
      "info": "Leave blank to use the translated default."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "select",
          "id": "content_key",
          "label": "Translated default title",
          "options": [
            { "value": "women", "label": "For women" },
            { "value": "men", "label": "For men" },
            { "value": "couples", "label": "For couples" },
            { "value": "first_time", "label": "First-time buyer" }
          ],
          "default": "women"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override",
          "info": "Leave blank to use the translated default."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Optional link override",
          "info": "Overrides the selected collection link."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Highest-priority category image."
        },
        {
          "type": "product",
          "id": "image_source_product",
          "label": "Image-source product",
          "info": "Uses its featured image only. The card still links to the category."
        },
        {
          "type": "checkbox",
          "id": "allow_collection_image",
          "label": "Allow collection image fallback",
          "default": false
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luv home categories",
      "blocks": [
        { "type": "category", "settings": { "content_key": "women" } },
        { "type": "category", "settings": { "content_key": "men" } },
        { "type": "category", "settings": { "content_key": "couples" } },
        { "type": "category", "settings": { "content_key": "first_time" } }
      ]
    }
  ]
}
{% endschema %}
