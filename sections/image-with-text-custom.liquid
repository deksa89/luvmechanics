{% comment %}
  Image with text section
  - Desktop + mobile image upload
  - Text block below image
  - Responsive switching between images
{% endcomment %}

<section class="image-with-text-custom section-{{ section.id }}">
  <div class="image-with-text-wrapper">
    
    <div class="image-with-text-image">
      {% if section.settings.image_desktop or section.settings.image_mobile %}
        
        {%- comment -%}Desktop Image{%- endcomment -%}
        {% if section.settings.image_desktop %}
          <img 
            class="desktop-image"
            src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
            alt="{{ section.settings.image_desktop.alt | escape }}"
            loading="lazy"
          >
        {% endif %}

        {%- comment -%}Mobile Image{%- endcomment -%}
        {% if section.settings.image_mobile %}
          <img 
            class="mobile-image"
            src="{{ section.settings.image_mobile | image_url: width: 1000 }}"
            alt="{{ section.settings.image_mobile.alt | escape }}"
            loading="lazy"
          >
        {% endif %}

      {% else %}
        <div class="image-placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.heading != blank or section.settings.text != blank %}
      <div class="image-with-text-content" style="text-align: {{ section.settings.text_alignment }};">
        {% if section.settings.heading != blank %}
          <h2 class="image-with-text-heading" style="color: {{ section.settings.text_color }};">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="image-with-text-text" style="color: {{ section.settings.text_color }};">
            {{ section.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

<style>
.image-with-text-custom {
  width: 100%;
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.background_color }};
}

.image-with-text-wrapper {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 2.6rem;
}

/* Don't control display here, only width + border radius */
.image-with-text-image img {
  width: 100%;
  border-radius: {{ section.settings.image_border_radius }}px;
}

/* Explicitly control visibility with these two */
.desktop-image {
  display: block;
}

.mobile-image {
  display: none;
}

.image-placeholder {
  width: 100%;
  height: 350px;
  background: #eee;
  border-radius: {{ section.settings.image_border_radius }}px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-with-text-content {
  margin-top: {{ section.settings.spacing }}px;
}

.image-with-text-heading {
  font-size: {{ section.settings.heading_size }}px;
  margin-bottom: {{ section.settings.heading_spacing }}px;
}

.image-with-text-text {
  font-size: {{ section.settings.text_size }}px;
  line-height: 1.6;
}

/* Mobile styles */
@media (max-width: 749px) {
  .desktop-image {
    display: none;
  }

  .mobile-image {
    display: block;
  }

  .image-with-text-custom {
    padding-top: {{ section.settings.padding_top | times: 0.7 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 }}px;
  }

  .image-with-text-heading {
    font-size: {{ section.settings.heading_size | times: 0.8 }}px;
  }

  .image-with-text-text {
    font-size: {{ section.settings.text_size | times: 0.9 }}px;
  }
}
</style>


{% schema %}
{
  "name": "Image with text (custom)",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your description here.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Spacing under heading",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space between image and text",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Image with text (custom)"
    }
  ]
}
{% endschema %}
