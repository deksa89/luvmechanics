  @media (max-width: 749px) {
    .section-collection-list.palette-strong .collection-list.slider {
      display: grid !important;
      overflow: visible !important;
      scroll-snap-type: none !important;
    }

    .section-collection-list.palette-strong .collection-list.grid {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    .section-collection-list.palette-strong .collection-list > li,
    .section-collection-list.palette-strong .slider__slide {
      width: auto !important;
      max-width: none !important;
      flex: initial !important;
    }

    .section-collection-list.palette-strong .collection-list > li:first-child {
      grid-column: 1 / -1 !important;
    }

    .section-collection-list.palette-strong
    .collection-list > li:first-child .card__inner {
      aspect-ratio: 1.5 / 1;
      overflow: hidden;
    }
  }

