{%- liquid
  assign finder_title = collection.metafields.custom.luv_finder_title.value | default: 'Find the right product for you'
  assign finder_intro = collection.metafields.custom.luv_finder_intro.value
  assign finder_cards = collection.metafields.custom.luv_finder_cards.value
  assign valid_finder_card_count = 0
-%}

{%- capture finder_cards_markup -%}
  {%- for finder_card in finder_cards -%}
    {%- liquid
      assign card_title = finder_card.title.value
      assign card_text = finder_card.text.value
      assign card_link_label = finder_card.link_label.value
      assign card_link = finder_card.link.value
      assign card_icon_key = finder_card.icon_key.value | handleize

      if card_link != blank and card_link_label == blank
        assign card_link_label = 'Learn more'
      endif
    -%}

    {%- if finder_card != blank and card_title != blank or card_text != blank -%}
      {%- assign valid_finder_card_count = valid_finder_card_count | plus: 1 -%}

      {%- capture finder_icon -%}
        {%- case card_icon_key -%}
          {%- when 'premium' -%}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m12 3 1.45 4.55L18 9l-4.55 1.45L12 15l-1.45-4.55L6 9l4.55-1.45L12 3Z" />
              <path d="m18.5 15 .75 2.25L21.5 18l-2.25.75L18.5 21l-.75-2.25L15.5 18l2.25-.75L18.5 15Z" />
            </svg>
          {%- when 'size' -%}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 19 19 5" />
              <path d="m7.5 16.5 2 2M10.5 13.5l2 2M13.5 10.5l2 2M16.5 7.5l2 2" />
              <path d="M4.5 16.5 7.5 19.5 19.5 7.5 16.5 4.5 4.5 16.5Z" />
            </svg>
          {%- when 'help' -%}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="8.5" />
              <path d="M9.8 9.2a2.4 2.4 0 1 1 3.35 2.2c-.78.34-1.15.82-1.15 1.6v.35" />
              <path d="M12 17h.01" />
            </svg>
          {%- else -%}
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="8.5" />
              <path d="m14.8 9.2-1.65 3.95L9.2 14.8l1.65-3.95 3.95-1.65Z" />
            </svg>
        {%- endcase -%}
      {%- endcapture -%}

      <li class="luv-collection-finder__card">
        <span class="luv-collection-finder__icon" aria-hidden="true">
          {{- finder_icon -}}
        </span>
        <div class="luv-collection-finder__body">
          {%- if card_title != blank -%}
            <h3 class="luv-collection-finder__title">{{ card_title | strip_html | escape }}</h3>
          {%- endif -%}
          {%- if card_text != blank -%}
            <p class="luv-collection-finder__text">{{ card_text | strip_html | escape }}</p>
          {%- endif -%}
          {%- if card_link != blank -%}
            <a class="luv-collection-finder__link" href="{{ card_link | escape }}">
              {{- card_link_label | strip_html | escape -}}
              <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if valid_finder_card_count > 0 -%}
  <section
    class="luv-collection-finder"
    aria-labelledby="LuvCollectionFinderTitle-{{ section.id }}"
  >
    <div class="luv-collection-finder__inner">
      <header class="luv-collection-finder__header">
        <h2 class="luv-collection-finder__heading" id="LuvCollectionFinderTitle-{{ section.id }}">
          {{ finder_title | strip_html | escape }}
        </h2>
        {%- if finder_intro != blank -%}
          <p class="luv-collection-finder__intro">{{ finder_intro | strip_html | escape }}</p>
        {%- endif -%}
      </header>
      <ul class="luv-collection-finder__grid" role="list">
        {{ finder_cards_markup }}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Luv product finder",
  "settings": [],
  "presets": [
    {
      "name": "Luv product finder"
    }
  ]
}
{% endschema %}
