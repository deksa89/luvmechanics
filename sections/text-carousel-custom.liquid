{% comment %}
  Text Carousel (Custom)
  - Add unlimited text items via blocks
  - Carousel switches automatically every 5 seconds
  - Optional dot navigation
  - Optional heading above the carousel
{% endcomment %}

<section class="text-carousel-custom section-{{ section.id }}" style="
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.background_color }};
  text-align: {{ section.settings.text_alignment }};
">
  {% if section.settings.heading != blank %}
    <h2 class="text-carousel-heading" style="color: {{ section.settings.text_color }};">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <div class="text-carousel-wrapper">

    {% for block in section.blocks %}
      <div 
        class="text-carousel-item{% if forloop.first %} active{% endif %}" 
        data-index="{{ forloop.index0 }}"
        style="
          color: {{ section.settings.text_color }};
          font-size: {{ section.settings.font_size }}px;
        "
      >
        {{ block.settings.text }}
      </div>
    {% endfor %}

  </div>

  {% if section.settings.show_dots %}
    <div class="text-carousel-dots"></div>
  {% endif %}
</section>


<style>
.text-carousel-custom {
  position: relative;
  padding: 40px 10px;
  height: 84vw;
  max-width: 1440px;
}

.text-carousel-heading {
  margin: 0 0 16px;
  font-size: {{ section.settings.heading_size }}px;
}

.text-carousel-wrapper {
  margin: 0 auto;
  position: relative;
  display: block;
  align-items: center;
}

.text-carousel-item {
  position: absolute;
  opacity: 0;
  visibility: hidden;
  transition: opacity .6s ease;
  line-height: 1.6;
  padding: 0 10px;
}

.text-carousel-item.active {
  opacity: 1;
  visibility: visible;
}

.text-carousel-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 20px;
}

.text-carousel-dots button {
  width: 10px;
  height: 10px;
  background: {{ section.settings.dot_color }};
  border-radius: 50%;
  border: none;
  opacity: .3;
  cursor: pointer;
  transition: opacity .3s, transform .3s;
}

.text-carousel-dots button.active {
  opacity: 1;
  transform: scale(1.2);
}


/* Tablet styles */
@media (min-width: 425px) {
  .text-carousel-custom {
    position: relative;
    height: 40vw;
    margin: 0 auto;
    text-align: center;
  }
}

/* Desktop styles */
@media (min-width: 900px) {
  .text-carousel-item {
    font-size: {{ section.settings.font_size | times: 0.85 }}px;
  }

  .text-carousel-heading {
    font-size: {{ section.settings.heading_size | times: 0.9 }}px;
  }

  .text-carousel-custom {
    position: relative;
    height: 20vw;
    padding-top: {{ section.settings.padding_top | times: 0.7 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 }}px;
    padding-left: {{ section.settings.padding_horizontal | times: 0.7 }}px;
    padding-right: {{ section.settings.padding_horizontal | times: 0.7 }}px;
  }

  .text-carousel-wrapper {
    margin: 0 auto;
    position: relative;
    /* display: flex;
    justify-content: center; */
    /* align-items: center; */
  }
}

/* Large desktop */
@media (min-width: 1340px) {
  .text-carousel-custom {
    height: 15vw;
  }
}
</style>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const section = document.querySelector(".section-{{ section.id }}");
  if (!section) return;

  const items = section.querySelectorAll(".text-carousel-item");
  if (!items.length) return;

  const dotsContainer = section.querySelector(".text-carousel-dots");
  let dots = [];
  let current = 0;
  const intervalTime = 5000;

  // Create dots
  if (dotsContainer) {
    items.forEach((_, index) => {
      const btn = document.createElement("button");
      if (index === 0) btn.classList.add("active");
      btn.addEventListener("click", () => {
        goToSlide(index);
        resetAutoplay();
      });
      dotsContainer.appendChild(btn);
    });
    dots = dotsContainer.querySelectorAll("button");
  }

  function goToSlide(index) {
    items[current].classList.remove("active");
    if (dots.length) dots[current].classList.remove("active");

    current = index;

    items[current].classList.add("active");
    if (dots.length) dots[current].classList.add("active");
  }

  function nextSlide() {
    const next = (current + 1) % items.length;
    goToSlide(next);
  }

  let autoplay = setInterval(nextSlide, intervalTime);

  function resetAutoplay() {
    clearInterval(autoplay);
    autoplay = setInterval(nextSlide, intervalTime);
  }
});
</script>


{% schema %}
{
  "name": "Text carousel (custom)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Did you know?"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 48,
      "step": 2,
      "default": 24
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text font size",
      "min": 12,
      "max": 48,
      "step": 2,
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots navigation",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text item",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Description text",
          "default": "<p>Sample text carousel item</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text carousel (custom)",
      "category": "Text"
    }
  ]
}
{% endschema %}
