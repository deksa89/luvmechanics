{%- if section.settings.presentation_style == 'luv_home_recommendations' -%}
  {%- liquid
    assign ready_card_count = 0
    assign recommendations_heading = section.settings.home_heading | strip
    assign recommendations_support = section.settings.home_support_text | strip

    if recommendations_heading == blank
      assign recommendations_heading = 'luv_home.recommendations.heading' | t
    endif

    if recommendations_support == blank
      assign recommendations_support = 'luv_home.recommendations.support' | t
    endif

    for block in section.blocks
      assign card_product = block.settings.product
      assign card_image = block.settings.image
      assign card_title = block.settings.title | strip
      assign card_destination = block.settings.link

      if card_product != blank
        if card_image == blank
          assign card_image = card_product.featured_image
        endif
        if card_title == blank
          assign card_title = card_product.title | strip
        endif
        assign card_destination = card_product.url
      endif

      if card_image != blank and card_title != blank and card_destination != blank
        assign ready_card_count = ready_card_count | plus: 1
      endif
    endfor
  -%}

  {%- if ready_card_count > 0 or request.design_mode -%}
    <section
      class="luv-design-scope luv-home-recommendations"
      aria-labelledby="LuvHomeRecommendationsHeading-{{ section.id }}"
      style="
        --luv-home-recommendations-padding-top: {{ section.settings.padding_top }}px;
        --luv-home-recommendations-padding-bottom: {{ section.settings.padding_bottom }}px;
      "
    >
      <div class="luv-container">
        <header class="luv-home-recommendations__header">
          <h2 id="LuvHomeRecommendationsHeading-{{ section.id }}" class="luv-home-recommendations__heading">
            {{- recommendations_heading | escape -}}
          </h2>
          {%- if recommendations_support != blank -%}
            <p class="luv-home-recommendations__support">{{ recommendations_support | escape }}</p>
          {%- endif -%}
        </header>

        <div class="luv-home-recommendations__grid luv-home-recommendations__grid--count-{{ ready_card_count }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_product = block.settings.product
              assign card_image = block.settings.image
              assign card_title = block.settings.title | strip
              assign card_destination = block.settings.link
              assign card_is_product = false
              assign card_is_ready = false
              assign card_has_custom_image = false

              if block.settings.image != blank
                assign card_has_custom_image = true
              endif

              if card_product != blank
                assign card_is_product = true
                if card_image == blank
                  assign card_image = card_product.featured_image
                endif
                if card_title == blank
                  assign card_title = card_product.title | strip
                endif
                assign card_destination = card_product.url
              endif

              if card_image != blank and card_title != blank and card_destination != blank
                assign card_is_ready = true
              endif

              assign card_image_alt = card_image.alt | default: card_title
              assign card_image_position = card_image.presentation.focal_point | default: 'center center'
            -%}

            {%- if card_is_ready -%}
              <article class="luv-home-recommendations__card" {{ block.shopify_attributes }}>
                <a class="luv-home-recommendations__link" href="{{ card_destination }}">
                  <div
                    class="luv-home-recommendations__media{% if card_is_product and card_has_custom_image == false %} luv-home-recommendations__media--product{% endif %}"
                    style="--luv-home-recommendations-image-position: {{ card_image_position }};"
                  >
                    {{
                      card_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'luv-home-recommendations__image',
                        widths: '375, 550, 750, 900, 1100, 1200',
                        sizes: '(min-width: 1600px) 500px, (min-width: 990px) calc((100vw - 120px) / 3), (min-width: 750px) calc((100vw - 76px) / 2), calc(100vw - 40px)',
                        loading: 'lazy',
                        alt: card_image_alt
                    }}
                  </div>

                  <div class="luv-home-recommendations__content">
                    {%- if card_is_product and card_product.vendor != blank -%}
                      <p class="luv-home-recommendations__vendor">{{ card_product.vendor | escape }}</p>
                    {%- endif -%}

                    <h3 class="luv-home-recommendations__card-title">{{ card_title | escape }}</h3>

                    {%- if block.settings.description != blank -%}
                      <div class="luv-home-recommendations__description rte">{{ block.settings.description }}</div>
                    {%- endif -%}

                    {%- if card_is_product -%}
                      <p class="luv-home-recommendations__availability{% unless card_product.available %} is-sold-out{% endunless %}">
                        <span aria-hidden="true"></span>
                        {%- if card_product.available -%}
                          {{ 'luv_home.recommendations.available' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </p>
                      {% render 'price',
                        product: card_product,
                        show_badges: false,
                        price_class: 'luv-home-recommendations__price',
                        show_compare_at_price: true
                      %}
                    {%- endif -%}

                    <span class="luv-home-recommendations__cta">
                      {%- if card_is_product -%}
                        {{ 'luv_home.recommendations.view_product' | t }}
                      {%- else -%}
                        {{ 'luv_home.recommendations.explore' | t }}
                      {%- endif -%}
                      <span aria-hidden="true">&rarr;</span>
                    </span>
                  </div>
                </a>
              </article>
            {%- elsif request.design_mode -%}
              <article class="luv-home-recommendations__card luv-home-recommendations__card--editor" {{ block.shopify_attributes }}>
                <div class="luv-home-recommendations__editor-media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'luv-home-recommendations__image',
                        widths: '375, 550, 750, 900',
                        sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                        loading: 'lazy',
                        alt: card_image_alt
                    }}
                  {%- else -%}
                    {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="luv-home-recommendations__editor-content">
                  <h3 class="luv-home-recommendations__editor-title">
                    {{- 'luv_home.recommendations.editor.card_label' | t: index: forloop.index -}}
                  </h3>
                  <p>{{ 'luv_home.recommendations.editor.incomplete' | t }}</p>
                  <ul>
                    {%- if card_image == blank -%}
                      <li>{{ 'luv_home.recommendations.editor.missing_image' | t }}</li>
                    {%- endif -%}
                    {%- if card_title == blank -%}
                      <li>{{ 'luv_home.recommendations.editor.missing_title' | t }}</li>
                    {%- endif -%}
                    {%- if card_product == blank and block.settings.link == blank -%}
                      <li>{{ 'luv_home.recommendations.editor.missing_product' | t }}</li>
                      <li>{{ 'luv_home.recommendations.editor.missing_link' | t }}</li>
                    {%- elsif card_destination == blank -%}
                      <li>{{ 'luv_home.recommendations.editor.missing_link' | t }}</li>
                    {%- endif -%}
                  </ul>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- else -%}
{% comment %}
  Section: Featured Promo Trio
  File: sections/featured-promo-trio.liquid
{% endcomment %}

<section
  class="featured-promo-trio color-{{ section.settings.color_scheme }}"
  style="
    --fpt-section-bg: {{ section.settings.section_bg }};
    --fpt-eyebrow-color: {{ section.settings.eyebrow_color }};
    --fpt-heading-color: {{ section.settings.heading_color }};
    --fpt-card-bg: {{ section.settings.card_bg }};
    --fpt-title-color: {{ section.settings.title_color }};
    --fpt-description-color: {{ section.settings.description_color }};
    --fpt-button-color: {{ section.settings.button_color }};
    --fpt-dot-color: {{ section.settings.dot_color }};
    --fpt-dot-active-color: {{ section.settings.dot_active_color }};
  "
>
  <div class="featured-promo-trio__inner page-width">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="featured-promo-trio__heading-wrap">
        {% if section.settings.eyebrow != blank %}
          <p class="featured-promo-trio__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="featured-promo-trio__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="featured-promo-trio__desktop-tablet">
      <div class="featured-promo-trio__grid">
        {% for block in section.blocks %}
          <article class="featured-promo-trio__card" {{ block.shopify_attributes }}>
            <div class="featured-promo-trio__image-wrapper">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'featured-promo-trio__image',
                    alt: block.settings.title | escape
                }}
              {% else %}
                <div class="featured-promo-trio__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>

            <div class="featured-promo-trio__content">
              {% if block.settings.title != blank %}
                <h3 class="featured-promo-trio__title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="featured-promo-trio__description">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank and block.settings.link != blank %}
                <a class="featured-promo-trio__button" href="{{ block.settings.link }}">
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>

    <div class="featured-promo-trio__mobile">
      <div class="featured-promo-trio__viewport" id="FeaturedPromoViewport-{{ section.id }}">
        <div class="featured-promo-trio__track" id="FeaturedPromoTrack-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="featured-promo-trio__slide">
              <article class="featured-promo-trio__card" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a class="featured-promo-trio__link" href="{{ block.settings.link }}">
                {% endif %}

                <div class="featured-promo-trio__image-wrapper">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        class: 'featured-promo-trio__image',
                        alt: block.settings.title | escape
                    }}
                  {% else %}
                    <div class="featured-promo-trio__placeholder">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}
                </div>

                <div class="featured-promo-trio__content">
                  {% if block.settings.title != blank %}
                    <h3 class="featured-promo-trio__title">{{ block.settings.title }}</h3>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <div class="featured-promo-trio__description">
                      {{ block.settings.description }}
                    </div>
                  {% endif %}

                  {% if block.settings.button_label != blank and block.settings.link != blank %}
                    <span class="featured-promo-trio__button">
                      {{ block.settings.button_label }}
                    </span>
                  {% endif %}
                </div>

                {% if block.settings.link != blank %}
                  </a>
                {% endif %}
              </article>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="featured-promo-trio__mobile-controls">
          <button
            class="featured-promo-trio__arrow"
            id="FeaturedPromoPrev-{{ section.id }}"
            aria-label="Previous slide"
            type="button"
          >
            ‹
          </button>

          <div class="featured-promo-trio__dots" id="FeaturedPromoDots-{{ section.id }}">
            {% for block in section.blocks %}
              <button
                class="featured-promo-trio__dot{% if forloop.first %} is-active{% endif %}"
                type="button"
                data-index="{{ forloop.index0 }}"
                aria-label="Go to slide {{ forloop.index }}"
              ></button>
            {% endfor %}
          </div>

          <button
            class="featured-promo-trio__arrow"
            id="FeaturedPromoNext-{{ section.id }}"
            aria-label="Next slide"
            type="button"
          >
            ›
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .featured-promo-trio__heading-wrap {
    margin-bottom: 20px;
  }

  .featured-promo-trio__eyebrow {
    margin: 0 0 10px;
    font-size: 1.2rem;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fpt-eyebrow-color);
  }

  .featured-promo-trio__heading {
    margin: 0;
    font-size: 34px;
    line-height: 1.05;
    font-weight: 200;
    color: var(--fpt-heading-color);
  }

  @media screen and (max-width: 989px) {
    .featured-promo-trio__heading-wrap {
      margin-bottom: 22px;
    }

    .featured-promo-trio__heading {
      font-size: 3.8rem;
    }
  }

  @media screen and (max-width: 768px) {
    .featured-promo-trio__heading-wrap {
      padding-left: 1.5rem;
      margin-bottom: 18px;
    }

    .featured-promo-trio__eyebrow {
      font-size: 1rem;
    }

    .featured-promo-trio__heading {
      font-size: calc(34px * 0.7);
    }
  }

  .featured-promo-trio {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--fpt-section-bg);
  }

  .featured-promo-trio__desktop-tablet {
    display: block;
  }

  .featured-promo-trio__mobile {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .featured-promo-trio__desktop-tablet {
      display: none;
    }

    .featured-promo-trio__mobile {
      display: block;
    }
  }

  .featured-promo-trio__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
    align-items: stretch;
  }

  .featured-promo-trio__card {
    position: relative;
    overflow: hidden;
    background: var(--fpt-card-bg);
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .featured-promo-trio__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .featured-promo-trio__image-wrapper {
    position: relative;
    overflow: hidden;
    background: #111;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
  }

  .featured-promo-trio__image,
  .featured-promo-trio__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .featured-promo-trio__placeholder {
    width: 100%;
    height: 100%;
    background: #1a1a1a;
  }

  .featured-promo-trio__content {
    background: var(--fpt-card-bg);
    color: var(--fpt-title-color);
    padding: 2rem 2rem 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1 1 auto;
    min-height: 0;
  }

  .featured-promo-trio__description {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
    color: var(--fpt-description-color);
    flex-grow: 1;
  }

  .featured-promo-trio__title {
    margin: 0 0 23px;
    font-size: 1.9rem;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fpt-title-color);
  }

  .featured-promo-trio__description {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
    color: var(--fpt-description-color);
    flex: 1 1 auto;
  }

  .featured-promo-trio__description p {
    margin: 0;
  }

  .featured-promo-trio__button {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-height: 4.4rem;
    padding: 0 2.4rem;
    border: 1px solid #000;
    background: transparent;
    color: #000;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
  }

  .featured-promo-trio__button:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  .featured-promo-trio__card:hover .featured-promo-trio__image {
    transform: scale(1.03);
    transition: transform 0.45s ease;
  }

  .featured-promo-trio__image {
    transition: transform 0.45s ease;
  }

  .featured-promo-trio__viewport {
    overflow: hidden;
    position: relative;
    touch-action: pan-y;
    padding-bottom: 2rem;
  }

  .featured-promo-trio__track {
    display: flex;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .featured-promo-trio__slide {
    min-width: 100%;
    box-sizing: border-box;
  }

  .featured-promo-trio__mobile-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .featured-promo-trio__arrow {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,0.15);
    background: #fff;
    color: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    font-size: 22px;
    line-height: 1;
    transition: all 0.2s ease;

    display: none;
  }

  .featured-promo-trio__arrow:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  .featured-promo-trio__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .featured-promo-trio__dot {
    width: 8px;
    height: 8px;
    border: none;
    border-radius: 999px;
    background: var(--fpt-dot-color);
    opacity: 0.3;
    cursor: pointer;
    padding: 0;
    transition: all 0.25s ease;
  }

  .featured-promo-trio__dot.is-active {
    width: 24px;
    opacity: 1;
    background-color: var(--fpt-dot-active-color);
  }

  @media screen and (max-width: 989px) and (min-width: 426px) {
    .featured-promo-trio__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .featured-promo-trio__title {
      font-size: 1.6rem;
    }

    .featured-promo-trio__description {
      font-size: 1.3rem;
    }
  }

  @media screen and (max-width: 768px) {
    .featured-promo-trio__inner {
      padding-left: 0;
      padding-right: 0;
    }

    .featured-promo-trio__desktop-tablet {
      display: none;
    }

    .featured-promo-trio__mobile {
      display: block;
    }

    .featured-promo-trio__card {
      min-height: unset;
    }

    .featured-promo-trio__image-wrapper {
      height: auto;
    }

    .featured-promo-trio__content {
      height: auto;
      padding: 2rem 2rem 0rem 1rem;
    }

    .featured-promo-trio__title {
      font-size: 1.8rem;
      margin-bottom: 10px;
    }

    .featured-promo-trio__description {
      font-size: 1.25rem;
      line-height: 1.45;
    }

    .featured-promo-trio__button {
      margin-top: 12px;
      font-size: 1.1rem;
    }
  }
</style>

<script>
  (function() {
    const viewport = document.getElementById('FeaturedPromoViewport-{{ section.id }}');
    const track = document.getElementById('FeaturedPromoTrack-{{ section.id }}');
    const prevBtn = document.getElementById('FeaturedPromoPrev-{{ section.id }}');
    const nextBtn = document.getElementById('FeaturedPromoNext-{{ section.id }}');
    const dotsWrap = document.getElementById('FeaturedPromoDots-{{ section.id }}');

    if (!viewport || !track) return;

    const slides = Array.from(track.children);
    const totalSlides = slides.length;

    if (totalSlides <= 1) return;

    let currentIndex = 0;
    let startX = 0;
    let currentX = 0;
    let isDragging = false;

    const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll('.featured-promo-trio__dot')) : [];

    function updateCarousel() {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === currentIndex);
      });
    }

    function goToSlide(index) {
      if (index < 0) {
        currentIndex = totalSlides - 1;
      } else if (index >= totalSlides) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      updateCarousel();
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', nextSlide);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', prevSlide);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', function() {
        const index = Number(this.dataset.index);
        goToSlide(index);
      });
    });

    viewport.addEventListener('touchstart', function(e) {
      if (!e.touches.length) return;
      startX = e.touches[0].clientX;
      currentX = startX;
      isDragging = true;
    }, { passive: true });

    viewport.addEventListener('touchmove', function(e) {
      if (!isDragging || !e.touches.length) return;
      currentX = e.touches[0].clientX;
    }, { passive: true });

    viewport.addEventListener('touchend', function() {
      if (!isDragging) return;

      const diff = currentX - startX;
      const threshold = 50;

      if (Math.abs(diff) > threshold) {
        if (diff < 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }

      isDragging = false;
      startX = 0;
      currentX = 0;
    }, { passive: true });
  })();
</script>

{%- endif -%}

{% schema %}
{
  "name": "Featured promo trio",
  "tag": "section",
  "class": "section section-featured-promo-trio",
  "settings": [
    {
      "type": "select",
      "id": "presentation_style",
      "label": "Presentation style",
      "options": [
        {
          "value": "legacy",
          "label": "Legacy"
        },
        {
          "value": "luv_home_recommendations",
          "label": "LuvMechanics home recommendations"
