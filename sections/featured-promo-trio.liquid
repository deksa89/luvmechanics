{% comment %}
  Section: Featured Promo Trio
  File: sections/featured-promo-trio.liquid
{% endcomment %}

<section class="featured-promo-trio color-{{ section.settings.color_scheme }}">
  <div class="featured-promo-trio__inner page-width">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="featured-promo-trio__heading-wrap">
        {% if section.settings.eyebrow != blank %}
          <p class="featured-promo-trio__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="featured-promo-trio__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="featured-promo-trio__desktop-tablet">
      <div class="featured-promo-trio__grid">
        {% for block in section.blocks %}
          <article class="featured-promo-trio__card" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a class="featured-promo-trio__link" href="{{ block.settings.link }}">
            {% endif %}

            <div class="featured-promo-trio__image-wrapper">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'featured-promo-trio__image',
                    alt: block.settings.title | escape
                }}
              {% else %}
                <div class="featured-promo-trio__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>

            <div class="featured-promo-trio__content">
              {% if block.settings.title != blank %}
                <h3 class="featured-promo-trio__title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="featured-promo-trio__description">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank and block.settings.link != blank %}
                <span class="featured-promo-trio__button">
                  {{ block.settings.button_label }}
                </span>
              {% endif %}
            </div>

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>

    <div class="featured-promo-trio__mobile">
      <div class="featured-promo-trio__viewport" id="FeaturedPromoViewport-{{ section.id }}">
        <div class="featured-promo-trio__track" id="FeaturedPromoTrack-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="featured-promo-trio__slide">
              <article class="featured-promo-trio__card" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a class="featured-promo-trio__link" href="{{ block.settings.link }}">
                {% endif %}

                <div class="featured-promo-trio__image-wrapper">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        class: 'featured-promo-trio__image',
                        alt: block.settings.title | escape
                    }}
                  {% else %}
                    <div class="featured-promo-trio__placeholder">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}
                </div>

                <div class="featured-promo-trio__content">
                  {% if block.settings.title != blank %}
                    <h3 class="featured-promo-trio__title">{{ block.settings.title }}</h3>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <div class="featured-promo-trio__description">
                      {{ block.settings.description }}
                    </div>
                  {% endif %}

                  {% if block.settings.button_label != blank and block.settings.link != blank %}
                    <span class="featured-promo-trio__button">
                      {{ block.settings.button_label }}
                    </span>
                  {% endif %}
                </div>

                {% if block.settings.link != blank %}
                  </a>
                {% endif %}
              </article>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="featured-promo-trio__mobile-controls">
          <button
            class="featured-promo-trio__arrow"
            id="FeaturedPromoPrev-{{ section.id }}"
            aria-label="Previous slide"
            type="button"
          >
            ‹
          </button>

          <div class="featured-promo-trio__dots" id="FeaturedPromoDots-{{ section.id }}">
            {% for block in section.blocks %}
              <button
                class="featured-promo-trio__dot{% if forloop.first %} is-active{% endif %}"
                type="button"
                data-index="{{ forloop.index0 }}"
                aria-label="Go to slide {{ forloop.index }}"
              ></button>
            {% endfor %}
          </div>

          <button
            class="featured-promo-trio__arrow"
            id="FeaturedPromoNext-{{ section.id }}"
            aria-label="Next slide"
            type="button"
          >
            ›
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .featured-promo-trio__heading-wrap {
    margin-bottom: 28px;
  }

  .featured-promo-trio__eyebrow {
    margin: 0 0 10px;
    font-size: 1.2rem;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
  }

  .featured-promo-trio__heading {
    margin: 0;
    font-size: 34px;
    line-height: 1.05;
    font-weight: 200;
    color: #111;
  }

  @media screen and (max-width: 989px) {
    .featured-promo-trio__heading-wrap {
      margin-bottom: 22px;
    }

    .featured-promo-trio__heading {
      font-size: 3.8rem;
    }
  }

  @media screen and (max-width: 425px) {
    .featured-promo-trio__heading-wrap {
      padding-left: 16px;
      padding-right: 16px;
      margin-bottom: 18px;
    }

    .featured-promo-trio__eyebrow {
      font-size: 1rem;
    }

    .featured-promo-trio__heading {
      font-size: 2.5rem;
    }
  }

  .featured-promo-trio {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .featured-promo-trio__desktop-tablet {
    display: block;
  }

  .featured-promo-trio__mobile {
    display: none;
  }

  .featured-promo-trio__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
  }

  .featured-promo-trio__card {
    position: relative;
    overflow: hidden;
    background: #000;
    min-height: 560px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .featured-promo-trio__link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .featured-promo-trio__image-wrapper {
    position: relative;
    height: 72%;
    overflow: hidden;
    background: #111;
  }

  .featured-promo-trio__image,
  .featured-promo-trio__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .featured-promo-trio__placeholder {
    width: 100%;
    height: 100%;
    background: #1a1a1a;
  }

  .featured-promo-trio__content {
    height: 28%;
    background: #000;
    color: #fff;
    padding: 24px 20px 22px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .featured-promo-trio__title {
    margin: 0 0 12px;
    font-size: 1.9rem;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }

  .featured-promo-trio__description {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.85);
  }

  .featured-promo-trio__description p {
    margin: 0;
  }

  .featured-promo-trio__button {
    margin-top: 16px;
    display: inline-block;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.92);
  }

  .featured-promo-trio__card:hover .featured-promo-trio__image {
    transform: scale(1.03);
    transition: transform 0.45s ease;
  }

  .featured-promo-trio__image {
    transition: transform 0.45s ease;
  }

  .featured-promo-trio__viewport {
    overflow: hidden;
    position: relative;
    touch-action: pan-y;
  }

  .featured-promo-trio__track {
    display: flex;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .featured-promo-trio__slide {
    min-width: 100%;
    box-sizing: border-box;
  }

  .featured-promo-trio__mobile-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 14px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .featured-promo-trio__arrow {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,0.15);
    background: #fff;
    color: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    font-size: 22px;
    line-height: 1;
    transition: all 0.2s ease;

    display: none;
  }

  .featured-promo-trio__arrow:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  .featured-promo-trio__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .featured-promo-trio__dot {
    width: 8px;
    height: 8px;
    border: none;
    border-radius: 999px;
    background: #111;
    opacity: 0.3;
    cursor: pointer;
    padding: 0;
    transition: all 0.25s ease;
  }

  .featured-promo-trio__dot.is-active {
    width: 24px;
    opacity: 1;
    background-color: #f98585;
  }

  @media screen and (max-width: 989px) and (min-width: 426px) {
    .featured-promo-trio__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .featured-promo-trio__card {
      min-height: 480px;
    }

    .featured-promo-trio__image-wrapper {
      height: 68%;
    }

    .featured-promo-trio__content {
      height: 32%;
    }

    .featured-promo-trio__title {
      font-size: 1.6rem;
    }

    .featured-promo-trio__description {
      font-size: 1.3rem;
    }
  }

  @media screen and (max-width: 425px) {
    .featured-promo-trio__inner {
      padding-left: 0;
      padding-right: 0;
    }

    .featured-promo-trio__desktop-tablet {
      display: none;
    }

    .featured-promo-trio__mobile {
      display: block;
    }

    .featured-promo-trio__card {
      min-height: 530px;
    }

    .featured-promo-trio__image-wrapper {
      height: 68%;
    }

    .featured-promo-trio__content {
      height: 32%;
      padding: 20px 16px 18px;
    }

    .featured-promo-trio__title {
      font-size: 1.5rem;
      margin-bottom: 10px;
    }

    .featured-promo-trio__description {
      font-size: 1.25rem;
      line-height: 1.45;
    }

    .featured-promo-trio__button {
      margin-top: 12px;
      font-size: 1.1rem;
    }
  }
</style>

<script>
  (function() {
    const viewport = document.getElementById('FeaturedPromoViewport-{{ section.id }}');
    const track = document.getElementById('FeaturedPromoTrack-{{ section.id }}');
    const prevBtn = document.getElementById('FeaturedPromoPrev-{{ section.id }}');
    const nextBtn = document.getElementById('FeaturedPromoNext-{{ section.id }}');
    const dotsWrap = document.getElementById('FeaturedPromoDots-{{ section.id }}');

    if (!viewport || !track) return;

    const slides = Array.from(track.children);
    const totalSlides = slides.length;

    if (totalSlides <= 1) return;

    let currentIndex = 0;
    let startX = 0;
    let currentX = 0;
    let isDragging = false;

    const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll('.featured-promo-trio__dot')) : [];

    function updateCarousel() {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === currentIndex);
      });
    }

    function goToSlide(index) {
      if (index < 0) {
        currentIndex = totalSlides - 1;
      } else if (index >= totalSlides) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      updateCarousel();
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', nextSlide);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', prevSlide);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', function() {
        const index = Number(this.dataset.index);
        goToSlide(index);
      });
    });

    viewport.addEventListener('touchstart', function(e) {
      if (!e.touches.length) return;
      startX = e.touches[0].clientX;
      currentX = startX;
      isDragging = true;
    }, { passive: true });

    viewport.addEventListener('touchmove', function(e) {
      if (!isDragging || !e.touches.length) return;
      currentX = e.touches[0].clientX;
    }, { passive: true });

    viewport.addEventListener('touchend', function() {
      if (!isDragging) return;

      const diff = currentX - startX;
      const threshold = 50;

      if (Math.abs(diff) > threshold) {
        if (diff < 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }

      isDragging = false;
      startX = 0;
      currentX = 0;
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Featured promo trio",
  "tag": "section",
  "class": "section section-featured-promo-trio",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured bundles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top bundle offers"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "promo_card",
      "name": "Promo card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "NEW COLLECTION"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Short description",
          "default": "<p>Add a short editorial-style description here.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Featured promo trio",
      "blocks": [
        {
          "type": "promo_card"
        },
        {
          "type": "promo_card"
        },
        {
          "type": "promo_card"
        }
      ]
    }
  ]
}
{% endschema %}