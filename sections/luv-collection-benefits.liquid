{%- liquid
  assign benefits_heading = section.settings.heading | default: 'Why shop at LuvMechanics?'
-%}

<section
  class="luv-collection-benefits"
  aria-labelledby="LuvCollectionBenefitsTitle-{{ section.id }}"
>
  <div class="luv-collection-benefits__inner">
    {%- if benefits_heading != blank -%}
      <h2 class="luv-collection-benefits__heading" id="LuvCollectionBenefitsTitle-{{ section.id }}">
        {{ benefits_heading | escape }}
      </h2>
    {%- endif -%}

    <ul class="luv-collection-benefits__grid" role="list">
      {%- for index in (1..4) -%}
        {%- liquid
          assign icon_setting = 'benefit_' | append: index | append: '_icon'
          assign title_setting = 'benefit_' | append: index | append: '_title'
          assign text_setting = 'benefit_' | append: index | append: '_text'
          assign icon_key = section.settings[icon_setting]
          assign benefit_title = section.settings[title_setting]
          assign benefit_text = section.settings[text_setting]
        -%}

        {%- if benefit_title != blank or benefit_text != blank -%}
          <li class="luv-collection-benefits__item">
            {%- unless icon_key == 'none' -%}
              <span class="luv-collection-benefits__icon" aria-hidden="true">
                {%- case icon_key -%}
                  {%- when 'guidance' -%}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <circle cx="12" cy="8" r="3" />
                      <path d="M6.5 19a5.5 5.5 0 0 1 11 0" />
                      <path d="M4 10.5V8a8 8 0 0 1 16 0v2.5M4 10.5h2.5v4H5a1 1 0 0 1-1-1v-3ZM20 10.5h-2.5v4H19a1 1 0 0 0 1-1v-3Z" />
                    </svg>
                  {%- when 'delivery' -%}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="m4 7 8-4 8 4-8 4-8-4Z" />
                      <path d="M4 7v10l8 4 8-4V7M12 11v10" />
                    </svg>
                  {%- when 'secure' -%}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <rect x="5" y="10" width="14" height="10" rx="2" />
                      <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2" />
                    </svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <circle cx="12" cy="12" r="8.5" />
                      <circle cx="12" cy="12" r="3.25" />
                      <path d="m6 6 3.7 3.7M14.3 14.3 18 18M18 6l-3.7 3.7M9.7 14.3 6 18" />
                    </svg>
                {%- endcase -%}
              </span>
            {%- endunless -%}

            {%- if benefit_title != blank -%}
              <h3 class="luv-collection-benefits__title">{{ benefit_title | escape }}</h3>
            {%- endif -%}
            {%- if benefit_text != blank -%}
              <p class="luv-collection-benefits__text">{{ benefit_text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

