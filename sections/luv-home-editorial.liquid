{%- liquid
  assign editorial_blog = section.settings.blog
  assign visible_article_count = 0
  assign editorial_is_ready = false

  if editorial_blog != blank and editorial_blog.articles_count > 0
    assign visible_article_count = editorial_blog.articles_count | at_most: section.settings.articles_to_show
    if visible_article_count > 0
      assign editorial_is_ready = true
    endif
  endif

  assign editorial_eyebrow = section.settings.eyebrow | strip
  assign editorial_heading = section.settings.heading | strip
  assign editorial_support = section.settings.support_text | strip
  assign editorial_cta_label = section.settings.cta_label | strip

  if editorial_eyebrow == blank
    assign editorial_eyebrow = 'luv_home.editorial.eyebrow' | t
  endif
  if editorial_heading == blank
    assign editorial_heading = 'luv_home.editorial.heading' | t
  endif
  if editorial_support == blank
    assign editorial_support = 'luv_home.editorial.support' | t
  endif
  if editorial_cta_label == blank
    assign editorial_cta_label = 'luv_home.editorial.cta' | t
  endif
-%}

{%- if editorial_is_ready or request.design_mode -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-article-card.css' | asset_url | stylesheet_tag }}

  <section
    id="luv-home-editorial"
    class="luv-design-scope luv-home-editorial"
    {% if editorial_is_ready %}aria-labelledby="LuvHomeEditorialHeading-{{ section.id }}"{% endif %}
    style="
      --luv-home-editorial-padding-desktop: {{ section.settings.padding_desktop }}px;
      --luv-home-editorial-padding-mobile: {{ section.settings.padding_mobile }}px;
    "
  >
    <div class="luv-container">
      {%- if editorial_is_ready -%}
        <header class="luv-home-editorial__header">
          <div class="luv-home-editorial__intro">
            {%- if editorial_eyebrow != blank -%}
              <p class="luv-home-editorial__eyebrow luv-eyebrow">{{ editorial_eyebrow | escape_once }}</p>
            {%- endif -%}
            <h2 id="LuvHomeEditorialHeading-{{ section.id }}" class="luv-home-editorial__heading luv-section-heading">
              {{- editorial_heading | escape_once -}}
            </h2>
            {%- if editorial_support != blank -%}
              <p class="luv-home-editorial__support luv-body-copy luv-text-muted">{{ editorial_support | escape_once }}</p>
            {%- endif -%}
          </div>

          {%- if editorial_blog.url != blank -%}
            <a class="luv-home-editorial__cta" href="{{ editorial_blog.url }}">
              <span>{{ editorial_cta_label | escape_once }}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </header>

        <ul
          class="luv-home-editorial__grid luv-home-editorial__grid--count-{{ visible_article_count }}"
          role="list"
        >
          {%- for article in editorial_blog.articles limit: section.settings.articles_to_show -%}
            <li class="luv-home-editorial__item">
              <article class="luv-home-editorial__card-shell">
                {% render 'article-card',
                  blog: editorial_blog,
                  article: article,
                  media_aspect_ratio: 1.5,
                  show_image: true,
                  show_date: section.settings.show_date,
                  show_author: section.settings.show_author,
                  show_excerpt: section.settings.show_excerpt,
                  show_badge: false,
                  lazy_load: true
                %}
                <span class="luv-home-editorial__read" aria-hidden="true">
                  {{- 'luv_home.editorial.read_article' | t -}}
                </span>
              </article>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="luv-home-editorial__editor-diagnostic" role="status">
          {%- if editorial_blog == blank -%}
            {{- 'luv_home.editorial.editor.no_blog' | t -}}
          {%- else -%}
            {{- 'luv_home.editorial.editor.no_articles' | t -}}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Luv home editorial",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Articles to show",
      "default": 3
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow override"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "textarea",
      "id": "support_text",
      "label": "Supporting text override"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label override"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publication date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop vertical padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Mobile vertical padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Luv home editorial"
    }
  ]
}
{% endschema %}
