{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | times: 0.75 | round: 0 }}px;
  }

  .carousel-wrapper {
    position: relative;
    width: 100%;
    height: 100% !important;
    overflow: hidden;
  }

/* stack all slides in same grid cell */
.carousel-wrapper img {
  grid-area: 1 / 1;
  position: relative !important; /* IMPORTANT: not absolute */
  width: 100%;
  height: auto !important;       /* IMPORTANT */
  object-fit: contain !important; /* IMPORTANT: no crop */
  object-position: center;
  opacity: 0;
  transition: opacity .7s ease-in-out;
}

/* link overlay stays absolute */
.carousel-wrapper a {
  position: absolute;
  inset: 0;
  display: block;
  z-index: 3;
}


/* active slide */
.carousel-wrapper img.active {
  opacity: 1;
}

  .carousel-controls {
    position: absolute;
    top: 50% !important;
    width: 100%;
    display: flex !important;
    justify-content: space-between;
    transform: translateY(-50%);
    pointer-events: none;
    height: 16% !important;
    opacity: 0.1;
    z-index: 4;
  }

  .carousel-controls button {
    pointer-events: all;
    background: rgba(0,0,0,0.4);
    border: none;
    color: white;
    font-size: 28px;
    padding: 8px 14px;
    cursor: pointer;
    border-radius: 4px;
  }

  .carousel-dots {
    position: absolute;
    top: 12px !important;
    left: 50% !important;
    transform: translateX(-50%);
    display: flex !important;
    gap: 8px;
    margin: 0;
    z-index: 2;
    width: 168px !important;
  }

  .carousel-dot {
    width: 100px;
    height: 12px;
    border-radius: 0;
    border: none;
    background: #ccc;
    cursor: pointer;
  }

  .carousel-dot.active {
    background: #000;
  }

/*  */
.carousel-wrapper {
  position: relative;
  width: 100%;
  height: auto !important;   /* IMPORTANT: no fixed height */
  display: grid;             /* lets slides stack without absolute positioning */
  overflow: hidden;          /* keep rounded corners clean */
}

.carousel-link {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  display: none;
}
/*  */

  .desktop-slide { display: none; }
  .mobile-slide { display: none; }

  @media (min-width: 769px) {
    .desktop-slide { 
      display: block; 
    }
  }

  @media screen and (max-width: 768px) {
    .carousel-dots {
      display: none !important;
    }

    .mobile-slide { 
      display: block; 
    }

    .section-{{ section.id }}-padding > .page-width {
      max-width: 100%;
      padding-left: 0;
      padding-right: 0;
    }

    .section-{{ section.id }}-padding {
      padding-top: 0px;
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div class="image-with-text__media image-with-text__media--desktop-{{ section.settings.height_desktop }} image-with-text__media--mobile-{{ section.settings.height_mobile }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.carousel_images == blank %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.carousel_images != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.carousel_images.aspect_ratio | times: 100 }}%;"
            {% endif %}>

            <div class="carousel-wrapper" id="carousel-{{ section.id }}">
              {% for block in section.blocks %}

                {% if block.type == 'carousel_image_desktop' and block.settings.image != blank %}
                  <a href="{{ block.settings.link }}" class="carousel-link desktop-link" data-index="{{ forloop.index0 }}"></a>
                  <img
                    src="{{ block.settings.image | image_url: width: 1600 }}"
                    class="carousel-slide desktop-slide"
                    alt="Desktop slide {{ forloop.index }}"
                  >
                {% endif %}

                {% if block.type == 'carousel_image_mobile' and block.settings.image != blank %}
                  <a href="{{ block.settings.link }}" class="carousel-link mobile-link" data-index="{{ forloop.index0 }}"></a>
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    class="carousel-slide mobile-slide"
                    alt="Mobile slide {{ forloop.index }}"
                  >
                {% endif %}

              {% endfor %}
            </div>


            <div class="carousel-controls">
              <button class="carousel-prev" aria-label="Previous slide">‹</button>
              <button class="carousel-next" aria-label="Next slide">›</button>
            </div>

            <div class="carousel-dots" id="carousel-dots-{{ section.id }}">
              {% assign total_desktop = 0 %}

              {% for block in section.blocks %}
                {% if block.type == 'carousel_image_desktop' and block.settings.image != blank %}
                  {% assign total_desktop = total_desktop | plus: 1 %}
                {% endif %}
              {% endfor %}

              {% for i in (1..total_desktop) %}
                <button class="carousel-dot" data-index="{{ forloop.index0 }}"></button>
              {% endfor %}
            </div>

          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  <h2
                    class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                  <p class="image-with-text__paragraph">Self care for those women who know who they are and what they want</p>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="small-three-images-wrapper">
        <div class="extra-image-wrapper">
          {% if section.settings.extra_image_1 != blank %}
            <img
              src="{{ section.settings.extra_image_1 | image_url: width: 800 }}"
              srcset="
                {{ section.settings.extra_image_1 | image_url: width: 400 }} 400w,
                {{ section.settings.extra_image_1 | image_url: width: 800 }} 800w,
                {{ section.settings.extra_image_1 | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) 50vw, 100vw"
              alt="{{ section.settings.extra_image_alt | escape }}"
              loading="lazy"
              class="extra-image"
            />           
          {% endif %}    
        </div>
  
        <div class="extra-image-wrapper">
          {% if section.settings.extra_image_2 != blank %}
            <img
              src="{{ section.settings.extra_image_2 | image_url: width: 800 }}"
              srcset="
                {{ section.settings.extra_image_2 | image_url: width: 400 }} 400w,
                {{ section.settings.extra_image_2 | image_url: width: 800 }} 800w,
                {{ section.settings.extra_image_2 | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) 50vw, 100vw"
              alt="{{ section.settings.extra_image_alt | escape }}"
              loading="lazy"
              class="extra-image"
            />
          {% endif %}
        </div>
  
        <div class="extra-image-wrapper">
          {% if section.settings.extra_image_3 != blank %}
            <img
              src="{{ section.settings.extra_image_3 | image_url: width: 800 }}"
              srcset="
                {{ section.settings.extra_image_3 | image_url: width: 400 }} 400w,
                {{ section.settings.extra_image_3 | image_url: width: 800 }} 800w,
                {{ section.settings.extra_image_3 | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) 50vw, 100vw"
              alt="{{ section.settings.extra_image_alt | escape }}"
              loading="lazy"
              class="extra-image"
            />
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const carousel = document.querySelector("#carousel-{{ section.id }}");
    if (!carousel) return;

    function getSlides() {
      if (window.innerWidth <= 768) {
        return carousel.querySelectorAll(".carousel-slide.mobile-slide");
      } else {
        return carousel.querySelectorAll(".carousel-slide.desktop-slide");
      }
    }

    let slides = getSlides();
    window.addEventListener("resize", () => {
      const oldLength = slides.length;
      slides = getSlides();

      if (slides.length !== oldLength) {
        index = 0;
        showSlide(0);
      }
    });

    const dots    = document.querySelectorAll("#carousel-dots-{{ section.id }} .carousel-dot");
    const prevBtn = document.querySelector(".carousel-prev");
    const nextBtn = document.querySelector(".carousel-next");

    if (!slides.length) return;

    let index    = 0;
    let interval = null;
    let startX   = 0;
    let isTouching = false;

    const links = carousel.querySelectorAll(".carousel-link");

    function updateLinks() {
      links.forEach(link => (link.style.display = "none"));

      if (window.innerWidth <= 768) {
        const mobileLinks = carousel.querySelectorAll(".mobile-link");
        if (mobileLinks[index]) mobileLinks[index].style.display = "block";
      } else {
        const desktopLinks = carousel.querySelectorAll(".desktop-link");
        if (desktopLinks[index]) desktopLinks[index].style.display = "block";
      }
    }

    function updateHeight() {
      const active = slides[index];
      if (active) carousel.style.height = active.offsetHeight + "px";
    }

    function showSlide(newIndex) {
      slides[index].classList.remove("active");
      dots[index]?.classList.remove("active");

      index = newIndex;

      slides[index].classList.add("active");
      dots[index]?.classList.add("active");

      updateHeight();
      updateLinks();   // 👈 keep links in sync with active slide
    }

    function nextSlide() {
      showSlide((index + 1) % slides.length);
    }

    function prevSlide() {
      showSlide((index - 1 + slides.length) % slides.length);
    }

    function startAutoRotate() {
      interval = setInterval(nextSlide, 5000);
    }

    function restartAutoRotate() {
      clearInterval(interval);
      startAutoRotate();
    }

    // Init
    slides[0].classList.add("active");
    dots[0]?.classList.add("active");
    updateHeight();
    slides.forEach(img => img.addEventListener("load", updateHeight));
    startAutoRotate();
    updateLinks(); // 👈 show correct link for first slide

    // Manual controls
    nextBtn?.addEventListener("click", () => {
      nextSlide();
      restartAutoRotate();
    });

    prevBtn?.addEventListener("click", () => {
      prevSlide();
      restartAutoRotate();
    });

    dots.forEach(dot => {
      dot.addEventListener("click", () => {
        const target = parseInt(dot.dataset.index);
        showSlide(target);
        restartAutoRotate();
      });
    });

    carousel.addEventListener(
      "touchstart",
      function (e) {
        if (!e.touches || !e.touches.length) return;
        startX = e.touches[0].clientX;
        isTouching = true;
      },
      { passive: true }
    );

    carousel.addEventListener(
      "touchend",
      function (e) {
        if (!isTouching || !e.changedTouches || !e.changedTouches.length) return;
        const endX = e.changedTouches[0].clientX;
        const diffX = endX - startX;
        const threshold = 50; // px swipe distance

        if (Math.abs(diffX) > threshold) {
          if (diffX < 0) {
            nextSlide();
          } else {
            prevSlide();
          }
          restartAutoRotate();
        }
        isTouching = false;
      },
      { passive: true }
    );
  });

</script>


