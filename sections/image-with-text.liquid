{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | times: 0.75 | round: 0 }}px;
  }

  .carousel-shell {
    position: relative;
    width: 100%;
    height: auto;
  }

  .carousel-viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .carousel-track {
    display: flex;
    height: 100%;
    will-change: transform;
    transition: transform 0.55s ease;
  }

  .carousel-track.no-transition {
    transition: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    position: relative;
    display: flex;
    align-items: stretch;
    justify-content: center;
  }

  .carousel-slide-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .carousel-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover !important;
    object-position: center;
  }

  .carousel-instance,
  .carousel-track,
  .carousel-slide,
  .carousel-slide-link {
    height: 100%;
  }

  .carousel-instance {
    width: 100%;
  }

  .carousel-controls {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 5;
    padding: 0 12px;
    box-sizing: border-box;
  }

  .carousel-prev, .carousel-next {
    display: none;
  }

  .carousel-controls button {
    pointer-events: all;
    background: rgba(0, 0, 0, 0.35);
    border: none;
    color: white;
    font-size: 28px;
    line-height: 1;
    padding: 10px 14px;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.25s ease, opacity 0.25s ease;
  }

  .carousel-controls button:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  .carousel-dots {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    z-index: 6;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .carousel-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: none;
    background: rgba(0, 0, 0, 0.22);
    cursor: pointer;
    padding: 0;
    transition: transform 0.25s ease, background 0.25s ease, width 0.25s ease;
  }

  .carousel-dot.active {
    width: 24px;
    background: #f98585;
  }

  .desktop-carousel {
    display: block;
  }

  .mobile-carousel {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .desktop-carousel {
      display: none;
    }

    .mobile-carousel {
      display: block;
    }

    .mobile-carousel .carousel-viewport {
      aspect-ratio: 4 / 5;
    }

    .section-{{ section.id }}-padding > .page-width {
      max-width: 100%;
      padding-left: 0;
      padding-right: 0;
    }

    .section-{{ section.id }}-padding {
      padding-top: 0;
    }

    .carousel-controls button {
      font-size: 22px;
      padding: 8px 12px;
    }

    .carousel-dots {
      bottom: 10px;
      gap: 7px;
      padding: 5px 8px;
    }

    .carousel-dot {
      width: 9px;
      height: 9px;
    }

    .carousel-dot.active {
      width: 20px;
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .section-{{ section.id }}-padding > .image-with-text-page-width {
      max-width: {{ section.settings.desktop_max_width | default: 1200 }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign current_lang = request.locale.iso_code | downcase
-%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width image-with-text-page-width">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div class="image-with-text__media image-with-text__media--desktop-{{ section.settings.height_desktop }} image-with-text__media--mobile-{{ section.settings.height_mobile }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.carousel_images == blank %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.carousel_images != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.carousel_images.aspect_ratio | times: 100 }}%;"
            {% endif %}>

            <div class="carousel-shell" id="carousel-shell-{{ section.id }}">
              {%- assign desktop_count = 0 -%}
              {%- assign mobile_count = 0 -%}

              {%- capture desktop_slides -%}
                {%- for block in section.blocks -%}
                  {%- assign block_lang = block.settings.language | default: 'all' | downcase -%}
                  {%- assign show_block = false -%}

                  {%- if block_lang == 'all' or block_lang == current_lang -%}
                    {%- assign show_block = true -%}
                  {%- endif -%}

                  {%- if show_block and block.type == 'carousel_image_desktop' and block.settings.image != blank -%}
                    {%- assign desktop_count = desktop_count | plus: 1 -%}
                    <div class="carousel-slide">
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="carousel-slide-link" aria-label="Desktop slide {{ desktop_count }}">
                          <img
                            src="{{ block.settings.image | image_url: width: 1600 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </a>
                      {%- else -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 1600 }}"
                          alt="{{ block.settings.image.alt | escape }}"
                          loading="lazy"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}"
                        >
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}

              {%- capture mobile_slides -%}
                {%- for block in section.blocks -%}
                  {%- assign block_lang = block.settings.language | default: 'all' | downcase -%}
                  {%- assign show_block = false -%}

                  {%- if block_lang == 'all' or block_lang == current_lang -%}
                    {%- assign show_block = true -%}
                  {%- endif -%}

                  {%- if show_block and block.type == 'carousel_image_mobile' and block.settings.image != blank -%}
                    {%- assign mobile_count = mobile_count | plus: 1 -%}
                    <div class="carousel-slide">
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="carousel-slide-link" aria-label="Mobile slide {{ mobile_count }}">
                          <img
                            src="{{ block.settings.image | image_url: width: 900 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </a>
                      {%- else -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 900 }}"
                          alt="{{ block.settings.image.alt | escape }}"
                          loading="lazy"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}"
                        >
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}

              <div
                class="carousel-instance desktop-carousel"
                id="desktop-carousel-{{ section.id }}"
                data-count="{{ desktop_count }}"
                data-autoplay="true"
                data-interval="5000"
              >
                <div class="carousel-viewport">
                  <div class="carousel-track">
                    {{ desktop_slides }}
                  </div>
                </div>

                {%- if desktop_count > 1 -%}
                  <div class="carousel-controls">
                    <button class="carousel-prev" aria-label="Previous slide" type="button">‹</button>
                    <button class="carousel-next" aria-label="Next slide" type="button">›</button>
                  </div>

                  <div class="carousel-dots"></div>
                {%- endif -%}
              </div>

              <div
                class="carousel-instance mobile-carousel"
                id="mobile-carousel-{{ section.id }}"
                data-count="{{ mobile_count }}"
                data-autoplay="true"
                data-interval="5000"
              >
                <div class="carousel-viewport">
                  <div class="carousel-track">
                    {{ mobile_slides }}
                  </div>
                </div>

                {%- if mobile_count > 1 -%}
                  <div class="carousel-controls">
                    <button class="carousel-prev" aria-label="Previous slide" type="button">‹</button>
                    <button class="carousel-next" aria-label="Next slide" type="button">›</button>
                  </div>

                  <div class="carousel-dots"></div>
                {%- endif -%}
              </div>
            </div>

          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  <h2
                    class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                  <p class="image-with-text__paragraph">Self care for those women who know who they are and what they want</p>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="small-three-images-wrapper">
        <div class="extra-image-wrapper">
          {% if section.settings.extra_image_1 != blank %}
            <img
              src="{{ section.settings.extra_image_1 | image_url: width: 800 }}"
              srcset="
                {{ section.settings.extra_image_1 | image_url: width: 400 }} 400w,
                {{ section.settings.extra_image_1 | image_url: width: 800 }} 800w,
                {{ section.settings.extra_image_1 | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) 50vw, 100vw"
              alt="{{ section.settings.extra_image_alt | escape }}"
              loading="lazy"
              class="extra-image"
            />           
          {% endif %}    
        </div>
  
        <div class="extra-image-wrapper">
          {% if section.settings.extra_image_2 != blank %}
            <img
              src="{{ section.settings.extra_image_2 | image_url: width: 800 }}"
              srcset="
                {{ section.settings.extra_image_2 | image_url: width: 400 }} 400w,
                {{ section.settings.extra_image_2 | image_url: width: 800 }} 800w,
                {{ section.settings.extra_image_2 | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) 50vw, 100vw"
              alt="{{ section.settings.extra_image_alt | escape }}"
              loading="lazy"
              class="extra-image"
            />
          {% endif %}
        </div>
  
        <div class="extra-image-wrapper">
          {% if section.settings.extra_image_3 != blank %}
            <img
              src="{{ section.settings.extra_image_3 | image_url: width: 800 }}"
              srcset="
                {{ section.settings.extra_image_3 | image_url: width: 400 }} 400w,
                {{ section.settings.extra_image_3 | image_url: width: 800 }} 800w,
                {{ section.settings.extra_image_3 | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) 50vw, 100vw"
              alt="{{ section.settings.extra_image_alt | escape }}"
              loading="lazy"
              class="extra-image"
            />
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    class InfinitePageCarousel {
      constructor(root) {
        this.root = root;
        this.viewport = root.querySelector('.carousel-viewport');
        this.track = root.querySelector('.carousel-track');
        this.prevBtn = root.querySelector('.carousel-prev');
        this.nextBtn = root.querySelector('.carousel-next');
        this.dotsWrap = root.querySelector('.carousel-dots');

        this.originalSlides = Array.from(this.track.children);
        this.originalCount = this.originalSlides.length;

        if (!this.track || this.originalCount === 0) return;

        this.currentIndex = 0;
        this.startX = 0;
        this.currentX = 0;
        this.swipeThreshold = 50;
        this.intervalMs = parseInt(root.dataset.interval || '5000', 10);
        this.autoplay = root.dataset.autoplay === 'true';
        this.timer = null;
        this.resumeTimer = null;

        this.handleResize = this.handleResize.bind(this);
        this.handleVisibilityChange = this.handleVisibilityChange.bind(this);
        this.handlePageShow = this.handlePageShow.bind(this);

        this.setup();
      }

      isVisible() {
        return this.root.offsetParent !== null;
      }

      setup() {
        if (this.originalCount > 1) {
          this.cloneSlidesForLoop();
          this.buildDots();
          this.bindEvents();
          this.jumpToRealIndex(0, false);
          this.startAuto();
        } else {
          this.slides = this.originalSlides;
          this.updateTrackHeight();
        }

        window.addEventListener('resize', this.handleResize);
        window.addEventListener('load', () => this.safeRefresh());
        window.addEventListener('pageshow', this.handlePageShow);
        document.addEventListener('visibilitychange', this.handleVisibilityChange);

        this.track.querySelectorAll('img').forEach((img) => {
          if (!img.complete) {
            img.addEventListener('load', () => this.safeRefresh(), { once: true });
          }
        });

        this.safeRefresh();
      }

      destroy() {
        window.removeEventListener('resize', this.handleResize);
        window.removeEventListener('pageshow', this.handlePageShow);
        document.removeEventListener('visibilitychange', this.handleVisibilityChange);
        this.stopAuto();
      }

      handleResize() {
        this.safeRefresh();
      }

      handlePageShow() {
        this.safeRefresh();
      }

      handleVisibilityChange() {
        if (!document.hidden) {
          this.safeRefresh();
          this.startAuto();
        } else {
          this.stopAuto();
        }
      }

      safeRefresh() {
        requestAnimationFrame(() => {
          if (!this.isVisible()) return;
          this.jumpToRealIndex(this.getRealIndex(), false);
          this.updateTrackHeight();
        });
      }

      cloneSlidesForLoop() {
        const firstClone = this.originalSlides[0].cloneNode(true);
        const lastClone = this.originalSlides[this.originalCount - 1].cloneNode(true);

        firstClone.setAttribute('data-clone', 'true');
        lastClone.setAttribute('data-clone', 'true');

        this.track.insertBefore(lastClone, this.track.firstChild);
        this.track.appendChild(firstClone);

        this.slides = Array.from(this.track.children);
        this.currentIndex = 1;
      }

      buildDots() {
        if (!this.dotsWrap) return;

        this.dotsWrap.innerHTML = '';

        for (let i = 0; i < this.originalCount; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'carousel-dot';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.dataset.index = i;
          dot.addEventListener('click', () => {
            this.goToPage(i);
            this.restartAuto();
          });
          this.dotsWrap.appendChild(dot);
        }

        this.updateDots();
      }

      bindEvents() {
        this.nextBtn?.addEventListener('click', () => {
          this.next();
          this.restartAuto();
        });

        this.prevBtn?.addEventListener('click', () => {
          this.prev();
          this.restartAuto();
        });

        this.track.addEventListener('transitionend', () => {
          if (this.currentIndex === 0) {
            this.currentIndex = this.originalCount;
            this.applyTransform(false);
          }

          if (this.currentIndex === this.originalCount + 1) {
            this.currentIndex = 1;
            this.applyTransform(false);
          }

          this.updateDots();
          this.updateTrackHeight();
        });

        this.viewport.addEventListener(
          'touchstart',
          (e) => {
            if (!e.touches.length) return;
            this.stopAuto();
            this.startX = e.touches[0].clientX;
            this.currentX = this.startX;
          },
          { passive: true }
        );

        this.viewport.addEventListener(
          'touchmove',
          (e) => {
            if (!e.touches.length) return;
            this.currentX = e.touches[0].clientX;
          },
          { passive: true }
        );

        this.viewport.addEventListener(
          'touchend',
          () => {
            const diffX = this.currentX - this.startX;

            if (Math.abs(diffX) > this.swipeThreshold) {
              if (diffX < 0) {
                this.next();
              } else {
                this.prev();
              }
            }

            this.restartAuto();
            this.startX = 0;
            this.currentX = 0;
          },
          { passive: true }
        );

        this.viewport.addEventListener('mouseenter', () => this.stopAuto());
        this.viewport.addEventListener('mouseleave', () => this.startAuto());
      }

      getSlideWidth() {
        return this.viewport.offsetWidth;
      }

      applyTransform(animate = true) {
        if (!this.isVisible()) return;

        if (!animate) {
          this.track.classList.add('no-transition');
        } else {
          this.track.classList.remove('no-transition');
        }

        const offset = this.currentIndex * this.getSlideWidth();
        this.track.style.transform = `translateX(-${offset}px)`;
      }

      updateTrackHeight() {
        if (!this.isVisible()) return;

        const viewportWidth = this.viewport.offsetWidth;
        if (!viewportWidth) return;

        if (this.root.classList.contains('mobile-carousel')) {
          this.viewport.style.height = `${viewportWidth * 5 / 4}px`;
          return;
        }

        this.viewport.style.height = `${viewportWidth * 9 / 16}px`;
      }

      getRealIndex() {
        let realIndex = this.currentIndex - 1;

        if (realIndex < 0) realIndex = this.originalCount - 1;
        if (realIndex >= this.originalCount) realIndex = 0;

        return realIndex;
      }

      updateDots() {
        if (!this.dotsWrap) return;

        const realIndex = this.getRealIndex();
        const dots = this.dotsWrap.querySelectorAll('.carousel-dot');

        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === realIndex);
        });
      }

      jumpToRealIndex(realIndex, animate = true) {
        this.currentIndex = realIndex + 1;
        this.applyTransform(animate);
        this.updateDots();
      }

      goToPage(realIndex) {
        this.jumpToRealIndex(realIndex, true);
      }

      next() {
        this.currentIndex += 1;
        this.applyTransform(true);
      }

      prev() {
        this.currentIndex -= 1;
        this.applyTransform(true);
      }

      startAuto() {
        if (!this.autoplay || this.originalCount <= 1 || !this.isVisible()) return;

        this.stopAuto();
        this.timer = setInterval(() => {
          if (this.isVisible() && !document.hidden) {
            this.next();
          }
        }, this.intervalMs);
      }

      stopAuto() {
        if (this.timer) {
          clearInterval(this.timer);
          this.timer = null;
        }
        if (this.resumeTimer) {
          clearTimeout(this.resumeTimer);
          this.resumeTimer = null;
        }
      }

      restartAuto() {
        this.stopAuto();
        this.resumeTimer = setTimeout(() => {
          this.startAuto();
        }, 4000);
      }
    }

    document
      .querySelectorAll('#desktop-carousel-{{ section.id }}, #mobile-carousel-{{ section.id }}')
      .forEach((carousel) => {
        if (parseInt(carousel.dataset.count || '0', 10) > 0) {
          new InfinitePageCarousel(carousel);
        }
      });
  });
</script>


