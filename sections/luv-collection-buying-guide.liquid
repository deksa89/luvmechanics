{%- liquid
  assign guide_title = collection.metafields.custom.luv_guide_title.value | default: 'Buying Guide'
  assign guide_intro = collection.metafields.custom.luv_guide_intro.value
  assign guide_cards = collection.metafields.custom.luv_guide_cards.value
  assign valid_guide_card_count = 0
  assign guide_popup_card_count = 0
-%}

{%- capture guide_cards_markup -%}
  {%- for guide_card in guide_cards -%}
    {%- if guide_card != blank -%}
      {%- liquid
        assign card_title = guide_card.title.value
        assign card_text = guide_card.text.value
        assign card_link_label = guide_card.link_label.value
        assign card_link = guide_card.link.value
        assign card_icon_key = guide_card.icon_key.value | handleize
        assign card_popup_content_field = guide_card.popup_content
        assign card_popup_content = card_popup_content_field.value
        assign card_has_link = false
        assign card_has_popup = false
        assign card_element = 'div'
        assign modal_id = 'LuvCollectionModal-Guide-' | append: section.id | append: '-' | append: forloop.index

        if card_link != blank and card_link_label == blank
          assign card_link_label = 'Read more'
        endif

        if card_link != blank
          assign card_has_link = true
          assign card_element = 'a'
        elsif card_popup_content != blank
          assign card_has_popup = true
        endif
      -%}

      {%- if card_title != blank or card_text != blank -%}
        {%- liquid
          assign valid_guide_card_count = valid_guide_card_count | plus: 1
          if card_has_popup
            assign guide_popup_card_count = guide_popup_card_count | plus: 1
          endif
        -%}

        {%- capture guide_icon -%}
          {%- case card_icon_key -%}
            {%- when 'size' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M5 19 19 5" />
                <path d="m7.5 16.5 2 2M10.5 13.5l2 2M13.5 10.5l2 2M16.5 7.5l2 2" />
                <path d="M4.5 16.5 7.5 19.5 19.5 7.5 16.5 4.5 4.5 16.5Z" />
              </svg>
            {%- when 'compare' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M8 5h11M8 12h11M8 19h11" />
                <path d="m3.5 5 1.25 1.25L6.8 4.2M3.5 12l1.25 1.25L6.8 11.2M3.5 19l1.25 1.25 2.05-2.05" />
              </svg>
            {%- when 'beginner' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 3.5 14.6 8l5 .9-3.45 3.7.65 5.1L12 15.55 7.2 17.7l.65-5.1L4.4 8.9l5-.9L12 3.5Z" />
                <path d="M12 9.25v3.25M12 15.25h.01" />
              </svg>
          {%- endcase -%}
        {%- endcapture -%}

        <li class="luv-collection-guide__item">
          <{{ card_element }}
            class="luv-collection-guide__card{% if card_has_link or card_has_popup %} luv-collection-card--interactive{% endif %}"
            {% if card_has_link %}
              href="{{ card_link | escape }}"
              data-luv-track="guide-link"
              data-luv-card-type="guide"
              data-luv-interaction-type="link"
              data-luv-card-title="{{ card_title | default: card_text | strip_html | escape }}"
            {% endif %}
          >
            {%- if guide_icon != blank -%}
              <span class="luv-collection-guide__icon" aria-hidden="true">
                {{- guide_icon -}}
              </span>
            {%- endif -%}
            <div class="luv-collection-guide__body">
              {%- if card_title != blank -%}
                <h3 class="luv-collection-guide__title">{{ card_title | strip_html | escape }}</h3>
              {%- endif -%}
              {%- if card_text != blank -%}
                <p class="luv-collection-guide__text">{{ card_text | strip_html | escape }}</p>
              {%- endif -%}
              {%- if card_has_link -%}
                <span class="luv-collection-guide__link">
                  {{- card_link_label | strip_html | escape -}}
                  <span aria-hidden="true">&rarr;</span>
                </span>
              {%- endif -%}
            </div>
            {%- if card_has_popup -%}
              <button
                class="luv-collection-card-trigger"
                type="button"
                aria-haspopup="dialog"
                aria-controls="{{ modal_id }}"
                aria-label="{{ card_title | default: card_text | strip_html | escape }}"
                data-luv-collection-modal-trigger
                data-luv-card-type="guide"
                data-luv-card-title="{{ card_title | default: card_text | strip_html | escape }}"
              ></button>
            {%- endif -%}
          </{{ card_element }}>
        </li>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture guide_modals_markup -%}
  {%- for guide_card in guide_cards -%}
    {%- if guide_card != blank -%}
      {%- liquid
        assign card_title = guide_card.title.value
        assign card_text = guide_card.text.value
        assign card_link = guide_card.link.value
        assign card_popup_content_field = guide_card.popup_content
        assign card_popup_content = card_popup_content_field.value
        assign modal_id = 'LuvCollectionModal-Guide-' | append: section.id | append: '-' | append: forloop.index
        assign modal_title_id = modal_id | append: '-Title'
        assign modal_title = card_title | default: guide_title
      -%}
      {%- if card_link == blank and card_popup_content != blank -%}
        {%- if card_title != blank or card_text != blank -%}
          {% render 'luv-collection-card-modal',
            modal_id: modal_id,
            modal_title_id: modal_title_id,
            modal_title: modal_title,
            popup_content: card_popup_content_field
          %}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if valid_guide_card_count > 0 -%}
  <section
    class="luv-collection-guide"
    aria-labelledby="LuvCollectionGuideTitle-{{ section.id }}"
  >
    <div class="luv-collection-guide__inner">
      <header class="luv-collection-guide__header">
        <h2 class="luv-collection-guide__heading" id="LuvCollectionGuideTitle-{{ section.id }}">
          {{ guide_title | strip_html | escape }}
        </h2>
        {%- if guide_intro != blank -%}
          <p class="luv-collection-guide__intro">{{ guide_intro | strip_html | escape }}</p>
        {%- endif -%}
      </header>
      <ul class="luv-collection-guide__grid" role="list">
        {{ guide_cards_markup }}
      </ul>
    </div>
    {{ guide_modals_markup }}
  </section>
  {%- if guide_popup_card_count > 0 -%}
    <script src="{{ 'luv-collection-card-modal.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Luv buying guide",
  "settings": [],
  "presets": [
    {
      "name": "Luv buying guide"
    }
  ]
}
{% endschema %}
