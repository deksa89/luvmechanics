{% comment %}
  Custom section: Full image banner with button
{% endcomment %}

<section
  class="custom-image-banner custom-image-banner-{{ section.id }}"
  style="
    --desktop-height: {{ section.settings.desktop_height }}px;
    --mobile-height: {{ section.settings.mobile_height }}px;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --content-position-y: {{ section.settings.content_position_y }}%;
    --content-position-x: {{ section.settings.content_position_x }}%;
  "
>
  {% if section.settings.image != blank %}
    <div class="custom-image-banner__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '375, 550, 750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          class: 'custom-image-banner__image',
          alt: section.settings.image.alt
      }}
    </div>
  {% else %}
    <div class="custom-image-banner__placeholder">
      Upload image
    </div>
  {% endif %}

  {% if section.settings.overlay_opacity > 0 %}
    <div class="custom-image-banner__overlay"></div>
  {% endif %}

  <div class="custom-image-banner__content">
    {% if section.settings.heading != blank %}
      <h2 class="custom-image-banner__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="custom-image-banner__text">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="custom-image-banner__button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  .custom-image-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: var(--desktop-height);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-image-banner-{{ section.id }} .custom-image-banner__media,
  .custom-image-banner-{{ section.id }} .custom-image-banner__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .custom-image-banner-{{ section.id }} .custom-image-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-image-banner-{{ section.id }} .custom-image-banner__placeholder {
    background: #f3f3f3;
    color: #555;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .custom-image-banner-{{ section.id }} .custom-image-banner__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--overlay-opacity);
    z-index: 1;
    pointer-events: none;
  }

  .custom-image-banner-{{ section.id }} .custom-image-banner__content {
    position: absolute;
    top: var(--content-position-y);
    left: var(--content-position-x);
    transform: translate(-50%, -50%);
    z-index: 2;
    text-align: center;
    padding: 20px;
    max-width: 700px;
    width: calc(100% - 40px);
  }

  .custom-image-banner-{{ section.id }} .custom-image-banner__heading {
    margin: 0 0 14px;
    color: {{ section.settings.text_color }};
    font-size: clamp(28px, 4vw, 56px);
    line-height: 1.1;
  }

  .custom-image-banner-{{ section.id }} .custom-image-banner__text {
    color: {{ section.settings.text_color }};
    font-size: clamp(15px, 1.5vw, 20px);
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .custom-image-banner-{{ section.id }} .custom-image-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 28px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border: 1px solid {{ section.settings.button_border_color }};
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .custom-image-banner-{{ section.id }} .custom-image-banner__button:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 749px) {
    .custom-image-banner-{{ section.id }} {
      min-height: var(--mobile-height);
    }

    .custom-image-banner-{{ section.id }} .custom-image-banner__content {
      width: calc(100% - 24px);
      padding: 12px;
    }

    .custom-image-banner-{{ section.id }} .custom-image-banner__button {
      min-height: 44px;
      padding: 11px 22px;
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "Image banner with button",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover something new"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Explore our selected collection.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Istraži više"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop section height",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile section height",
      "min": 240,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Dark overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "content_position_x",
      "label": "Content horizontal position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "content_position_y",
      "label": "Content vertical position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Image banner with button"
    }
  ]
}
{% endschema %}