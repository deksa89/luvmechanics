{% doc %}
  @prompt
    generate me a "Did you know?" carousel block where i can add as much text items as i want. make is highly customizable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-did-you-know-carousel-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    width: 1440px;
    margin: 0 auto;
    padding-top: 60px;
    padding-bottom: 60px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-did-you-know-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-did-you-know-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: {{ block.settings.heading_weight }};
  }

  .ai-did-you-know-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-did-you-know-carousel-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .ai-did-you-know-carousel-item-{{ ai_gen_id }} {
    min-width: 100%;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background_color }};
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-sizing: border-box;
  }

  .ai-did-you-know-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-did-you-know-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.line_height }};
    text-align: {{ block.settings.text_alignment }};
    margin: 0;
  }

  .ai-did-you-know-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.controls_spacing }}px;
    margin-top: {{ block.settings.controls_top_spacing }}px;
  }

  .ai-did-you-know-nav-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_icon_color }};
    border: none;
    width: {{ block.settings.button_size }}px;
    height: {{ block.settings.button_size }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-did-you-know-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
  }

  .ai-did-you-know-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-did-you-know-nav-button-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.button_size }}px * 0.5);
    height: calc({{ block.settings.button_size }}px * 0.5);
  }

  .ai-did-you-know-dots-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.dots_spacing }}px;
  }

  .ai-did-you-know-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .ai-did-you-know-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-did-you-know-counter-{{ ai_gen_id }} {
    font-size: {{ block.settings.counter_size }}px;
    color: {{ block.settings.counter_color }};
    font-weight: {{ block.settings.counter_weight }};
  }

  @media screen and (max-width: 749px) {
    .ai-did-you-know-carousel-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-did-you-know-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-did-you-know-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<did-you-know-carousel-{{ ai_gen_id }}
  class="ai-did-you-know-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <div class="ai-did-you-know-header-{{ ai_gen_id }}">
      <h2 class="ai-did-you-know-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="ai-did-you-know-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-did-you-know-carousel-track-{{ ai_gen_id }}">
      {% assign fact_count = 0 %}
      
      {% for i in (1..10) %}
        {% liquid
          assign fact_key = 'fact_' | append: i
          assign icon_key = 'icon_' | append: i
          assign show_icon_key = 'show_icon_' | append: i
          
          assign fact_text = block.settings[fact_key]
          assign icon = block.settings[icon_key]
          assign show_icon = block.settings[show_icon_key]
        %}
        
        {% if fact_text != blank %}
          {% assign fact_count = fact_count | plus: 1 %}
          <div class="ai-did-you-know-carousel-item-{{ ai_gen_id }}">
            {% if show_icon and icon != blank %}
              <div class="ai-did-you-know-icon-{{ ai_gen_id }}">
                {{ icon }}
              </div>
            {% endif %}
            <div class="ai-did-you-know-text-{{ ai_gen_id }}">
              {{ fact_text }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if fact_count > 1 %}
    <div class="ai-did-you-know-controls-{{ ai_gen_id }}">
      {% if block.settings.show_arrows %}
        <button
          class="ai-did-you-know-nav-button-{{ ai_gen_id }} ai-did-you-know-prev-{{ ai_gen_id }}"
          aria-label="Previous fact"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {% endif %}

      {% if block.settings.show_dots %}
        <div class="ai-did-you-know-dots-{{ ai_gen_id }}">
          {% for i in (1..fact_count) %}
            <button
              class="ai-did-you-know-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              aria-label="Go to fact {{ i }}"
              data-index="{{ forloop.index0 }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}

      {% if block.settings.show_counter %}
        <div class="ai-did-you-know-counter-{{ ai_gen_id }}">
          <span class="ai-did-you-know-current-{{ ai_gen_id }}">1</span>
          /
          <span class="ai-did-you-know-total-{{ ai_gen_id }}">{{ fact_count }}</span>
        </div>
      {% endif %}

      {% if block.settings.show_arrows %}
        <button
          class="ai-did-you-know-nav-button-{{ ai_gen_id }} ai-did-you-know-next-{{ ai_gen_id }}"
          aria-label="Next fact"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {% endif %}
    </div>
  {% endif %}
</did-you-know-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class DidYouKnowCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-did-you-know-carousel-track-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.ai-did-you-know-carousel-item-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-did-you-know-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-did-you-know-next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-did-you-know-dot-{{ ai_gen_id }}');
        this.currentCounter = this.querySelector('.ai-did-you-know-current-{{ ai_gen_id }}');

        if (this.items.length <= 1) return;

        this.setupEventListeners();
        this.updateCarousel();

        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.goToPrevious();
            this.resetAutoplay();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.goToNext();
            this.resetAutoplay();
          });
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const index = parseInt(e.target.dataset.index);
            this.goToSlide(index);
            this.resetAutoplay();
          });
        });

        {% if block.settings.pause_on_hover %}
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => {
            {% if block.settings.autoplay %}
              this.startAutoplay();
            {% endif %}
          });
        {% endif %}
      }

      goToPrevious() {
        this.currentIndex = this.currentIndex === 0 ? this.items.length - 1 : this.currentIndex - 1;
        this.updateCarousel();
      }

      goToNext() {
        this.currentIndex = this.currentIndex === this.items.length - 1 ? 0 : this.currentIndex + 1;
        this.updateCarousel();
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const offset = -this.currentIndex * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        if (this.currentCounter) {
          this.currentCounter.textContent = this.currentIndex + 1;
        }

        if (this.prevButton) {
          this.prevButton.disabled = false;
        }

        if (this.nextButton) {
          this.nextButton.disabled = false;
        }
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.goToNext();
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      resetAutoplay() {
        this.stopAutoplay();
        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('did-you-know-carousel-{{ ai_gen_id }}', DidYouKnowCarousel{{ ai_gen_id }});
  })();
</script>

