{% doc %}
  @prompt
    generate me a carousel section where i can show my top products. make the block highly customizable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign real_product_count = 0
  if block.settings.products != blank
    assign real_product_count = block.settings.products.count
  else
    assign real_product_count = 6
  endif
%}

{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-carousel-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0;
  }

  .ai-product-carousel-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-product-carousel-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    font-weight: 200;
  }

  .ai-product-carousel-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-product-carousel-divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: #d9d9d9;
    width: 100%;
    margin-top: 16px;
  }

  .ai-product-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-carousel-viewport-{{ ai_gen_id }} {
    overflow: hidden;
    width: 100%;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .ai-product-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    align-items: stretch;
    will-change: transform;
    transition: transform 0.45s ease;
    padding: 10px 0;
  }

  .ai-product-carousel-track-{{ ai_gen_id }}.no-transition {
    transition: none;
  }

  .ai-product-carousel-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    flex: 0 0 {{ block.settings.product_width }}px;
    min-width: {{ block.settings.product_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    align-self: stretch;
    height: auto;
    box-sizing: border-box;
  }

  .ai-product-carousel-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow_offset }}px {{ block.settings.hover_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.hover_shadow_opacity }});
  }

  .ai-product-carousel-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    padding: 64px;
    box-sizing: border-box;
    margin: 45px 0 0 0;
  }

  .ai-product-carousel-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-product-carousel-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-carousel-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-carousel-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 10px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    z-index: 2;
  }

  .ai-product-carousel-info-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 30px 20px 10px 20px;
    text-align: {{ block.settings.product_text_alignment }};
  }

  .ai-product-carousel-vendor-{{ ai_gen_id }} {
    font-size: {{ block.settings.vendor_size }}px;
    color: {{ block.settings.vendor_color }};
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-product-carousel-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
    margin-bottom: 12px;
  }

  .ai-product-carousel-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
  }

  .ai-product-carousel-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    box-sizing: border-box;
  }

  .ai-product-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-product-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: {% if block.settings.show_navigation %}flex{% else %}none{% endif %};
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: background-color 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-product-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_background }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-product-carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .ai-product-carousel-nav-prev-{{ ai_gen_id }} {
    left: -{{ block.settings.nav_button_offset }}px;
  }

  .ai-product-carousel-nav-next-{{ ai_gen_id }} {
    right: -{{ block.settings.nav_button_offset }}px;
  }

  .ai-product-carousel-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-product-carousel-dots-{{ ai_gen_id }} {
    display: {% if block.settings.show_dots %}flex{% else %}none{% endif %};
    justify-content: center;
    gap: 8px;
    margin-top: {{ block.settings.dots_spacing }}px;
  }

  .ai-product-carousel-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 999px;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease, width 0.25s ease, opacity 0.25s ease;
    padding: 0;
    opacity: 0.45;
  }

  .ai-product-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    width: calc({{ block.settings.dot_size }}px * 2.4);
    transform: scale(1.05);
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-product-carousel-item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_product_width }}px;
      min-width: {{ block.settings.mobile_product_width }}px;
    }

    .ai-product-carousel-nav-{{ ai_gen_id }} {
      display: {{ block.settings.show_nav_mobile }};
    }

    .ai-product-carousel-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-product-carousel-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 425px) {
    .ai-product-carousel-container-{{ ai_gen_id }} {
      padding: 0;
    }
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }}
  class="ai-product-carousel-{{ ai_gen_id }}"
  data-real-count="{{ real_product_count }}"
  data-autoplay="{% if block.settings.enable_autoplay %}true{% else %}false{% endif %}"
  data-autoplay-speed="{{ block.settings.autoplay_speed | times: 1000 }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-carousel-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-product-carousel-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-carousel-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-product-carousel-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
        <div class="ai-product-carousel-divider-{{ ai_gen_id }}"></div>
      </div>
    {% endif %}

    <div class="ai-product-carousel-wrapper-{{ ai_gen_id }}">
      {% if block.settings.show_navigation %}
        <button
          class="ai-product-carousel-nav-{{ ai_gen_id }} ai-product-carousel-nav-prev-{{ ai_gen_id }}"
          aria-label="Previous products"
          data-direction="prev"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {% endif %}

      <div class="ai-product-carousel-viewport-{{ ai_gen_id }}" data-carousel-viewport>
        <div class="ai-product-carousel-track-{{ ai_gen_id }}" data-carousel-track>
          {% if block.settings.products != blank %}
            {% for product in block.settings.products %}
              <a
                href="{{ product.url }}"
                class="ai-product-carousel-item-{{ ai_gen_id }}"
                aria-label="{{ product.title | escape }}"
                data-real-item="true"
              >
                <div class="ai-product-carousel-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-product-carousel-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="ai-product-carousel-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}

                  {% if block.settings.show_sale_badge and product.compare_at_price > product.price %}
                    <span class="ai-product-carousel-badge-{{ ai_gen_id }}">{{ block.settings.sale_badge_text }}</span>
                  {% endif %}
                </div>

                <div class="ai-product-carousel-info-{{ ai_gen_id }}">
                  {% if block.settings.show_vendor and product.vendor != blank %}
                    <p class="ai-product-carousel-vendor-{{ ai_gen_id }}">{{ product.vendor }}</p>
                  {% endif %}

                  <h3 class="ai-product-carousel-title-{{ ai_gen_id }}">
                    {{ product.title }}
                  </h3>

                  {% if block.settings.show_price %}
                    <div class="ai-product-carousel-price-{{ ai_gen_id }}">
                      {% if product.compare_at_price > product.price %}
                        <span class="ai-product-carousel-price-compare-{{ ai_gen_id }}">
                          {{ product.compare_at_price | money }}
                        </span>
                      {% endif %}
                      <span>{{ product.price | money }}</span>
                    </div>
                  {% endif %}

                  {% if block.settings.show_button %}
                    <span class="ai-product-carousel-button-{{ ai_gen_id }}" role="button" aria-hidden="true">
                      {{ block.settings.button_text }}
                    </span>
                  {% endif %}
                </div>
              </a>
            {% endfor %}
          {% else %}
            {% for i in (1..6) %}
              <div class="ai-product-carousel-item-{{ ai_gen_id }}" data-real-item="true">
                <div class="ai-product-carousel-image-wrapper-{{ ai_gen_id }}">
                  <div class="ai-product-carousel-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                </div>
                <div class="ai-product-carousel-info-{{ ai_gen_id }}">
                  <h3 class="ai-product-carousel-title-{{ ai_gen_id }}">Product title</h3>
                  <div class="ai-product-carousel-price-{{ ai_gen_id }}">€29.99</div>
                  {% if block.settings.show_button %}
                    <span class="ai-product-carousel-button-{{ ai_gen_id }}">
                      {{ block.settings.button_text }}
                    </span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      {% if block.settings.show_navigation %}
        <button
          class="ai-product-carousel-nav-{{ ai_gen_id }} ai-product-carousel-nav-next-{{ ai_gen_id }}"
          aria-label="Next products"
          data-direction="next"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {% endif %}
    </div>

    {% if block.settings.show_dots %}
      <div class="ai-product-carousel-dots-{{ ai_gen_id }}" data-carousel-dots></div>
    {% endif %}
  </div>
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.viewport = this.querySelector('[data-carousel-viewport]');
        this.track = this.querySelector('[data-carousel-track]');
        this.prevButton = this.querySelector('[data-direction="prev"]');
        this.nextButton = this.querySelector('[data-direction="next"]');
        this.dotsContainer = this.querySelector('[data-carousel-dots]');
        this.realItems = Array.from(this.querySelectorAll('[data-real-item="true"]'));

        this.currentIndex = 0;
        this.startX = 0;
        this.currentX = 0;
        this.isDragging = false;
        this.swipeThreshold = 50;
        this.cloneCount = 0;
        this.resumeTimer = null;
        this.autoPlayTimer = null;
      }

      connectedCallback() {
        if (!this.track || this.realItems.length === 0) return;

        this.setupInfiniteLoop();
        this.setupDots();
        this.bindEvents();

        this.jumpToInitialPosition();
        this.updateCarousel(false);
        this.updateNavigation();
        this.startAutoplay();

        this.handleResize = this.handleResize.bind(this);
        this.handleTransitionEnd = this.handleTransitionEnd.bind(this);

        window.addEventListener('resize', this.handleResize);
        this.track.addEventListener('transitionend', this.handleTransitionEnd);
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.handleResize);
        if (this.track) {
          this.track.removeEventListener('transitionend', this.handleTransitionEnd);
        }
        this.stopAutoplay();
        clearTimeout(this.resumeTimer);
      }

      getItemWidth() {
        const firstItem = this.track.querySelector('.ai-product-carousel-item-{{ ai_gen_id }}');
        return firstItem ? firstItem.offsetWidth : 0;
      }

      getGap() {
        return {{ block.settings.product_gap }};
      }

      getStepSize() {
        return this.getItemWidth() + this.getGap();
      }

      getItemsPerView() {
        const itemWidth = this.getItemWidth();
        if (!itemWidth || !this.viewport) return 1;
        return Math.max(1, Math.floor((this.viewport.offsetWidth + this.getGap()) / (itemWidth + this.getGap())));
      }

      getPageCount() {
        const itemsPerView = this.getItemsPerView();
        return Math.max(1, Math.ceil(this.realItems.length / itemsPerView));
      }

      getNormalizedIndex() {
        let normalized = (this.currentIndex - this.cloneCount) % this.realItems.length;
        if (normalized < 0) normalized += this.realItems.length;
        return normalized;
      }

      getCurrentPage() {
        const itemsPerView = this.getItemsPerView();
        return Math.floor(this.getNormalizedIndex() / itemsPerView);
      }

      setupInfiniteLoop() {
        this.track.querySelectorAll('[data-clone="true"]').forEach((el) => el.remove());

        this.cloneCount = this.getItemsPerView();

        const prependClones = this.realItems.slice(-this.cloneCount).map((item) => {
          const clone = item.cloneNode(true);
          clone.setAttribute('data-clone', 'true');
          return clone;
        });

        const appendClones = this.realItems.slice(0, this.cloneCount).map((item) => {
          const clone = item.cloneNode(true);
          clone.setAttribute('data-clone', 'true');
          return clone;
        });

        prependClones.forEach((clone) => {
          this.track.insertBefore(clone, this.track.firstChild);
        });

        appendClones.forEach((clone) => {
          this.track.appendChild(clone);
        });
      }

      jumpToInitialPosition() {
        this.currentIndex = this.cloneCount;
      }

      bindEvents() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.pauseAndResumeAutoplay();
            this.navigatePage('prev');
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.pauseAndResumeAutoplay();
            this.navigatePage('next');
          });
        }

        if (this.dotsContainer) {
          this.dotsContainer.addEventListener('click', (event) => {
            const dot = event.target.closest('[data-dot-index]');
            if (!dot) return;

            const targetPage = Number(dot.dataset.dotIndex);
            this.pauseAndResumeAutoplay();
            this.goToPage(targetPage);
          });
        }

        this.viewport.addEventListener('mouseenter', () => this.stopAutoplay());
        this.viewport.addEventListener('mouseleave', () => this.startAutoplay());

        this.viewport.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
        this.viewport.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: true });
        this.viewport.addEventListener('touchend', this.handleTouchEnd.bind(this));

        this.viewport.addEventListener('mousedown', this.handleMouseDown.bind(this));
        this.viewport.addEventListener('mousemove', this.handleMouseMove.bind(this));
        this.viewport.addEventListener('mouseup', this.handleMouseUp.bind(this));
        this.viewport.addEventListener('mouseleave', this.handleMouseLeave.bind(this));
      }

      handleResize() {
        const normalized = this.getNormalizedIndex();
        this.stopAutoplay();
        this.setupInfiniteLoop();
        this.setupDots();
        this.currentIndex = normalized + this.cloneCount;
        this.updateCarousel(false);
        this.updateNavigation();
        this.startAutoplay();
      }

      setupDots() {
        if (!this.dotsContainer) return;

        const pageCount = this.getPageCount();
        this.dotsContainer.innerHTML = '';

        for (let i = 0; i < pageCount; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'ai-product-carousel-dot-{{ ai_gen_id }}';
          dot.dataset.dotIndex = i;
          dot.setAttribute('aria-label', `Go to page ${i + 1}`);
          if (i === this.getCurrentPage()) {
            dot.classList.add('active');
          }
          this.dotsContainer.appendChild(dot);
        }
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const activePage = this.getCurrentPage();
        const dots = this.dotsContainer.querySelectorAll('.ai-product-carousel-dot-{{ ai_gen_id }}');

        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === activePage);
        });
      }

      updateCarousel(animate = true) {
        const step = this.getStepSize();
        if (!step) return;

        if (animate) {
          this.track.classList.remove('no-transition');
        } else {
          this.track.classList.add('no-transition');
        }

        const offset = this.currentIndex * step;
        this.track.style.transform = `translateX(-${offset}px)`;

        this.updateDots();
      }

      updateNavigation() {
        if (!this.prevButton || !this.nextButton) return;

        this.prevButton.disabled = false;
        this.nextButton.disabled = false;
      }

      navigatePage(direction) {
        const itemsPerView = this.getItemsPerView();
        if (direction === 'next') {
          this.currentIndex += itemsPerView;
        } else {
          this.currentIndex -= itemsPerView;
        }
        this.updateCarousel(true);
      }

      goToPage(pageIndex) {
        const itemsPerView = this.getItemsPerView();
        const targetIndex = (pageIndex * itemsPerView) + this.cloneCount;
        this.currentIndex = targetIndex;
        this.updateCarousel(true);
      }

      handleTransitionEnd() {
        if (this.currentIndex >= this.realItems.length + this.cloneCount) {
          this.currentIndex = this.cloneCount + (this.currentIndex - this.cloneCount - this.realItems.length);
          this.updateCarousel(false);
        }

        if (this.currentIndex < this.cloneCount) {
          this.currentIndex = this.realItems.length + this.currentIndex;
          this.updateCarousel(false);
        }
      }

      startAutoplay() {
        if (this.dataset.autoplay !== 'true') return;
        if (this.realItems.length <= this.getItemsPerView()) return;

        this.stopAutoplay();

        const delay = Number(this.dataset.autoplaySpeed || 5000);
        this.autoPlayTimer = setInterval(() => {
          this.navigatePage('next');
        }, delay);
      }

      stopAutoplay() {
        if (this.autoPlayTimer) {
          clearInterval(this.autoPlayTimer);
          this.autoPlayTimer = null;
        }
      }

      pauseAndResumeAutoplay() {
        this.stopAutoplay();
        clearTimeout(this.resumeTimer);
        this.resumeTimer = setTimeout(() => {
          this.startAutoplay();
        }, 4000);
      }

      handleTouchStart(event) {
        if (!event.changedTouches.length) return;
        this.stopAutoplay();
        this.startX = event.changedTouches[0].clientX;
        this.currentX = this.startX;
      }

      handleTouchMove(event) {
        if (!event.changedTouches.length) return;
        this.currentX = event.changedTouches[0].clientX;
      }

      handleTouchEnd() {
        const diff = this.currentX - this.startX;

        if (Math.abs(diff) > this.swipeThreshold) {
          if (diff < 0) {
            this.navigatePage('next');
          } else {
            this.navigatePage('prev');
          }
        }

        this.startX = 0;
        this.currentX = 0;
        this.pauseAndResumeAutoplay();
      }

      handleMouseDown(event) {
        this.isDragging = true;
        this.stopAutoplay();
        this.startX = event.clientX;
        this.currentX = event.clientX;
      }

      handleMouseMove(event) {
        if (!this.isDragging) return;
        this.currentX = event.clientX;
      }

      handleMouseUp() {
        if (!this.isDragging) return;

        const diff = this.currentX - this.startX;

        if (Math.abs(diff) > this.swipeThreshold) {
          if (diff < 0) {
            this.navigatePage('next');
          } else {
            this.navigatePage('prev');
          }
        }

        this.isDragging = false;
        this.startX = 0;
        this.currentX = 0;
        this.pauseAndResumeAutoplay();
      }

      handleMouseLeave() {
        if (!this.isDragging) {
          this.startAutoplay();
          return;
        }

        this.isDragging = false;
        this.startX = 0;
        this.currentX = 0;
        this.pauseAndResumeAutoplay();
      }
    }

    if (!customElements.get('product-carousel-{{ ai_gen_id }}')) {
      customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
    }
  })();
</script>

