{% doc %}
  @prompt
    generate me a carousel section where i can show my top products in a bundle, e.g i want to be able to add more than one product in a card. Also make the block highly customizable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bundle-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-bundle-carousel-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-bundle-hero-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background: #f4f4f4;
    margin-bottom: 16px;
  }
  .ai-bundle-hero-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bundle-carousel-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-bundle-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    font-weight: 700;
  }

  .ai-bundle-carousel-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-bundle-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin: 0 {{ block.settings.arrow_offset }}px;
  }

  .ai-bundle-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .ai-bundle-carousel-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.cards_per_view | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_per_view }});
    min-width: 0;
  }

  .ai-bundle-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .ai-bundle-card-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.bundle_title_spacing }}px;
  }

  .ai-bundle-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.bundle_title_size }}px;
    color: {{ block.settings.bundle_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-bundle-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.bundle_description_size }}px;
    color: {{ block.settings.bundle_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-bundle-products-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.product_spacing }}px;
    margin-bottom: {{ block.settings.products_bottom_spacing }}px;
    flex-grow: 1;
  }

  .ai-bundle-product-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_image_spacing }}px;
    align-items: flex-start;
  }

  .ai-bundle-product-image-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.product_image_size }}px;
    height: {{ block.settings.product_image_size }}px;
    border-radius: {{ block.settings.product_image_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-bundle-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bundle-product-info-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-bundle-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 4px;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-bundle-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 600;
  }

  .ai-bundle-card-footer-{{ ai_gen_id }} {
    margin-top: auto;
    padding-top: {{ block.settings.footer_spacing }}px;
    border-top: 1px solid {{ block.settings.divider_color }};
  }

  .ai-bundle-total-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ block.settings.total_spacing }}px;
  }

  .ai-bundle-total-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.total_label_size }}px;
    color: {{ block.settings.total_label_color }};
    font-weight: 600;
  }

  .ai-bundle-total-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.total_price_size }}px;
    color: {{ block.settings.total_price_color }};
    font-weight: 700;
  }

  .ai-bundle-button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-decoration: none;
    display: block;
    text-align: center;
  }

  .ai-bundle-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-bundle-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    background-color: {{ block.settings.arrow_background }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease, opacity 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-bundle-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
  }

  .ai-bundle-carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-bundle-carousel-nav-{{ ai_gen_id }}.prev {
    left: calc(-1 * {{ block.settings.arrow_offset }}px);
  }

  .ai-bundle-carousel-nav-{{ ai_gen_id }}.next {
    right: calc(-1 * {{ block.settings.arrow_offset }}px);
  }

  .ai-bundle-carousel-nav-{{ ai_gen_id }} svg {
    width: {{ block.settings.arrow_icon_size }}px;
    height: {{ block.settings.arrow_icon_size }}px;
    fill: {{ block.settings.arrow_color }};
  }

  .ai-bundle-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: {{ block.settings.dots_spacing }}px;
  }

  .ai-bundle-carousel-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .ai-bundle-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-bundle-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-bundle-empty-state-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  .ai-bundle-empty-state-{{ ai_gen_id }} p {
    font-size: 16px;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-bundle-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.cards_per_view_tablet | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_per_view_tablet }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-bundle-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-bundle-carousel-wrapper-{{ ai_gen_id }} {
      margin: 0;
    }

    .ai-bundle-carousel-nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-bundle-carousel-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-bundle-carousel-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<product-bundle-carousel-{{ ai_gen_id }} class="ai-bundle-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bundle-carousel-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-bundle-carousel-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-bundle-carousel-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-bundle-carousel-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign bundle_image_key = 'bundle_' | append: i | append: '_image' %}
    {% assign bundle_image = block.settings[bundle_image_key] %}

    {% if bundle_image != blank %}
      <div class="ai-bundle-hero-{{ ai_gen_id }}">
        <img
          src="{{ bundle_image | image_url: width: 800 }}"
          alt="{{ bundle_title | escape }}"
          loading="lazy"
        >
      </div>
    {% endif %}

    {% assign has_bundles = false %}
    {% for i in (1..6) %}
      {% assign bundle_enabled_key = 'bundle_' | append: i | append: '_enabled' %}
      {% if block.settings[bundle_enabled_key] %}
        {% assign has_bundles = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_bundles %}
      <div class="ai-bundle-carousel-wrapper-{{ ai_gen_id }}">
        <div class="ai-bundle-carousel-track-{{ ai_gen_id }}" data-track>
          {% for i in (1..6) %}
            {% liquid
              assign bundle_enabled_key = 'bundle_' | append: i | append: '_enabled'
              assign bundle_title_key = 'bundle_' | append: i | append: '_title'
              assign bundle_description_key = 'bundle_' | append: i | append: '_description'
              assign product_1_key = 'bundle_' | append: i | append: '_product_1'
              assign product_2_key = 'bundle_' | append: i | append: '_product_2'
              assign product_3_key = 'bundle_' | append: i | append: '_product_3'
              assign product_4_key = 'bundle_' | append: i | append: '_product_4'
              assign button_text_key = 'bundle_' | append: i | append: '_button_text'
              assign button_link_key = 'bundle_' | append: i | append: '_button_link'

              assign bundle_enabled = block.settings[bundle_enabled_key]
              assign bundle_title = block.settings[bundle_title_key]
              assign bundle_description = block.settings[bundle_description_key]
              assign product_1 = block.settings[product_1_key]
              assign product_2 = block.settings[product_2_key]
              assign product_3 = block.settings[product_3_key]
              assign product_4 = block.settings[product_4_key]
              assign button_text = block.settings[button_text_key]
              assign button_link = block.settings[button_link_key]
            %}

            {% if bundle_enabled %}
              <div class="ai-bundle-carousel-slide-{{ ai_gen_id }}">
                <div class="ai-bundle-card-{{ ai_gen_id }}">
                  {% if bundle_title != blank or bundle_description != blank %}
                    <div class="ai-bundle-card-header-{{ ai_gen_id }}">
                      {% if bundle_title != blank %}
                        <h3 class="ai-bundle-card-title-{{ ai_gen_id }}">{{ bundle_title }}</h3>
                      {% endif %}
                      {% if bundle_description != blank %}
                        <p class="ai-bundle-card-description-{{ ai_gen_id }}">{{ bundle_description }}</p>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="ai-bundle-products-{{ ai_gen_id }}">
                    {% assign total_price = 0 %}
                    {% assign products_array = '' | split: ',' %}
                    
                    {% if product_1 != blank %}
                      {% assign products_array = products_array | concat: product_1 %}
                    {% endif %}
                    {% if product_2 != blank %}
                      {% assign products_array = products_array | concat: product_2 %}
                    {% endif %}
                    {% if product_3 != blank %}
                      {% assign products_array = products_array | concat: product_3 %}
                    {% endif %}
                    {% if product_4 != blank %}
                      {% assign products_array = products_array | concat: product_4 %}
                    {% endif %}

                    {% for product in products_array %}
                      {% assign total_price = total_price | plus: product.price %}
                      <div class="ai-bundle-product-{{ ai_gen_id }}">
                        <div class="ai-bundle-product-image-{{ ai_gen_id }}">
                          {% if product.featured_image %}
                            <img
                              src="{{ product.featured_image | image_url: width: 200 }}"
                              alt="{{ product.featured_image.alt | escape }}"
                              loading="lazy"
                              width="200"
                              height="200"
                            >
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag }}
                          {% endif %}
                        </div>
                        <div class="ai-bundle-product-info-{{ ai_gen_id }}">
                          <h4 class="ai-bundle-product-title-{{ ai_gen_id }}">{{ product.title }}</h4>
                          <div class="ai-bundle-product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                        </div>
                      </div>
                    {% endfor %}

                    {% if products_array.size == 0 %}
                      <div style="text-align: center; padding: 20px; color: #999; font-style: italic;">
                        Add products to this bundle
                      </div>
                    {% endif %}
                  </div>

                  {% if products_array.size > 0 %}
                    <div class="ai-bundle-card-footer-{{ ai_gen_id }}">
                      <div class="ai-bundle-total-{{ ai_gen_id }}">
                        <span class="ai-bundle-total-label-{{ ai_gen_id }}">{{ block.settings.total_label }}</span>
                        <span class="ai-bundle-total-price-{{ ai_gen_id }}">{{ total_price | money }}</span>
                      </div>
                      {% if button_link != blank %}
                        <a href="{{ button_link }}" class="ai-bundle-button-{{ ai_gen_id }}">
                          {{ button_text }}
                        </a>
                      {% else %}
                        <button class="ai-bundle-button-{{ ai_gen_id }}" disabled style="opacity: 0.5; cursor: not-allowed;">
                          {{ button_text }}
                        </button>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <button class="ai-bundle-carousel-nav-{{ ai_gen_id }} prev" data-prev aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>

        <button class="ai-bundle-carousel-nav-{{ ai_gen_id }} next" data-next aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </button>
      </div>

      {% if block.settings.show_dots %}
        <div class="ai-bundle-carousel-dots-{{ ai_gen_id }}" data-dots></div>
      {% endif %}
    {% else %}
      <div class="ai-bundle-empty-state-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
        <p>Enable and configure your first bundle to get started</p>
      </div>
    {% endif %}
  </div>
</product-bundle-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductBundleCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cardsPerView = {{ block.settings.cards_per_view }};
        this.cardsPerViewTablet = {{ block.settings.cards_per_view_tablet }};
        this.autoplay = {{ block.settings.autoplay }};
        this.autoplaySpeed = {{ block.settings.autoplay_speed }};
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        
        if (!this.track) return;

        this.slides = Array.from(this.track.children);
        this.totalSlides = this.slides.length;

        this.updateCardsPerView();
        this.createDots();
        this.updateNavigation();
        this.setupEventListeners();

        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', this.handleResize);
      }

      updateCardsPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.currentCardsPerView = 1;
        } else if (width <= 989) {
          this.currentCardsPerView = this.cardsPerViewTablet;
        } else {
          this.currentCardsPerView = this.cardsPerView;
        }
        this.maxIndex = Math.max(0, this.totalSlides - this.currentCardsPerView);
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        this.handleResize = () => {
          this.updateCardsPerView();
          this.goToSlide(Math.min(this.currentIndex, this.maxIndex));
        };
        window.addEventListener('resize', this.handleResize);

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) this.startAutoplay();
        });
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.dotsContainer.innerHTML = '';
        const dotsCount = this.maxIndex + 1;
        
        for (let i = 0; i <= this.maxIndex; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-bundle-carousel-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          if (i === 0) dot.classList.add('active');
          
          dot.addEventListener('click', () => {
            this.goToSlide(i);
            this.stopAutoplay();
          });
          
          this.dotsContainer.appendChild(dot);
        }
      }

      updateDots() {
        if (!this.dotsContainer) return;
        
        const dots = this.dotsContainer.querySelectorAll('.ai-bundle-carousel-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      updateNavigation() {
        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= this.maxIndex;
        }
        this.updateDots();
      }

      goToSlide(index) {
        this.currentIndex = Math.max(0, Math.min(index, this.maxIndex));
        const slideWidth = this.slides[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const offset = -(this.currentIndex * (slideWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;
        this.updateNavigation();
      }

      next() {
        if (this.currentIndex < this.maxIndex) {
          this.goToSlide(this.currentIndex + 1);
        } else if ({{ block.settings.loop }}) {
          this.goToSlide(0);
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.goToSlide(this.currentIndex - 1);
        } else if ({{ block.settings.loop }}) {
          this.goToSlide(this.maxIndex);
        }
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayTimer = setInterval(() => {
          if (this.currentIndex >= this.maxIndex) {
            if ({{ block.settings.loop }}) {
              this.goToSlide(0);
            }
          } else {
            this.next();
          }
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }
    }

    customElements.define('product-bundle-carousel-{{ ai_gen_id }}', ProductBundleCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product bundle carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop our bundles"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Save more when you bundle"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading bottom spacing",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Subheading bottom spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2e2a39"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#2e2a39"
