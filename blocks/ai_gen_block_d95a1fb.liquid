{% doc %}
  @prompt
    generate me a collection block where i can show categories. make the block highly customizable, same as you did with the previous one
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-categories-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    /* padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px {{ block.settings.section_padding_horizontal }}px; */
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-categories-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 20px 0;
  }

    @media screen and (max-width: 425px) {
    .ai-collection-categories-container-{{ ai_gen_id }} {
      padding: 20px 0 10px 0;
    }
  }

  .ai-collection-categories-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 30px;
  }

  .ai-collection-categories-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 200;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  .ai-collection-categories-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    color: {{ block.settings.subheading_color }};
    margin: {{ block.settings.subheading_spacing }}px 0 0;
    line-height: 1.5;
  }

  .ai-collection-categories-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-categories-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .ai-collection-categories-card-{{ ai_gen_id }}:hover {
    transform: translateY({{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }

  .ai-collection-categories-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    left: 20%;
    width: 60%;
    padding-top: 60%;
    overflow: hidden;
  }

  .ai-collection-categories-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-categories-card-{{ ai_gen_id }}:hover .ai-collection-categories-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_hover_scale }});
  }

  .ai-collection-categories-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-categories-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-collection-categories-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%);
    pointer-events: none;
  }

  .ai-collection-categories-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.card_text_alignment }};
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.card_content_vertical_alignment }};
  }

  .ai-collection-categories-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.3;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;

    word-break: normal;
    overflow-wrap: normal;
    hyphens: none;
  }

  .ai-collection-categories-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    font-weight: {{ block.settings.description_weight }};
    color: {{ block.settings.description_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px;
    line-height: 1.5;
  }

  .ai-collection-categories-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.count_size }}px;
    font-weight: {{ block.settings.count_weight }};
    color: {{ block.settings.count_color }};
    margin: 0;
  }

  .ai-collection-categories-card-{{ ai_gen_id }}{
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: #f6f6f6;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;

    /* add these */
    text-decoration: none;
    color: inherit;
  }


  .ai-collection-categories-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
  }

  .ai-product-carousel-divider-{{ ai_gen_id }} {
    height: 1px;
    background: #d9d9d9;
    width: 100%;
    margin-top: 16px;
  }

  .ai-product-carousel-divider-{{ ai_gen_id }}:empty {
    display: block !important;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-categories-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-categories-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-collection-categories-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-collection-categories-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-collection-categories-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.9);
      line-height: 1.25;
      word-break: keep-all;
      overflow-wrap: normal;
    }
  }

  @media screen and (max-width: 425px) {
  .ai-collection-categories-content-{{ ai_gen_id }} {
      padding: 10px;
    }
  }
{% endstyle %}

<collection-categories-{{ ai_gen_id }} class="ai-collection-categories-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-categories-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-collection-categories-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-collection-categories-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-collection-categories-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}

        <div class="ai-product-carousel-divider-{{ ai_gen_id }}"></div>
      </div>
    {% endif %}

    {% if block.settings.collections != blank %}
      <div class="ai-collection-categories-grid-{{ ai_gen_id }}">
        {% for collection in block.settings.collections %}
          <a href="{{ collection.url }}" class="ai-collection-categories-card-{{ ai_gen_id }}" aria-label="{{ collection.title }}">
            
            <div class="ai-collection-categories-image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-collection-categories-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
              {% else %}
                <div class="ai-collection-categories-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              {% if block.settings.show_overlay %}
                <div class="ai-collection-categories-overlay-{{ ai_gen_id }}"></div>
              {% endif %}
            </div>

            <div class="ai-collection-categories-content-{{ ai_gen_id }}">
              <h3 class="ai-collection-categories-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              
              {% if block.settings.show_description and collection.description != blank %}
                <div class="ai-collection-categories-description-{{ ai_gen_id }}">
                  {{ collection.description | strip_html | truncate: block.settings.description_length }}
                </div>
              {% endif %}

              {% if block.settings.show_product_count %}
                <div class="ai-collection-categories-count-{{ ai_gen_id }}">
                  {{ collection.products_count }}
                  {% if collection.products_count == 1 %}
                    {{ block.settings.product_count_singular }}
                  {% else %}
                    {{ block.settings.product_count_plural }}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-collection-categories-empty-{{ ai_gen_id }}">
        Next, select collections to display
      </div>
    {% endif %}
  </div>
</collection-categories-{{ ai_gen_id }}>

