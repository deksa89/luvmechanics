{% doc %}
  @prompt
    generate me a block where i can write about my shop in two columns. add the "Read more" button if the text is too long
    Make is highly customizable
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-about-shop-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  /* ONE collapsible wrapper for both columns */
  .ai-about-shop-content-{{ ai_gen_id }} {
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  .ai-about-shop-content-{{ ai_gen_id }}.collapsed {
    max-height: {{ block.settings.collapsed_height }}px;
    position: relative;
  }

  .ai-about-shop-content-{{ ai_gen_id }}.collapsed::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: {{ block.settings.fade_height }}px;
    background: linear-gradient(to bottom, transparent, {{ block.settings.background_color }});
    pointer-events: none;
  }

  /* The grid is INSIDE the single collapsible wrapper */
  .ai-about-shop-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.column_gap }}px;
    max-width: {{ block.settings.max_content_width }}px;
    margin: 0 auto;
  }

  .ai-about-shop-column-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-about-shop-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 200;
    color: {{ block.settings.heading_color }};
    margin: 0 0 30px;
    text-align: {{ block.settings.text_alignment }};
    line-height: {{ block.settings.heading_line_height }};
  }

  .ai-about-shop-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.text_line_height }};
    text-align: {{ block.settings.text_alignment }};
    margin: 0;
  }

  .ai-about-shop-text-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-about-shop-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-about-shop-button-wrapper-{{ ai_gen_id }} {
    margin-top: {{ block.settings.button_margin_top }}px;
    text-align: {{ block.settings.text_alignment }};
    min-width: calc(12rem + var(--buttons-border-width) * 2);
    min-height: calc(4.5rem + var(--buttons-border-width) * 2);
  }

  .ai-about-shop-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-about-shop-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_hover_color }};
    color: {{ block.settings.button_text_hover_color }};
    border-color: {{ block.settings.button_border_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-about-shop-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 0px;
    }

    .ai-about-shop-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-about-shop-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-about-shop-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<about-shop-{{ ai_gen_id }} class="ai-about-shop-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div
    class="ai-about-shop-content-{{ ai_gen_id }} {% if block.settings.enable_read_more %}collapsed{% endif %}"
    data-collapsed-height="{{ block.settings.collapsed_height }}"
  >
    <div class="ai-about-shop-container-{{ ai_gen_id }}">
      <div class="ai-about-shop-column-{{ ai_gen_id }}">
        {% if block.settings.heading_column_1 != blank %}
          <h2 class="ai-about-shop-heading-{{ ai_gen_id }}">{{ block.settings.heading_column_1 }}</h2>
        {% endif %}

        {% if block.settings.text_column_1 != blank %}
          <div class="ai-about-shop-text-{{ ai_gen_id }}">{{ block.settings.text_column_1 }}</div>
        {% else %}
          <div class="ai-about-shop-text-{{ ai_gen_id }}">
            <p>Add your shop story here. Tell customers about your brand, values, and what makes your products special.</p>
          </div>
        {% endif %}
      </div>

      <div class="ai-about-shop-column-{{ ai_gen_id }}">
        {% if block.settings.heading_column_2 != blank %}
          <h2 class="ai-about-shop-heading-{{ ai_gen_id }}">{{ block.settings.heading_column_2 }}</h2>
        {% endif %}

        {% if block.settings.text_column_2 != blank %}
          <div class="ai-about-shop-text-{{ ai_gen_id }}">{{ block.settings.text_column_2 }}</div>
        {% else %}
          <div class="ai-about-shop-text-{{ ai_gen_id }}">
            <p>Share more details about your mission, craftsmanship, or the inspiration behind your products.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% if block.settings.enable_read_more %}
    <div class="ai-about-shop-button-wrapper-{{ ai_gen_id }}">
      <button class="ai-about-shop-button-{{ ai_gen_id }}" type="button" aria-expanded="false">
        <span class="ai-about-shop-button-text-more-{{ ai_gen_id }}">{{ block.settings.read_more_text }}</span>
        <span class="ai-about-shop-button-text-less-{{ ai_gen_id }}" style="display: none;">{{ block.settings.read_less_text }}</span>
      </button>
    </div>
  {% endif %}
</about-shop-{{ ai_gen_id }}>

<script>
  (function() {
    class AboutShop{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.content = this.querySelector('.ai-about-shop-content-{{ ai_gen_id }}');
        this.button = this.querySelector('.ai-about-shop-button-{{ ai_gen_id }}');

        if (!this.content || !this.button) return;

        this.moreText = this.button.querySelector('.ai-about-shop-button-text-more-{{ ai_gen_id }}');
        this.lessText = this.button.querySelector('.ai-about-shop-button-text-less-{{ ai_gen_id }}');

        // Initial check + set correct maxHeight when collapsed
        this.updateButtonVisibility();
        this.setCollapsedMaxHeight();

        this.button.addEventListener('click', () => this.toggle());

        // Recalculate on resize (responsive grid changes height)
        window.addEventListener('resize', () => {
          this.updateButtonVisibility();
          if (this.content.classList.contains('collapsed')) {
            this.setCollapsedMaxHeight();
          } else {
            this.setExpandedMaxHeight();
          }
        });
      }

      setCollapsedMaxHeight() {
        const collapsedHeight = parseInt(this.content.dataset.collapsedHeight, 10);
        this.content.style.maxHeight = collapsedHeight + 'px';
      }

      setExpandedMaxHeight() {
        this.content.style.maxHeight = this.content.scrollHeight + 'px';
      }

      toggle() {
        const isCollapsed = this.content.classList.contains('collapsed');

        if (isCollapsed) {
          this.content.classList.remove('collapsed');
          this.setExpandedMaxHeight();
          this.moreText.style.display = 'none';
          this.lessText.style.display = 'inline';
          this.button.setAttribute('aria-expanded', 'true');
        } else {
          this.content.classList.add('collapsed');
          this.setCollapsedMaxHeight();
          this.moreText.style.display = 'inline';
          this.lessText.style.display = 'none';
          this.button.setAttribute('aria-expanded', 'false');
        }
      }

      updateButtonVisibility() {
        const collapsedHeight = parseInt(this.content.dataset.collapsedHeight, 10);

        // Temporarily remove maxHeight so we can measure full scrollHeight accurately
        const prevMaxHeight = this.content.style.maxHeight;
        this.content.style.maxHeight = 'none';

        const needsToggle = this.content.scrollHeight > collapsedHeight;

        this.content.style.maxHeight = prevMaxHeight;

        if (!needsToggle) {
          this.button.parentElement.style.display = 'none';
          this.content.classList.remove('collapsed');
          this.content.style.maxHeight = 'none';
        } else {
          this.button.parentElement.style.display = '';
          // Keep collapsed if setting says so
          if (this.content.classList.contains('collapsed')) {
            this.setCollapsedMaxHeight();
          }
        }
      }
    }

    customElements.define('about-shop-{{ ai_gen_id }}', AboutShop{{ ai_gen_id }});
  })();
</script>

{% schema %}
