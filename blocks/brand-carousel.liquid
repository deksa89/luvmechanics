{% assign carousel_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .brand-carousel-{{ carousel_id }} {
    display: flex;
    flex-direction: column;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: var(--page-width);
    position: relative;
    padding-top: {{ block.settings.padding_top_desktop }}px;
    padding-right: 0;
    padding-bottom: {{ block.settings.padding_bottom_desktop }}px;
    padding-left: 0;
    background-color: {{ block.settings.background_color }};
    margin: 0 auto;
  }

  @media screen and (min-width: 768px) {
    .brand-carousel-{{ carousel_id }} {
      padding-right: 2rem;
      padding-left: 2rem;
    }
  }

  .brand-carousel-heading-wrapper-{{ carousel_id }} {
    margin-bottom: 30px;
  }

  .brand-carousel-heading-{{ carousel_id }} {
    margin: 0 0 16px;
    text-align: center;
    font-size: 34px;
    color: #2e2a39;
    font-weight: 200 !important;
  }

  .brand-carousel-divider-{{ carousel_id }} {
    height: 1px;
    background-color: #d9d9d9;
    width: 100%;
  }

  .brand-carousel-divider-{{ carousel_id }}:empty {
    display: block !important;
  }

  .brand-carousel-container-{{ carousel_id }} {
    position: relative;
    padding: 0;
    box-sizing: border-box;
  }

  .brand-carousel-viewport-{{ carousel_id }} {
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .brand-carousel-track-{{ carousel_id }} * {
    user-select: none;
  }

  .brand-carousel-viewport-{{ carousel_id }}.is-dragging {
    cursor: grabbing;
  }

  .brand-carousel-track-{{ carousel_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    will-change: transform;
    transition: transform 0.45s ease;
  }

  .brand-carousel-track-{{ carousel_id }}.no-transition {
    transition: none;
  }

  .brand-carousel-{{ carousel_id }} .brand-carousel__item {
    flex: 0 0 calc((100% - ({{ block.settings.items_per_view | minus: 1 }} * {{ block.settings.item_spacing }}px)) / {{ block.settings.items_per_view }});
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
    min-height: {{ block.settings.item_height }}px;
    box-sizing: border-box;
  }

  .brand-carousel-{{ carousel_id }} .brand-carousel__item a,
  .brand-carousel-{{ carousel_id }} .brand-carousel__item img {
    user-select: none;
    -webkit-user-drag: none;
  }

  .brand-carousel-{{ carousel_id }} .brand-carousel__item img {
    max-width: 100%;
    max-height: {{ block.settings.logo_max_height }}px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale({{ block.settings.logo_grayscale }}%);
    opacity: {{ block.settings.logo_opacity }};
    transition: all 0.3s ease;
  }

  .brand-carousel-{{ carousel_id }} .brand-carousel__item:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  .brand-carousel-arrow-{{ carousel_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    background-color: {{ block.settings.arrow_background_color }};
    border: none;
    border-radius: {{ block.settings.arrow_border_radius }}px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background-color 0.3s ease, opacity 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);

    display: none;
  }

  .brand-carousel-arrow-{{ carousel_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background_color }};
  }

  .brand-carousel-arrow-{{ carousel_id }} svg {
    width: 50%;
    height: 50%;
    stroke: {{ block.settings.arrow_color }};
  }

  .brand-carousel-arrow-{{ carousel_id }}:hover svg {
    stroke: {{ block.settings.arrow_hover_color }};
  }

  .brand-carousel-arrow-prev-{{ carousel_id }} {
    left: 0;
  }

  .brand-carousel-arrow-next-{{ carousel_id }} {
    right: 0;
  }

  .brand-carousel-dots-{{ carousel_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: {{ block.settings.dots_margin_top_desktop }}px;
    margin-bottom: {{ block.settings.dots_margin_bottom_desktop }}px;
  }

  .brand-carousel-dot-{{ carousel_id }} {
    width: 6px;
    height: 6px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .brand-carousel-dot-{{ carousel_id }}:hover {
    background-color: rgba(0, 0, 0, 0.4);
  }

  .brand-carousel-dot-{{ carousel_id }}.is-active {
    background-color: #f98585;
    transform: scale(1.15);
  }

  .brand-carousel-empty-state-{{ carousel_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .brand-carousel-{{ carousel_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }

    .brand-carousel-container-{{ carousel_id }} {
      padding: 0;
    }

    .brand-carousel-dots-{{ carousel_id }} {
      gap: 8px;
      margin-top: {{ block.settings.dots_margin_top_mobile }}px;
      margin-bottom: {{ block.settings.dots_margin_bottom_mobile }}px;
      z-index: 111;
    }

    .brand-carousel-dot-{{ carousel_id }} {
      width: 5px;
      height: 5px;
    }

    .brand-carousel-heading-{{ carousel_id }} {
      font-size: calc(34px * 0.8);
    }

    .brand-carousel-{{ carousel_id }} .brand-carousel__item {
      flex: 0 0 calc((100% - ({{ block.settings.items_per_view_mobile | minus: 1 }} * {{ block.settings.item_spacing }}px)) / {{ block.settings.items_per_view_mobile }});
    }

    .brand-carousel-arrow-{{ carousel_id }} {
      width: {{ block.settings.arrow_size | times: 0.8 }}px;
      height: {{ block.settings.arrow_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<brand-carousel-{{ carousel_id }} class="brand-carousel-{{ carousel_id }}" {{ block.shopify_attributes }}>
  {% capture brand_items %}{% content_for 'blocks' %}{% endcapture %}
  {% assign brand_items = brand_items | strip %}

  {% if block.settings.heading != blank %}
    <div class="brand-carousel-heading-wrapper-{{ carousel_id }}">
      <h2 class="brand-carousel-heading-{{ carousel_id }}">
        {{ block.settings.heading }}
      </h2>
      <div class="brand-carousel-divider-{{ carousel_id }}"></div>
    </div>
  {% endif %}

  {% if brand_items != blank %}
    <div class="brand-carousel-container-{{ carousel_id }}">
      <button
        class="brand-carousel-arrow-{{ carousel_id }} brand-carousel-arrow-prev-{{ carousel_id }}"
        aria-label="Previous brands"
        type="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="brand-carousel-viewport-{{ carousel_id }}">
        <div class="brand-carousel-track-{{ carousel_id }}">
          {{ brand_items }}
        </div>
      </div>

      <button
        class="brand-carousel-arrow-{{ carousel_id }} brand-carousel-arrow-next-{{ carousel_id }}"
        aria-label="Next brands"
        type="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="brand-carousel-dots-{{ carousel_id }}" aria-label="Carousel pagination"></div>
  {% else %}
    <div class="brand-carousel-empty-state-{{ carousel_id }}">
      Next, add brand logos to display in the carousel
    </div>
  {% endif %}
</brand-carousel-{{ carousel_id }}>

<script>
  (function() {
    class BrandCarousel{{ carousel_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.startX = 0;
        this.currentX = 0;
        this.isDragging = false;
        this.isHovering = false;
        this.swipeThreshold = 50;
        this.autoPlayTimer = null;
        this.resumeTimer = null;
        this.realSlidesCount = 0;
        this.cloneCount = 0;
        this.baseTranslate = 0;
        this.currentDragOffset = 0;
      }

      connectedCallback() {
        this.viewport = this.querySelector('.brand-carousel-viewport-{{ carousel_id }}');
        this.track = this.querySelector('.brand-carousel-track-{{ carousel_id }}');
        this.prevButton = this.querySelector('.brand-carousel-arrow-prev-{{ carousel_id }}');
        this.nextButton = this.querySelector('.brand-carousel-arrow-next-{{ carousel_id }}');
        this.dotsContainer = this.querySelector('.brand-carousel-dots-{{ carousel_id }}');

        if (!this.viewport || !this.track) return;

        this.realSlides = Array.from(this.track.querySelectorAll('[data-real-slide="true"]'));
        this.realSlidesCount = this.realSlides.length;

        if (!this.realSlidesCount) return;

        this.handleResize = this.handleResize.bind(this);
        this.handleTransitionEnd = this.handleTransitionEnd.bind(this);
        this.handleMouseMove = this.handleMouseMove.bind(this);
        this.handleMouseUp = this.handleMouseUp.bind(this);

        this.setupInfiniteLoop();
        this.setupEventListeners();
        this.buildDots();
        this.jumpToInitialPosition();
        this.updateCarousel(false);
        this.startAutoPlay();

        window.addEventListener('resize', this.handleResize);
        this.track.addEventListener('transitionend', this.handleTransitionEnd);
        document.addEventListener('mousemove', this.handleMouseMove);
        document.addEventListener('mouseup', this.handleMouseUp);
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.handleResize);
        document.removeEventListener('mousemove', this.handleMouseMove);
        document.removeEventListener('mouseup', this.handleMouseUp);

        if (this.track) {
          this.track.removeEventListener('transitionend', this.handleTransitionEnd);
        }

        this.stopAutoPlay();
        clearTimeout(this.resumeTimer);
      }

      getItemsPerView() {
        return window.innerWidth <= 749
          ? {{ block.settings.items_per_view_mobile }}
          : {{ block.settings.items_per_view }};
      }

      getGap() {
        return {{ block.settings.item_spacing }};
      }

      getStepSize() {
        const firstVisibleItem = this.track.querySelector('.brand-carousel__item');
        if (!firstVisibleItem) return 0;
        return firstVisibleItem.offsetWidth + this.getGap();
      }

      setupInfiniteLoop() {
        this.cloneCount = this.getItemsPerView();

        this.track.querySelectorAll('[data-clone="true"]').forEach((el) => el.remove());

        const realSlides = Array.from(this.track.querySelectorAll('[data-real-slide="true"]'));
        if (!realSlides.length) return;

        const prependClones = realSlides.slice(-this.cloneCount).map((slide) => {
          const clone = slide.cloneNode(true);
          clone.setAttribute('data-clone', 'true');
          return clone;
        });

        const appendClones = realSlides.slice(0, this.cloneCount).map((slide) => {
          const clone = slide.cloneNode(true);
          clone.setAttribute('data-clone', 'true');
          return clone;
        });

        prependClones.forEach((clone) => {
          this.track.insertBefore(clone, this.track.firstChild);
        });

        appendClones.forEach((clone) => {
          this.track.appendChild(clone);
        });

        this.allSlides = Array.from(this.track.children);
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.pauseAndResumeAutoPlay();
            this.navigate('prev');
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.pauseAndResumeAutoPlay();
            this.navigate('next');
          });
        }

        this.viewport.addEventListener('mouseenter', () => {
          this.isHovering = true;
          this.stopAutoPlay();
        });

        this.viewport.addEventListener('mouseleave', () => {
          this.isHovering = false;
          if (!this.isDragging) {
            this.startAutoPlay();
          }
        });

        this.viewport.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
        this.viewport.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: false });
        this.viewport.addEventListener('touchend', this.handleTouchEnd.bind(this));

        this.viewport.addEventListener('mousedown', this.handleMouseDown.bind(this));
      }

      handleResize() {
        const oldRealIndex = this.getNormalizedIndex();
        this.stopAutoPlay();
        this.setupInfiniteLoop();
        this.buildDots();
        this.currentIndex = oldRealIndex + this.cloneCount;
        this.updateCarousel(false);
        if (!this.isHovering) {
          this.startAutoPlay();
        }
      }

      buildDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';

        for (let i = 0; i < this.realSlidesCount; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'brand-carousel-dot-{{ carousel_id }}';
          dot.setAttribute('aria-label', `Go to brand page ${i + 1}`);
          dot.addEventListener('click', () => {
            this.pauseAndResumeAutoPlay();
            this.goToRealIndex(i);
          });
          this.dotsContainer.appendChild(dot);
        }

        this.updateDots();
      }

      jumpToInitialPosition() {
        this.currentIndex = this.cloneCount;
      }

      getNormalizedIndex() {
        let normalized = (this.currentIndex - this.cloneCount) % this.realSlidesCount;
        if (normalized < 0) normalized += this.realSlidesCount;
        return normalized;
      }

      updateCarousel(animate = true) {
        const step = this.getStepSize();
        if (!step) return;

        this.baseTranslate = this.currentIndex * step;

        if (animate) {
          this.track.classList.remove('no-transition');
        } else {
          this.track.classList.add('no-transition');
        }

        this.track.style.transform = `translateX(-${this.baseTranslate}px)`;
        this.updateDots();
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const activeIndex = this.getNormalizedIndex();
        const dots = this.dotsContainer.querySelectorAll('.brand-carousel-dot-{{ carousel_id }}');

        dots.forEach((dot, index) => {
          dot.classList.toggle('is-active', index === activeIndex);
          dot.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
        });
      }

      navigate(direction) {
        if (direction === 'next') {
          this.currentIndex += 1;
        } else {
          this.currentIndex -= 1;
        }

        this.updateCarousel(true);
      }

      goToRealIndex(realIndex) {
        this.currentIndex = realIndex + this.cloneCount;
        this.updateCarousel(true);
      }

      handleTransitionEnd() {
        if (this.currentIndex >= this.realSlidesCount + this.cloneCount) {
          this.currentIndex = this.cloneCount;
          this.updateCarousel(false);
        }

        if (this.currentIndex < this.cloneCount) {
          this.currentIndex = this.realSlidesCount + this.cloneCount - 1;
          this.updateCarousel(false);
        }
      }

      startAutoPlay() {
        this.stopAutoPlay();

        if (this.realSlidesCount <= 1 || this.isHovering || this.isDragging) return;

        this.autoPlayTimer = setInterval(() => {
          this.navigate('next');
        }, {{ block.settings.auto_scroll_speed | times: 1000 }});
      }

      stopAutoPlay() {
        if (this.autoPlayTimer) {
          clearInterval(this.autoPlayTimer);
          this.autoPlayTimer = null;
        }
      }

      pauseAndResumeAutoPlay() {
        this.stopAutoPlay();
        clearTimeout(this.resumeTimer);

        this.resumeTimer = setTimeout(() => {
          if (!this.isHovering && !this.isDragging) {
            this.startAutoPlay();
          }
        }, 3500);
      }

      handleTouchStart(event) {
        this.stopAutoPlay();
        this.isDragging = true;
        this.startX = event.touches[0].clientX;
        this.currentX = this.startX;
        this.currentDragOffset = 0;
        this.track.classList.add('no-transition');
      }

      handleTouchMove(event) {
        if (!this.isDragging) return;

        this.currentX = event.touches[0].clientX;
        this.currentDragOffset = this.currentX - this.startX;

        this.track.style.transform = `translateX(${-(this.baseTranslate) + this.currentDragOffset}px)`;

        if (Math.abs(this.currentDragOffset) > 8) {
          event.preventDefault();
        }
      }

      handleTouchEnd() {
        if (!this.isDragging) return;

        const distance = this.currentX - this.startX;
        this.isDragging = false;
        this.track.classList.remove('no-transition');

        if (Math.abs(distance) >= this.swipeThreshold) {
          if (distance < 0) {
            this.currentIndex += 1;
          } else {
            this.currentIndex -= 1;
          }
        }

        this.updateCarousel(true);
        this.currentDragOffset = 0;
        this.pauseAndResumeAutoPlay();
      }

      handleMouseDown(event) {
        event.preventDefault();
        this.isDragging = true;
        this.stopAutoPlay();
        this.startX = event.clientX;
        this.currentX = event.clientX;
        this.currentDragOffset = 0;
        this.viewport.classList.add('is-dragging');
        this.track.classList.add('no-transition');
      }

      handleMouseMove(event) {
        if (!this.isDragging) return;

        this.currentX = event.clientX;
        this.currentDragOffset = this.currentX - this.startX;
        this.track.style.transform = `translateX(${-(this.baseTranslate) + this.currentDragOffset}px)`;
      }

      handleMouseUp() {
        if (!this.isDragging) return;

        const distance = this.currentX - this.startX;

        this.isDragging = false;
        this.viewport.classList.remove('is-dragging');
        this.track.classList.remove('no-transition');

        if (Math.abs(distance) >= this.swipeThreshold) {
          if (distance < 0) {
            this.currentIndex += 1;
          } else {
            this.currentIndex -= 1;
          }
        }

        this.updateCarousel(true);
        this.currentDragOffset = 0;
        this.startX = 0;
        this.currentX = 0;
        this.pauseAndResumeAutoPlay();
      }
    }

    if (!customElements.get('brand-carousel-{{ carousel_id }}')) {
      customElements.define('brand-carousel-{{ carousel_id }}', BrandCarousel{{ carousel_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Brand carousel",
  "tag": null,
  "blocks": [
    { "type": "_brand-carousel-item" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "dots_margin_top_desktop",
      "label": "Dots margin top desktop",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "dots_margin_bottom_desktop",
      "label": "Dots margin bottom desktop",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "dots_margin_top_mobile",
      "label": "Dots margin top mobile",
      "min": -20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "dots_margin_bottom_mobile",
      "label": "Dots margin bottom mobile",
      "min": -20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "items_per_view",
      "label": "Brands per view (desktop)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "items_per_view_mobile",
      "label": "Brands per view (mobile)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Space between brands",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "auto_scroll_speed",
      "label": "Auto scroll interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Brand item style"
    },
    {
      "type": "range",
      "id": "item_height",
      "label": "Item height",
      "min": 60,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Item padding",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "item_background_color",
      "label": "Item background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "item_border_width",
      "label": "Item border width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "item_border_color",
      "label": "Item border color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "item_border_radius",
      "label": "Item border radius",
      "min": 0,
      "max": 40,
      "step": 2,
