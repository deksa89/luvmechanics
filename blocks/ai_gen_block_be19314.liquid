{% doc %}
  @prompt
    generate me a block where i can write about my shop in two columns. add the "Read more" button if the text is too long. Also for the mobile, make it one column instead of two
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-two-column-text__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-two-column-text__column-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.6;
  }

  .ai-two-column-text__content-{{ ai_gen_id }} {
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-two-column-text__content-{{ ai_gen_id }}.collapsed {
    max-height: {{ block.settings.collapsed_height }}px;
    position: relative;
  }

  .ai-two-column-text__content-{{ ai_gen_id }}.collapsed::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(to bottom, transparent, {{ block.settings.background_color }});
    pointer-events: none;
  }

  .ai-two-column-text__button-wrapper-{{ ai_gen_id }} {
    margin-top: 20px;
    text-align: {{ block.settings.button_alignment }};
  }

  .ai-two-column-text__button-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    cursor: pointer;
    font-size: 14px;
    transition: background-color 0.3s ease;
  }

  .ai-two-column-text__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-two-column-text__button-{{ ai_gen_id }}.hidden {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-text__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | divided_by: 2 }}px;
    }
  }
{% endstyle %}

<two-column-text-{{ ai_gen_id }} class="ai-two-column-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-text__container-{{ ai_gen_id }}">
    <div class="ai-two-column-text__column-{{ ai_gen_id }}">
      <div class="ai-two-column-text__content-{{ ai_gen_id }} collapsed" data-column="1">
        {{ block.settings.column_1_text }}
      </div>
    </div>
    <div class="ai-two-column-text__column-{{ ai_gen_id }}">
      <div class="ai-two-column-text__content-{{ ai_gen_id }} collapsed" data-column="2">
        {{ block.settings.column_2_text }}
      </div>
    </div>
  </div>
  <div class="ai-two-column-text__button-wrapper-{{ ai_gen_id }}">
    <button class="ai-two-column-text__button-{{ ai_gen_id }}" data-read-more>
      {{ block.settings.button_text }}
    </button>
  </div>
</two-column-text-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isExpanded = false;
        this.collapsedHeight = {{ block.settings.collapsed_height }};
      }

      connectedCallback() {
        this.button = this.querySelector('[data-read-more]');
        this.contents = this.querySelectorAll('.ai-two-column-text__content-{{ ai_gen_id }}');
        
        this.checkIfNeedsButton();
        
        if (this.button) {
          this.button.addEventListener('click', () => this.toggleContent());
        }
      }

      checkIfNeedsButton() {
        let needsButton = false;
        
        this.contents.forEach((content) => {
          if (content.scrollHeight > this.collapsedHeight) {
            needsButton = true;
          }
        });

        if (!needsButton && this.button) {
          this.button.classList.add('hidden');
        }
      }

      toggleContent() {
        this.isExpanded = !this.isExpanded;
        
        this.contents.forEach((content) => {
          if (this.isExpanded) {
            content.classList.remove('collapsed');
            content.style.maxHeight = content.scrollHeight + 'px';
          } else {
            content.classList.add('collapsed');
            content.style.maxHeight = this.collapsedHeight + 'px';
          }
        });

        this.button.textContent = this.isExpanded 
          ? '{{ block.settings.button_text_expanded }}' 
          : '{{ block.settings.button_text }}';
      }
    }

    customElements.define('two-column-text-{{ ai_gen_id }}', TwoColumnText{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Two column text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "column_1_text",
      "label": "Column 1 text",
      "default": "<p>Write about your shop in the first column. Share your story, values, and what makes your products special. This is a great place to connect with your customers and tell them why they should choose you.</p>"
    },
    {
      "type": "richtext",
      "id": "column_2_text",
      "label": "Column 2 text",
      "default": "<p>Continue your story in the second column. You can talk about your mission, your team, or the quality of your products. Make it personal and engaging to build trust with your audience.</p>"
    },
    {
      "type": "header",
      "content": "Read more button"
    },
    {
      "type": "range",
      "id": "collapsed_height",
      "label": "Collapsed height",
      "min": 100,
      "max": 500,
      "step": 50,
      "unit": "px",
      "default": 200
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "button_text_expanded",
      "label": "Button text when expanded",
      "default": "Read less"
    },
    {
      "type": "select",
      "id": "button_alignment",
      "label": "Button alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#9b046f"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#5e3653"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#fdfbf7"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fdfbf7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2e2a39"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Two column text"
    }
  ]
}
{% endschema %}
