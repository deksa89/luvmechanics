{%- comment -%}
  Renders the country picker for the localization form

  Accepts:
    - localPosition: pass in the position in which the form is coming up to create specific IDs
{%- endcomment -%}

{%- comment -%}
  Simplified country selector — shows only currency code (e.g. AUD)
{%- endcomment -%}

{%- assign current_currency = localization.country.currency.iso_code -%}
{%- assign current_country_code = localization.country.iso_code | downcase -%}
{%- assign current_flag = 'flag-' | append: current_country_code | append: '.svg' -%}

<div class="disclosure">
  <button
    type="button"
    class="disclosure__button localization-form__select localization-selector link link--text caption-large"
    aria-expanded="false"
    aria-controls="{{ localPosition }}List"
    aria-describedby="{{ localPosition }}Label"
  >
    {{ current_currency }}
    {{ 'icon-caret.svg' | inline_asset_content }}
  </button>

  <div class="disclosure__list-wrapper" hidden>
    <ul id="{{ localPosition }}List" role="list" class="disclosure__list list-unstyled">
  {%- assign shown_currencies = '' -%}

  {%- for country in localization.available_countries -%}
    {%- assign currency_code = country.currency.iso_code -%}
    {%- assign currency_token = '|' | append: currency_code | append: '|' -%}

    {%- unless shown_currencies contains currency_token -%}
      {%- assign shown_currencies = shown_currencies | append: currency_token -%}

      <li class="disclosure__item" tabindex="-1">
        <a
          class="link link--text disclosure__link caption-large focus-inset"
          href="#"
          data-value="{{ country.iso_code }}"
          {% if country.currency.iso_code == localization.country.currency.iso_code %}aria-current="true"{% endif %}
        >
          <span {% if country.currency.iso_code != localization.country.currency.iso_code %}class="visibility-hidden"{% endif %}>
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
          </span>

          <span class="lm-country-currency">
            {{ currency_code }}
          </span>

          <span class="lm-country-name">
            {%- if currency_code == 'EUR' -%}
              Eurozone
            {%- else -%}
              {{ country.name }}
            {%- endif -%}
          </span>
        </a>
      </li>
    {%- endunless -%}
  {%- endfor -%}
    </ul>
  </div>
</div>

<input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">

