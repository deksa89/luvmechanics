{% doc %}
  Renders a configured Bathmate product card or comparison row.
  @param {block} block - Product block with a Shopify product picker
  @param {string} mode - card or comparison
  @param {number} position - Product position
{% enddoc %}
{%- liquid
  assign product = block.settings.product
  assign comparison_title = block.settings.short_title | default: product.title
  assign priced_variant = product.variants | sort: 'price' | first
  assign image_alt = product.featured_image.alt | default: product.title
  assign default_cta = 'lm_bathmate.product_cta' | t
  assign cta = block.settings.cta | default: default_cta
  assign badge = block.settings.badge
  if badge == blank and block.settings.default_badge != 'none'
    assign badge_key = 'lm_bathmate.' | append: block.settings.default_badge
    assign badge = badge_key | t
  endif
-%}
{%- capture tracking -%}
data-lm-event="product_click" data-lm-section="{{ mode }}" data-product-id="{{ product.id }}" data-variant-id="{{ priced_variant.id }}" data-product-handle="{{ product.handle | escape }}" data-product-title="{{ product.title | escape }}" data-current-price="{{ product.price | divided_by: 100.0 }}" data-position="{{ position }}"
{%- endcapture -%}
{%- capture price -%}
  <div class="lm-bathmate-price">
    {% if product.price_varies %}
      {% assign formatted_price = product.price | money %}
      <span>{{ 'lm_bathmate.from_price' | t: price: formatted_price }}</span>
    {% else %}
      {% if priced_variant.compare_at_price > product.price %}
        <span class="lm-bathmate-visually-hidden">{{ 'lm_bathmate.regular_price' | t }}</span><s>{{ priced_variant.compare_at_price | money }}</s>
        <span class="lm-bathmate-visually-hidden">{{ 'lm_bathmate.sale_price' | t }}</span>
      {% endif %}
      <span>{{ product.price | money }}</span>
    {% endif %}
  </div>
{%- endcapture -%}
{% if product != blank %}
  {% if mode == 'comparison' %}
    <tr class="lm-bathmate-comparison-row">
      <th scope="row"><a class="lm-bathmate-comparison-title" href="{{ product.url | escape }}" {{ tracking }}>{{ comparison_title | escape }}</a>{% unless product.available %}<span class="lm-bathmate-stock">{{ 'lm_bathmate.sold_out' | t }}</span>{% endunless %}</th>
      <td><span class="lm-bathmate-mobile-label">{{ 'lm_bathmate.series' | t }}</span>{{ block.settings.series | escape }}</td>
      <td><span class="lm-bathmate-mobile-label">{{ 'lm_bathmate.positioning' | t }}</span>{% if block.settings.positioning != blank %}{{ block.settings.positioning | escape }}{% else %}{{ 'lm_bathmate.not_specified' | t }}{% endif %}</td>
      <td><span class="lm-bathmate-mobile-label">{{ 'lm_bathmate.experience' | t }}</span>{% if block.settings.experience != blank %}{{ block.settings.experience | escape }}{% else %}{{ 'lm_bathmate.not_specified' | t }}{% endif %}</td>
      <td><span class="lm-bathmate-mobile-label">{{ 'lm_bathmate.price' | t }}</span>{{ price }}</td>
      <td><a class="lm-bathmate-button lm-bathmate-button--outline" href="{{ product.url | escape }}" {{ tracking }}>{{ cta | escape }}<span class="lm-bathmate-visually-hidden"> — {{ product.title | escape }}</span></a></td>
    </tr>
  {% else %}
    <article class="lm-bathmate-card" {{ block.shopify_attributes }}>
      <div class="lm-bathmate-card-badge-row{% if badge == blank %} lm-bathmate-card-badge-row--empty{% endif %}">{% if badge != blank %}<span class="lm-bathmate-badge">{{ badge | escape }}</span>{% endif %}</div>
      <a class="lm-bathmate-card-media" href="{{ product.url | escape }}" aria-label="{{ product.title | escape }}" {{ tracking }}>
        {% if product.featured_image != blank %}
          {{ product.featured_image | image_url: width: 720 | image_tag: widths: '160, 240, 360, 480, 720', sizes: '(min-width: 1280px) 260px, (min-width: 1000px) 23vw, (min-width: 600px) 42vw, 30vw', loading: 'lazy', alt: image_alt }}
        {% else %}<span class="lm-bathmate-image-empty">{{ 'lm_bathmate.image_unavailable' | t }}</span>{% endif %}
      </a>
      <div class="lm-bathmate-card-copy">
        
        <h3><a href="{{ product.url | escape }}" {{ tracking }}>{{ product.title | escape }}</a></h3>
        {{ price }}
        {% unless product.available %}<span class="lm-bathmate-stock">{{ 'lm_bathmate.sold_out' | t }}</span>{% endunless %}
        {% if block.settings.description != blank %}<p class="lm-bathmate-card-description">{{ block.settings.description | escape }}</p>{% endif %}
      </div>
      <div class="lm-bathmate-card-bottom">
        {% if block.settings.feature_1 != blank or block.settings.feature_2 != blank or block.settings.feature_3 != blank %}
          <ul class="lm-bathmate-chips" role="list">{% for i in (1..3) %}{% assign feature_key = 'feature_' | append: i %}{% if block.settings[feature_key] != blank %}<li>{{ block.settings[feature_key] | escape }}</li>{% endif %}{% endfor %}</ul>
        {% endif %}
        <a class="lm-bathmate-button" href="{{ product.url | escape }}" {{ tracking }}>{{ cta | escape }}<span class="lm-bathmate-visually-hidden"> — {{ product.title | escape }}</span></a>
      </div>
    </article>
  {% endif %}
{% elsif request.design_mode and mode == 'card' %}
  <article class="lm-bathmate-card lm-bathmate-editor-note" {{ block.shopify_attributes }}><h3>Product {{ position }}</h3><p>Select a Bathmate product in this block. Product details appear automatically.</p></article>
{% endif %}
