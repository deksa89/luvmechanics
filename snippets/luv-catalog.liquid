{% doc %}
  Shared collection catalog for every collection template.
  @param {section} section - Hosting section and retained settings
  @param {collection} collection - Current collection
{% enddoc %}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'luv-design-system.css' | asset_url | stylesheet_tag }}
{{ 'luv-catalog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'luv-collection-tracking.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'luv-catalog.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign page_size = section.settings.products_per_page | default: 20
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
-%}
<luv-catalog id="luv-collection-products" class="luv-catalog luv-design-scope" data-section-id="{{ section.id }}" data-remove-label="{{ 'luv_catalog.remove_filter' | t: name: 'FILTER_LABEL' | escape }}" data-price-error="{{ 'luv_catalog.price_error' | t | escape }}" data-luv-collection-context data-collection-id="{{ collection.id }}" data-collection-handle="{{ collection.handle | escape }}" data-collection-title="{{ collection.title | escape }}" data-template-suffix="{{ template.suffix | escape }}" data-locale="{{ request.locale.iso_code }}" data-currency="{{ cart.currency.iso_code }}">
  <div class="luv-container" data-catalog-content>
    <header class="luv-catalog__intro">
      <nav class="luv-catalog__breadcrumb" aria-label="{{ 'luv_catalog.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'luv_catalog.home' | t }}</a><span aria-hidden="true">›</span><a href="{{ routes.collections_url }}">{{ 'luv_catalog.collections' | t }}</a><span aria-hidden="true">›</span><span aria-current="page">{{ collection.title | escape }}</span></nav>
      <div class="luv-catalog__intro-row"><div>
        <h1>{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}
          <div class="luv-catalog__description luv-catalog__intro-description rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>{%- if collection.image -%}{{ collection.image | image_url: width: 200 | image_tag: class: 'luv-catalog__collection-image', width: 100, height: 80, loading: 'eager' }}{%- endif -%}</div>
      <nav class="luv-catalog__shortcuts" aria-label="{{ 'luv_catalog.shortcuts' | t }}">
        {%- for block in section.blocks -%}{%- if block.type == 'collection_link' and block.settings.link != blank -%}<a class="luv-catalog__chip" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{%- endif -%}{%- endfor -%}
        {%- if section.settings.enable_filtering -%}{%- for filter in collection.filters -%}{%- if filter.param_name == 'filter.p.product_type' -%}
          {%- for value in filter.values -%}{%- if value.count > 0 or value.active -%}<a class="luv-catalog__chip{% if value.active %} is-active{% endif %}" data-catalog-link href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"{% if value.active %} aria-current="true"{% endif %}>{{ value.label | escape }} ({{ value.count }})</a>{%- endif -%}{%- endfor -%}
        {%- endif -%}{%- endfor -%}{%- endif -%}
      </nav>
    </header>
    {%- paginate collection.products by page_size -%}
      <div class="luv-catalog__toolbar">
        {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}<button class="luv-catalog__button luv-catalog__button--secondary luv-catalog__filter-toggle" type="button" data-filter-toggle aria-controls="CatalogFilters-{{ section.id }}" aria-expanded="true" data-show="{{ 'luv_catalog.show_filters' | t }}" data-hide="{{ 'luv_catalog.hide_filters' | t }}" data-mobile="{{ 'luv_catalog.filter' | t }}"><span aria-hidden="true">☷</span><span data-filter-toggle-label>{{ 'luv_catalog.filter' | t }}</span><span class="luv-catalog__count" data-active-count>{{ active_count }}</span></button>{%- endif -%}
        <p class="luv-catalog__result-count" role="status" data-result-count>{{ 'products.facets.product_count_simple' | t: count: collection.products_count }}</p>
        {%- if section.settings.enable_sorting -%}<form action="{{ collection.url }}" method="get" data-sort-form>
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">{%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil -%}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100.0 }}">{%- endif -%}
              {%- if filter.max_value.value != nil -%}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100.0 }}">{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <label for="CatalogSort-{{ section.id }}">{{ 'luv_catalog.sort' | t }}</label><select id="CatalogSort-{{ section.id }}" name="sort_by">{%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}</select><noscript><button type="submit">{{ 'luv_catalog.apply' | t }}</button></noscript></form>{%- endif -%}
        {%- if active_count > 0 -%}<div class="luv-catalog__active" aria-label="{{ 'luv_catalog.active_filters' | t }}">{% render 'luv-catalog-chips', collection: collection, clear_url: clear_url %}</div>{%- endif -%}
      </div>
      <div class="luv-catalog__feedback" role="status" tabindex="-1" hidden><span data-loading>{{ 'accessibility.loading' | t }}</span><span data-error hidden>{{ 'luv_catalog.load_error' | t }} <a data-retry href="{{ collection.url }}">{{ 'luv_catalog.retry' | t }}</a></span></div>
      <div class="luv-catalog__layout{% unless section.settings.enable_filtering and collection.filters.size > 0 %} luv-catalog__layout--full{% endunless %}">
        {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
          <aside class="luv-catalog__sidebar" id="CatalogFilters-{{ section.id }}" aria-label="{{ 'luv_catalog.filter' | t }}">
            <form action="{{ collection.url }}" method="get" data-filter-form>
              <input type="hidden" name="sort_by" value="{{ sort_by }}">
              <div class="luv-catalog__drawer-head"><h2 id="CatalogDrawerTitle-{{ section.id }}">{{ 'luv_catalog.filter' | t }} <span data-draft-count>{{ active_count }}</span></h2><button type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">×</button></div>
              <div class="luv-catalog__draft-chips" data-draft-chips></div>
              <div class="luv-catalog__filter-scroll">{% render 'luv-catalog-filters', collection: collection, section_id: section.id %}</div>
              <div class="luv-catalog__filter-footer"><a class="luv-catalog__button luv-catalog__button--secondary" data-reset-all href="{{ clear_url }}">{{ 'products.facets.reset' | t }}</a><button type="submit" class="luv-catalog__button">{{ 'luv_catalog.apply' | t }}</button></div>
            </form>
          </aside>
        {%- endif -%}
        <div id="ProductGridContainer" class="luv-catalog__results" tabindex="-1">
          {%- if collection.products_count == 0 -%}
            <div class="luv-catalog__empty"><h2>{{ 'sections.collection_template.empty' | t }}</h2>{%- if active_count > 0 -%}<a class="luv-catalog__button" data-catalog-link href="{{ clear_url }}">{{ 'products.facets.clear_all' | t }}</a>{%- endif -%}</div>
          {%- else -%}
            <ul id="product-grid" class="luv-catalog__grid" data-id="{{ section.id }}" role="list">{%- for product in collection.products -%}{%- assign position = paginate.current_offset | plus: forloop.index -%}<li>{% render 'luv-catalog-card', product: product, section_id: section.id, position: position %}</li>{%- endfor -%}</ul>
          {%- endif -%}
          {%- liquid
            assign first_result = paginate.current_offset | plus: 1
            assign last_result = paginate.current_offset | plus: collection.products.size
            if collection.products_count == 0
              assign first_result = 0
            endif
          -%}
          <p class="luv-catalog__range">{{ 'luv_catalog.range' | t: first: first_result, last: last_result, count: collection.products_count }}</p>
          {%- if paginate.pages > 1 -%}<nav class="luv-catalog__pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}<a data-page-link href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">‹</a>{%- endif -%}
            {%- for part in paginate.parts -%}{%- if part.is_link -%}<a data-page-link href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}{%- endfor -%}
            {%- if paginate.next -%}<a data-page-link href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">›</a>{%- endif -%}
          </nav>{%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
    {%- if section.settings.catalog_details != blank -%}<details class="luv-catalog__description"><summary>{{ 'luv_catalog.read_more' | t }}</summary><div class="rte">{{ section.settings.catalog_details }}</div></details>{%- endif -%}

  </div>
  <dialog id="CatalogDrawer-{{ section.id }}" class="luv-catalog__dialog" aria-labelledby="CatalogDrawerTitle-{{ section.id }}"></dialog>
</luv-catalog>
