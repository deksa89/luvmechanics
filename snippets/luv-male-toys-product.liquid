{% doc %}
  Renders a selected product as a featured card or comparison row.
  @param {block} block - Product picker and verified editorial copy
  @param {string} mode - card or comparison
  @param {number} position - Position in the selected product blocks
{% enddoc %}
{%- liquid
  assign product = block.settings.product
  assign display_title = block.settings.short_title | default: product.title
  assign priced_variant = product.variants | sort: 'price' | first
  assign image_alt = product.featured_image.alt | default: product.title
  assign default_cta = 'lm_male_toys.product_cta' | t
  assign cta = block.settings.cta | default: default_cta
  assign details_fallback = 'lm_male_toys.not_specified' | t
-%}
{%- capture tracking -%}
data-lm-event="product_click" data-lm-section="{{ mode }}" data-product-id="{{ product.id }}" data-variant-id="{{ priced_variant.id }}" data-product-handle="{{ product.handle | escape }}" data-product-title="{{ product.title | escape }}" data-current-price="{{ product.price | divided_by: 100.0 }}" data-position="{{ position }}"
{%- endcapture -%}
{%- capture price -%}
<div class="lm-male-toys-price">
  {% if product.price_varies %}
    {% assign formatted_price = product.price | money %}
    <span>{{ 'lm_male_toys.from_price' | t: price: formatted_price }}</span>
  {% else %}
    {% if priced_variant.compare_at_price > product.price %}<span class="lm-male-toys-visually-hidden">{{ 'lm_male_toys.regular_price' | t }}</span><s>{{ priced_variant.compare_at_price | money }}</s><span class="lm-male-toys-visually-hidden">{{ 'lm_male_toys.sale_price' | t }}</span>{% endif %}
    <span>{{ product.price | money }}</span>
  {% endif %}
</div>
{%- endcapture -%}
{% if product != blank %}
  {% if mode == 'comparison' %}
    <tr class="lm-male-toys-comparison-row">
      <th scope="row"><a href="{{ product.url | escape }}" {{ tracking }}>{{ display_title | escape }}</a>{% unless product.available %}<span class="lm-male-toys-stock">{{ 'lm_male_toys.sold_out' | t }}</span>{% endunless %}</th>
      {% assign fields = 'movement,heating,interactive,experience' | split: ',' %}
      {% for field in fields %}{% assign label_key = 'lm_male_toys.' | append: field %}<td><span class="lm-male-toys-mobile-label">{{ label_key | t | escape }}</span><span>{{ block.settings[field] | default: details_fallback | escape }}</span></td>{% endfor %}
      <td class="lm-male-toys-comparison-price"><span class="lm-male-toys-mobile-label">{{ 'lm_male_toys.price' | t }}</span>{{ price }}</td>
      <td class="lm-male-toys-comparison-action"><a class="lm-male-toys-button lm-male-toys-button--outline" href="{{ product.url | escape }}" {{ tracking }}>{{ cta | escape }}<span class="lm-male-toys-visually-hidden"> — {{ product.title | escape }}</span></a></td>
    </tr>
  {% else %}
    <article class="lm-male-toys-card" {{ block.shopify_attributes }}>
      <a class="lm-male-toys-card-media" href="{{ product.url | escape }}" aria-label="{{ product.title | escape }}" {{ tracking }}>
        {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 800 | image_tag: widths: '240, 360, 480, 640, 800', sizes: '(min-width: 1440px) 410px, (min-width: 750px) 30vw, 82vw', loading: 'lazy', alt: image_alt }}{% else %}<span class="lm-male-toys-image-empty">{% render 'luv-male-toys-icon', icon: 'device' %}{{ 'lm_male_toys.image_unavailable' | t }}</span>{% endif %}
        {% if block.settings.badge != blank %}<span class="lm-male-toys-badge">{{ block.settings.badge | escape }}</span>{% endif %}
      </a>
      <div class="lm-male-toys-card-copy">
        <div class="lm-male-toys-card-title-price"><h3><a href="{{ product.url | escape }}" {{ tracking }}>{{ display_title | escape }}</a></h3>{{ price }}</div>
        {% unless product.available %}<span class="lm-male-toys-stock">{{ 'lm_male_toys.sold_out' | t }}</span>{% endunless %}
        {% if block.settings.description != blank %}<p>{{ block.settings.description | escape }}</p>{% endif %}
        {% if block.settings.feature_1 != blank or block.settings.feature_2 != blank or block.settings.feature_3 != blank %}<ul class="lm-male-toys-chips" role="list">{% for i in (1..3) %}{% assign feature_key = 'feature_' | append: i %}{% if block.settings[feature_key] != blank %}<li>{{ block.settings[feature_key] | escape }}</li>{% endif %}{% endfor %}</ul>{% endif %}
        <a class="lm-male-toys-button lm-male-toys-button--outline" href="{{ product.url | escape }}" {{ tracking }}>{{ cta | escape }}<span aria-hidden="true"> →</span><span class="lm-male-toys-visually-hidden"> — {{ product.title | escape }}</span></a>
      </div>
    </article>
  {% endif %}
{% elsif request.design_mode and mode == 'card' %}
  <article class="lm-male-toys-card lm-male-toys-editor-note" {{ block.shopify_attributes }}><p>{{ 'lm_male_toys.editor_product' | t }}</p></article>
{% endif %}
